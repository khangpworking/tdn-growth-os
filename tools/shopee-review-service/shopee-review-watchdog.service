# Install: copy this file and shopee-review-watchdog.timer to ~/.config/systemd/user/,
# put SHOPEE_API_TOKEN=... in ~/.config/tdn-shopee-review-watchdog.env (mode 600), then
# systemctl --user daemon-reload && systemctl --user enable --now shopee-review-watchdog.timer
[Unit]
Description=Shopee review service watchdog (restart after 3 deep health checks with no answer)

[Service]
Type=oneshot
EnvironmentFile=%h/.config/tdn-shopee-review-watchdog.env
ExecStart=/usr/bin/python3 %h/apps/shopee-private-api/watchdog.py
