{
  "mcpServers": {
    "tdn-insight": {
      "command": "python3",
      "args": ["tools/mcp-insight/insight_tools.py"],
      "env": {
        "INSIGHT_MCP_APP_DB": "<path to the app SQLite file>",
        "INSIGHT_MCP_APP_DB_SNAPSHOT": "<path to the app's app-db.snapshot.sqlite>"
      }
    }
  }
}
