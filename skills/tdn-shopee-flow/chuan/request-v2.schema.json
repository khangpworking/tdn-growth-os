{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdn.local/shopee-flow/request-v2.schema.json",
  "title": "ConfiguredShopeeModuleRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "preset",
    "windows",
    "collectionPolicy"
  ],
  "properties": {
    "format": {
      "const": "request-v2"
    },
    "preset": {
      "$ref": "https://tdn.local/shopee-flow/request-v1.schema.json#/properties/preset"
    },
    "windows": {
      "anyOf": [
        {
          "$ref": "https://tdn.local/shopee-flow/request-v1.schema.json#/properties/windows"
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "https://tdn.local/metric-v3-capture-spec-v3.schema.json#/$defs/window"
          }
        }
      ]
    },
    "collectionPolicy": {
      "$ref": "https://tdn.local/contracts/foundation/shopee-review-sampling.schema.json#/$defs/anyPolicy"
    },
    "captureSpec": {
      "anyOf": [
        {
          "$ref": "https://tdn.local/shopee-flow/request-v1.schema.json#/properties/captureSpec"
        },
        {
          "$ref": "https://tdn.local/metric-v3-capture-spec-v3.schema.json"
        }
      ]
    },
    "principalTitles": {
      "$ref": "https://tdn.local/shopee-flow/request-v1.schema.json#/properties/principalTitles"
    },
    "metricInput": {
      "$ref": "https://tdn.local/metric-v3-capture-spec-v3.schema.json#/$defs/confirmedInput"
    },
    "selectionPolicy": {
      "enum": [
        "metric-products-unique-v1",
        "metric-products-unique-v2"
      ]
    },
    "productSelection": {
      "description": "How many distinct products M2 links. Absent means top 5.",
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "count"
          ],
          "properties": {
            "mode": {
              "const": "top"
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "all"
            }
          }
        }
      ]
    },
    "metricSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "scope",
        "importId"
      ],
      "properties": {
        "format": {
          "const": "user-page-v1"
        },
        "scope": {
          "type": "object",
          "required": [
            "start_date",
            "end_date"
          ],
          "properties": {
            "start_date": {
              "type": "string",
              "pattern": "^[0-9]{8}$"
            },
            "end_date": {
              "type": "string",
              "pattern": "^[0-9]{8}$"
            }
          }
        },
        "importId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "metricInput"
        ],
        "properties": {
          "metricInput": {}
        }
      },
      "then": {
        "required": [
          "captureSpec"
        ],
        "properties": {
          "captureSpec": {
            "$ref": "https://tdn.local/metric-v3-capture-spec-v3.schema.json"
          },
          "windows": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "$ref": "https://tdn.local/metric-v3-capture-spec-v3.schema.json#/$defs/window"
            }
          }
        }
      },
      "else": {
        "if": {
          "required": [
            "metricSource"
          ],
          "properties": {
            "metricSource": {}
          }
        },
        "then": {
          "properties": {
            "windows": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "$ref": "https://tdn.local/metric-v3-capture-spec-v3.schema.json#/$defs/window"
              }
            }
          }
        },
        "else": {
          "properties": {
            "captureSpec": {
              "$ref": "https://tdn.local/shopee-flow/request-v1.schema.json#/properties/captureSpec"
            },
            "windows": {
              "$ref": "https://tdn.local/shopee-flow/request-v1.schema.json#/properties/windows"
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "selectionPolicy"
        ],
        "properties": {
          "selectionPolicy": {}
        }
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "metricInput"
            ]
          },
          {
            "required": [
              "metricSource"
            ]
          }
        ]
      }
    },
    {
      "if": {
        "required": [
          "metricSource"
        ],
        "properties": {
          "metricSource": {}
        }
      },
      "then": {
        "not": {
          "required": [
            "captureSpec"
          ]
        }
      }
    }
  ]
}
