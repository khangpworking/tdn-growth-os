{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdn.local/shopee-flow/request-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "preset",
    "windows",
    "reviewCapPerLink"
  ],
  "properties": {
    "format": {
      "const": "request-v1"
    },
    "preset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keywords"
      ],
      "properties": {
        "keywords": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "windows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "period"
        ],
        "properties": {
          "id": {
            "enum": [
              "30d",
              "12m"
            ]
          },
          "period": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "startDate",
              "endDate"
            ],
            "properties": {
              "startDate": {
                "type": "string",
                "format": "date"
              },
              "endDate": {
                "type": "string",
                "format": "date"
              }
            }
          },
          "intervalDays": {
            "enum": [
              7,
              30
            ]
          }
        }
      }
    },
    "reviewCapPerLink": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    },
    "captureSpec": {
      "anyOf": [
        {
          "$ref": "https://tdn.local/metric-v3-capture-spec.schema.json"
        },
        {
          "$ref": "https://tdn.local/metric-v3-capture-spec-v1.schema.json"
        }
      ]
    },
    "principalTitles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
