{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdn.local/shopee-flow/selection-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "runId",
    "source",
    "pickRuleVersion",
    "metricInputSha256",
    "links",
    "counts"
  ],
  "properties": {
    "format": {
      "const": "selection-v1"
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "source": {
      "enum": [
        "auto",
        "manual"
      ]
    },
    "pickRuleVersion": {
      "type": "string",
      "minLength": 1
    },
    "metricInputSha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "links": {
      "type": "array",
      "minItems": 0,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rank",
          "productBaseId",
          "shopId",
          "itemId",
          "url",
          "brand",
          "revenue",
          "reason"
        ],
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "productBaseId": {
            "type": "string",
            "pattern": "^1__[1-9][0-9]{0,19}__[1-9][0-9]{0,19}$"
          },
          "shopId": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,19}$"
          },
          "itemId": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,19}$"
          },
          "url": {
            "type": "string",
            "pattern": "^https://shopee\\.vn/",
            "maxLength": 2000
          },
          "brand": {
            "type": [
              "string",
              "null"
            ]
          },
          "revenue": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "reason": {
            "type": "string",
            "pattern": "\\S"
          },
          "sourceRank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "productName": {
            "type": "string",
            "minLength": 1
          },
          "shopName": {
            "type": [
              "string",
              "null"
            ]
          },
          "groupKey": {
            "type": "string",
            "minLength": 1
          },
          "groupingBasis": {
            "const": "finite-title-components-v1"
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "walked",
        "deleted",
        "notIncluded",
        "tokenGuardRejected",
        "eligible",
        "picked",
        "maskedRows",
        "maskedAboveLowestPick"
      ],
      "properties": {
        "walked": {
          "type": "integer",
          "minimum": 0
        },
        "deleted": {
          "type": "integer",
          "minimum": 0
        },
        "notIncluded": {
          "type": "integer",
          "minimum": 0
        },
        "tokenGuardRejected": {
          "type": "integer",
          "minimum": 0
        },
        "eligible": {
          "type": "integer",
          "minimum": 0
        },
        "picked": {
          "type": "integer",
          "minimum": 0
        },
        "maskedRows": {
          "type": "integer",
          "minimum": 0
        },
        "maskedAboveLowestPick": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "selectionProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceMap",
        "rawSha256",
        "windowId",
        "sortBy",
        "candidateCount",
        "distinctCount",
        "unresolvedCount",
        "shortageReason",
        "skipped"
      ],
      "properties": {
        "sourceMap": {
          "type": "string",
          "pattern": "^raw-responses\\.json#/\\d+/body/data$"
        },
        "rawSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "windowId": {
          "const": "selected"
        },
        "sortBy": {
          "const": "revenue_custom__desc"
        },
        "candidateCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "distinctCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "unresolvedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "shortageReason": {
          "enum": [
            null,
            "PICK_TITLE_GROUP_UNRESOLVED",
            "FEWER_THAN_FIVE_DISTINCT_PRODUCTS",
            "PICK_PRODUCT_UNRESOLVED"
          ]
        },
        "skipped": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceRank",
              "productBaseId",
              "reason",
              "duplicateOfRank"
            ],
            "properties": {
              "sourceRank": {
                "type": "integer",
                "minimum": 1,
                "maximum": 200
              },
              "productBaseId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "duplicateOfRank": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 5
              }
            }
          }
        },
        "matcher": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "model",
            "questionVersion",
            "threshold"
          ],
          "properties": {
            "provider": {
              "const": "typesafe-jev"
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "questionVersion": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "decisions": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceRank",
              "productBaseId",
              "choice",
              "probabilities",
              "outcome"
            ],
            "properties": {
              "sourceRank": {
                "type": "integer",
                "minimum": 1,
                "maximum": 200
              },
              "productBaseId": {
                "type": "string",
                "pattern": "^1__[1-9][0-9]{0,19}__[1-9][0-9]{0,19}$"
              },
              "choice": {
                "type": "string",
                "pattern": "^(SP[1-4]|MOI)$"
              },
              "probabilities": {
                "type": "object",
                "minProperties": 2,
                "maxProperties": 5,
                "propertyNames": {
                  "pattern": "^(SP[1-4]|MOI)$"
                },
                "additionalProperties": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "outcome": {
                "enum": [
                  "PICKED",
                  "DUPLICATE",
                  "UNSURE"
                ]
              }
            }
          }
        }
      }
    }
  },
  "description": "productBaseId is 1__itemId__shopId. Auto counts must be supplied by M2, never invented for old runs. Manual uses null metricInputSha256 and pickRuleVersion manual.",
  "anyOf": [
    {
      "properties": {
        "source": {
          "const": "auto"
        },
        "metricInputSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    {
      "properties": {
        "source": {
          "const": "manual"
        },
        "metricInputSha256": {
          "type": "null"
        },
        "pickRuleVersion": {
          "const": "manual"
        }
      }
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "pickRuleVersion": {
            "enum": [
              "metric-products-unique-v1",
              "metric-products-unique-v2"
            ]
          }
        }
      },
      "then": {
        "required": [
          "selectionProof"
        ],
        "properties": {
          "source": {
            "const": "auto"
          },
          "links": {
            "items": {
              "required": [
                "sourceRank",
                "productName",
                "shopName"
              ],
              "properties": {
                "sourceRank": {},
                "productName": {},
                "shopName": {}
              },
              "type": "object"
            },
            "type": "array"
          },
          "selectionProof": {}
        }
      },
      "else": {
        "properties": {
          "links": {
            "minItems": 1,
            "type": "array"
          },
          "selectionProof": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "pickRuleVersion": {
            "const": "metric-products-unique-v1"
          }
        }
      },
      "then": {
        "properties": {
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "groupKey",
                "groupingBasis"
              ],
              "properties": {
                "groupKey": {},
                "groupingBasis": {}
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "pickRuleVersion": {
            "const": "metric-products-unique-v2"
          }
        }
      },
      "then": {
        "properties": {
          "selectionProof": {
            "type": "object",
            "required": [
              "matcher",
              "decisions"
            ],
            "properties": {
              "matcher": {},
              "decisions": {}
            }
          }
        }
      }
    }
  ]
}
