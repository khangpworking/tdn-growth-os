{
  "name": "tdn-growth-os",
  "version": "0.1.0",
  "private": true,
  "description": "TDN five-box modular monolith — planning scaffold",
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": "24.15.0"
  },
  "scripts": {
    "source-package:intake": "tsx scripts/intake-source-package.ts",
    "research:shopee": "tsx scripts/collect-shopee-reviews.ts",
    "research:shopee:export": "tsx scripts/export-shopee-evidence-report.ts",
    "report:combined:export": "tsx scripts/export-combined-market-review-report.ts",
    "contracts:generate": "node scripts/generate-foundation-contract.mjs",
    "db:migrate": "tsx scripts/migrate.ts",
    "foundation:ingest": "tsx scripts/ingest-manual.ts",
    "foundation:ingest-export": "tsx scripts/ingest-json-export.ts",
    "typecheck": "node scripts/typecheck.mjs",
    "workspace-api:start": "tsx scripts/serve-workspace-api.ts",
    "workspace-owner-api:start": "tsx scripts/serve-owner-api.ts",
    "operator-app:start": "tsx scripts/serve-operator-app.ts",
    "frontend:dev": "vite --config frontend/vite.config.ts",
    "frontend:typecheck": "tsc -p frontend/tsconfig.json --noEmit",
    "frontend:build": "vite build --config frontend/vite.config.ts",
    "frontend:preview": "vite preview --config frontend/vite.config.ts",
    "frontend:test": "node --import tsx --test frontend/tests/*.test.ts",
    "test": "node --import tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "check": "npm run contracts:generate && npm run typecheck && npm run frontend:typecheck && npm run frontend:build && npm run frontend:test && npm test"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "better-sqlite3": "12.11.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "json-schema-to-typescript": "15.0.4",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
