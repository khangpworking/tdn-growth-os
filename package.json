{
  "name": "tdn-growth-os",
  "version": "0.1.0",
  "private": true,
  "description": "TDN five-box modular monolith — planning scaffold",
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": "24.15.0"
  },
  "scripts": {
    "research:shopee": "tsx scripts/collect-shopee-reviews.ts",
    "research:shopee:export": "tsx scripts/export-shopee-evidence-report.ts",
    "contracts:generate": "node scripts/generate-foundation-contract.mjs",
    "db:migrate": "tsx scripts/migrate.ts",
    "foundation:ingest": "tsx scripts/ingest-manual.ts",
    "foundation:ingest-export": "tsx scripts/ingest-json-export.ts",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node --import tsx --test tests/integration/*.test.ts",
    "check": "npm run contracts:generate && npm run typecheck && npm test"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "better-sqlite3": "12.11.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.13.3",
    "json-schema-to-typescript": "15.0.4",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}

