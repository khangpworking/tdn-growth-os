@prefix ex: <urn:onto:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
ex:Check1 a sh:NodeShape;  sh:targetClass ex:Persona;
sh:property [ sh:path ex:card; sh:minCount 3; sh:node [ sh:property [ sh:path ex:quote; sh:minCount 1; sh:datatype xsd:string; sh:minLength 1; sh:pattern "[!-~¡-ᙿᚁ-῿​-‧‪-‮‰-⁞⁠-⿿、-퟿-􏿿]"; sh:message "Thiếu câu trích không rỗng" ]; sh:property [ sh:path ex:locator; sh:minCount 1; sh:datatype xsd:string; sh:minLength 1; sh:pattern "[!-~¡-ᙿᚁ-῿​-‧‪-‮‰-⁞⁠-⿿、-퟿-􏿿]"; sh:message "Thiếu locator của câu trích" ] ]; sh:message "Chân dung cần ít nhất 3 thẻ bằng chứng" ];
sh:property [ sh:path ex:attribute; sh:node [ sh:property [ sh:path ex:quote; sh:minCount 1; sh:datatype xsd:string; sh:minLength 1; sh:pattern "[!-~¡-ᙿᚁ-῿​-‧‪-‮‰-⁞⁠-⿿、-퟿-􏿿]"; sh:message "Thiếu câu trích không rỗng" ]; sh:property [ sh:path ex:locator; sh:minCount 1; sh:datatype xsd:string; sh:minLength 1; sh:pattern "[!-~¡-ᙿᚁ-῿​-‧‪-‮‰-⁞⁠-⿿、-퟿-􏿿]"; sh:message "Thiếu locator của câu trích" ] ]; sh:message "Đặc điểm cần câu trích và locator" ];
sh:property [ sh:path ex:platform; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:string; sh:minLength 1; sh:pattern "[!-~¡-ᙿᚁ-῿​-‧‪-‮‰-⁞⁠-⿿、-퟿-􏿿]"; sh:message "Chỉ đếm người trong một nền tảng" ];
sh:property [ sh:path ex:aiLabel; sh:maxCount 1; sh:hasValue "Chân dung do AI tổng hợp từ lời khách thật, không phải một khách hàng có thật"; sh:message "Thiếu nhãn chân dung do AI tổng hợp" ];
sh:property [ sh:path ex:identityMode; sh:minCount 1; sh:maxCount 1; sh:in ( "author-ids" "unverified-content" ) ] .
ex:AuthorIDsMode a sh:NodeShape;  sh:targetClass ex:Persona; sh:or ( [ sh:property [ sh:path ex:identityMode; sh:hasValue "unverified-content" ] ] [ sh:property [ sh:path ex:author; sh:minCount 5; sh:datatype xsd:string; sh:minLength 1; sh:pattern "[!-~¡-ᙿᚁ-῿​-‧‪-‮‰-⁞⁠-⿿、-퟿-􏿿]"; sh:message "Cần 5 mã người viết khác nhau" ]; sh:property [ sh:path ex:unverified; sh:maxCount 0 ]; sh:property [ sh:path ex:identityMode; sh:hasValue "author-ids" ] ] ) .
ex:ContentMode a sh:NodeShape;  sh:targetClass ex:Persona; sh:or ( [ sh:property [ sh:path ex:identityMode; sh:hasValue "author-ids" ] ] [ sh:property [ sh:path ex:author; sh:maxCount 0 ]; sh:property [ sh:path ex:unverified; sh:maxCount 1; sh:hasValue "chưa xác minh là 5 người"; sh:message "Thiếu cờ chưa xác minh là 5 người" ]; sh:property [ sh:path ex:distinctContent; sh:minCount 5; sh:datatype xsd:string; sh:minLength 1; sh:pattern "[!-~¡-ᙿᚁ-῿​-‧‪-‮‰-⁞⁠-⿿、-퟿-􏿿]"; sh:message "Cần 5 nội dung khác nhau khi không có mã người viết" ]; sh:property [ sh:path ex:identityMode; sh:hasValue "unverified-content" ] ] ) .
