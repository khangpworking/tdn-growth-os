@prefix ex: <urn:onto:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
ex:Check3 a sh:NodeShape;  sh:targetClass ex:Figure3;
sh:property [ sh:path ex:attribution; sh:maxCount 1; sh:in ( "Ngân hàng Thế giới (World Bank Open Data)" ); sh:minCount 1; sh:datatype xsd:string; sh:minLength 1; sh:pattern "[!-~¡-ᙿᚁ-῿​-‧‪-‮‰-⁞⁠-⿿、-퟿-􏿿]"; sh:message "Thiếu văn bản ghi nguồn" ];
sh:property [ sh:path ex:valueStatus; sh:minCount 1; sh:maxCount 1; sh:in ( "ước tính" "sơ bộ" "chính thức" ); sh:message "Trạng thái phải là ước tính, sơ bộ hoặc chính thức" ];
sh:property [ sh:path ex:file; sh:minCount 1; sh:datatype xsd:string; sh:minLength 1; sh:pattern "[!-~¡-ᙿᚁ-῿​-‧‪-‮‰-⁞⁠-⿿、-퟿-􏿿]"; sh:message "Thiếu file truy nguồn" ];
sh:property [ sh:path ex:sheet; sh:minCount 1; sh:datatype xsd:string; sh:minLength 1; sh:pattern "[!-~¡-ᙿᚁ-῿​-‧‪-‮‰-⁞⁠-⿿、-퟿-􏿿]"; sh:message "Thiếu sheet truy nguồn" ];
sh:property [ sh:path ex:row; sh:minCount 1; sh:datatype xsd:string; sh:minLength 1; sh:pattern "[!-~¡-ᙿᚁ-῿​-‧‪-‮‰-⁞⁠-⿿、-퟿-􏿿]"; sh:message "Thiếu dòng truy nguồn" ];
sh:property [ sh:path ex:indicatorName; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:string; sh:minLength 1; sh:pattern "[!-~¡-ᙿᚁ-῿​-‧‪-‮‰-⁞⁠-⿿、-퟿-􏿿]"; ];
sh:property [ sh:path ex:indicatorCode; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:string; sh:minLength 1; sh:pattern "[!-~¡-ᙿᚁ-῿​-‧‪-‮‰-⁞⁠-⿿、-퟿-􏿿]"; ];
sh:property [ sh:path ex:year; sh:pattern "^[0-9][0-9][0-9][0-9]$"; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:string; sh:minLength 1; ];
sh:property [ sh:path ex:datasetUpdateDate; sh:pattern "^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$"; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:string; sh:minLength 1; ] .
