      },
      "corpora": {
        "type": "array",
        "maxItems": 100,
        "items": {
          "title": "InsightProposedCorpusCoding",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "corpusIndex",
            "assignments",
            "dispositions"
          ],
          "properties": {
            "corpusIndex": {
