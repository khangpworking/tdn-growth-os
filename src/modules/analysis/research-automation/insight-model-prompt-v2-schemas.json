            }
          }
        }
      }
    }
  },
  "locatedDefinitions": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000,
      "pattern": "\\S"
    },
    "nullableText": {
      "anyOf": [
        {
          "$ref": "#/$defs/text"
        },
        {
          "type": "null"
        }
      ]
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9999
    },
    "strings": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "quote"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "end": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000000
        }
      },
      "description": "Half-open UTF-16 offsets in the exact record text, with no Unicode or whitespace normalization."
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "coderRole",
        "adjudication",
        "disagreement"
      ],
      "properties": {
        "basis": {
          "enum": [
            "DECLARED",
            "HUMAN_REVIEWED",
            "PENDING_AI"
          ]
        },
        "coderRole": {
          "$ref": "#/$defs/text"
        },
        "adjudication": {
          "$ref": "#/$defs/nullableText"
        },
        "disagreement": {
          "$ref": "#/$defs/nullableText"
        }
      },
      "description": "Declared annotation provenance, never authenticated application approval. Pointer resolution proves text location only, not semantic truth or human authority. AI suggestions remain pending."
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceSha256",
        "locator",
        "text",
        "sourceAttribution",
        "timeText",
        "disposition",
        "dispositionReason"
      ],
      "properties": {
        "sourceSha256": {
          "$ref": "#/$defs/digest"
        },
        "locator": {
          "type": "string",
          "pattern": "^(?:/(?:[^~/]|~[01])*)+$",
          "maxLength": 2000
        },
        "text": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000000
        },
        "sourceAttribution": {
          "$ref": "#/$defs/text"
        },
        "timeText": {
          "$ref": "#/$defs/nullableText"
        },
        "disposition": {
          "enum": [
            "INCLUDED",
            "EXCLUDED",
            "UNREADABLE"
          ]
        },
        "dispositionReason": {
          "$ref": "#/$defs/nullableText"
        }
      }
    },
    "field": {
