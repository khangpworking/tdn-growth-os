{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdn.local/contracts/analysis/source-backed-report-request.schema.json",
  "title": "SourceBackedReportRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "workspaceId", "packageId", "packageManifestSha256", "workbookPath", "manifestPath", "labelsPath", "catalogSha256"],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "workspaceId": { "type": "string", "format": "uuid" },
    "packageId": { "type": "string", "format": "uuid" },
    "packageManifestSha256": { "$ref": "#/$defs/digest" },
    "workbookPath": { "$ref": "#/$defs/logicalPath" },
    "manifestPath": { "$ref": "#/$defs/logicalPath" },
    "labelsPath": { "anyOf": [{ "$ref": "#/$defs/logicalPath" }, { "type": "null" }] },
    "tabletQuoteSourcePath": { "anyOf": [{ "$ref": "#/$defs/logicalPath" }, { "type": "null" }] },
    "tabletQuoteInputPath": { "anyOf": [{ "$ref": "#/$defs/logicalPath" }, { "type": "null" }] },
    "catalogSha256": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "logicalPath": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)[^\\u0000]+$" }
  }
}
