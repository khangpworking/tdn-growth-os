{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdn.local/contracts/analysis/metric-scope-output.schema.json",
  "title": "MetricScopeOutput",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contractVersion": {
      "const": "1.0.0"
    },
    "methodVersion": {
      "const": "metric-scope-v1"
    },
    "rounding": {
      "const": "percent-half-even-2-v1"
    },
    "status": {
      "const": "DRAFT"
    },
    "verification": {
      "const": "NORMALIZED_INPUT_ONLY"
    },
    "inputSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "input": {
      "$ref": "./metric-scope-input.schema.json"
    },
    "labelIssues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "recordIndex": {
            "type": "integer",
            "minimum": 0
          },
          "reason": {
            "enum": [
              "MISSING_LABEL",
              "STALE_LABEL",
              "CODEBOOK_MISMATCH"
            ]
          }
        },
        "required": [
          "recordIndex",
          "reason"
        ]
      }
    },
    "scopes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/Scope"
      }
    },
    "comparisons": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "from": {
            "const": "all"
          },
          "to": {
            "enum": [
              "wide",
              "core"
            ]
          },
          "revenueDelta": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)$"
              },
              {
                "type": "null"
              }
            ]
          },
          "commonShopRanks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "shopKey": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "fromRank": {
                  "type": "integer",
                  "minimum": 1
                },
                "toRank": {
                  "type": "integer",
                  "minimum": 1
                },
                "delta": {
                  "type": "integer"
                }
              },
              "required": [
                "shopKey",
                "fromRank",
                "toRank",
                "delta"
              ]
            }
          },
          "topShopRetention": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "k": {
                  "enum": [
                    1,
                    3,
                    10
                  ]
                },
                "commonShopKeys": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  }
                }
              },
              "required": [
                "k",
                "commonShopKeys"
              ]
            }
          },
          "removedRecordIndices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "unitsDelta": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "from",
          "to",
          "revenueDelta",
          "commonShopRanks",
          "topShopRetention",
          "removedRecordIndices",
          "unitsDelta"
        ]
      }
    },
    "rendererVersion": {
      "const": "metric-draft-vi-v1"
    }
  },
  "required": [
    "contractVersion",
    "methodVersion",
    "rounding",
    "status",
    "verification",
    "inputSha256",
    "input",
    "labelIssues",
    "scopes",
    "comparisons",
    "rendererVersion"
  ],
  "$defs": {
    "Total": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,49})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "observedCount": {
          "type": "integer",
          "minimum": 0
        },
        "missingCount": {
          "type": "integer",
          "minimum": 0
        },
        "nonExactCount": {
          "type": "integer",
          "minimum": 0
        },
        "complete": {
          "type": "boolean"
        }
      },
      "required": [
        "value",
        "observedCount",
        "missingCount",
        "nonExactCount",
        "complete"
      ]
    },
    "Ratio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "numerator": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,49})$"
        },
        "denominator": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,49})$"
        },
        "percent": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{2}$"
        }
      },
      "required": [
        "numerator",
        "denominator",
        "percent"
      ]
    },
    "Shop": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shopKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "revenue": {
          "$ref": "#/$defs/Total"
        },
        "units": {
          "$ref": "#/$defs/Total"
        }
      },
      "required": [
        "shopKey",
        "revenue",
        "units"
      ]
    },
    "Scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "enum": [
            "all",
            "wide",
            "core"
          ]
        },
        "status": {
          "enum": [
            "CALCULATED",
            "BLOCKED_LABELS"
          ]
        },
        "recordIndices": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "listingCount": {
          "type": "integer",
          "minimum": 0
        },
        "shopCount": {
          "type": "integer",
          "minimum": 0
        },
        "revenue": {
          "$ref": "#/$defs/Total"
        },
        "units": {
          "$ref": "#/$defs/Total"
        },
        "warnings": {
          "type": "array",
          "items": {
            "enum": [
              "EMPTY_SCOPE",
              "MISSING_REVENUE",
              "MISSING_UNITS",
              "NON_EXACT_REVENUE",
              "NON_EXACT_UNITS",
              "ZERO_REVENUE",
              "LABELS_REQUIRE_ADJUDICATION"
            ]
          }
        },
        "shops": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Shop"
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "group": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "listingCount": {
                "type": "integer",
                "minimum": 0
              },
              "revenue": {
                "$ref": "#/$defs/Total"
              },
              "units": {
                "$ref": "#/$defs/Total"
              },
              "revenueShare": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Ratio"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "group",
              "listingCount",
              "revenue",
              "units",
              "revenueShare"
            ]
          }
        },
        "concentration": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "k": {
                "enum": [
                  1,
                  3,
                  10
                ]
              },
              "usedShopCount": {
                "type": "integer",
                "minimum": 0
              },
              "share": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Ratio"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "k",
              "usedShopCount",
              "share"
            ]
          }
        },
        "withoutTopShop": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "removedShopKey": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "listingCount": {
                  "type": "integer",
                  "minimum": 0
                },
                "revenue": {
                  "$ref": "#/$defs/Total"
                },
                "remainingRevenueShare": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/Ratio"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "shops": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/Shop"
                  }
                },
                "concentration": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "k": {
                        "enum": [
                          1,
                          3,
                          10
                        ]
                      },
                      "usedShopCount": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "share": {
                        "anyOf": [
                          {
                            "$ref": "#/$defs/Ratio"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "k",
                      "usedShopCount",
                      "share"
                    ]
                  }
                }
              },
              "required": [
                "removedShopKey",
                "listingCount",
                "revenue",
                "remainingRevenueShare",
                "shops",
                "concentration"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "key",
        "status",
        "recordIndices",
        "listingCount",
        "shopCount",
        "revenue",
        "units",
        "warnings",
        "shops",
        "groups",
        "concentration",
        "withoutTopShop"
      ]
    }
  }
}
