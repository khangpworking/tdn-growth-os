{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdn.local/contracts/analysis/automation-i14-synthesis-configuration.schema.json",
  "title": "AutomationI14SynthesisConfiguration",
  "description": "Resolved non-secret I14 text-generation configuration. Credentials, endpoints and headers belong to the transport and are never retained here. A provider or model id records what was resolved; it does not establish availability.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "methodId", "providerId", "modelId", "temperature", "maxOutputTokens", "timeoutMs", "maxResponseBytes"],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "methodId": { "const": "automation-i14-synthesis-configuration" },
    "providerId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$" },
    "modelId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "temperature": { "anyOf": [{ "type": "number", "minimum": 0, "maximum": 2 }, { "type": "null" }] },
    "maxOutputTokens": { "type": "integer", "minimum": 1, "maximum": 65536 },
    "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 600000 },
    "maxResponseBytes": { "type": "integer", "minimum": 1, "maximum": 1048576 }
  }
}
