{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdn.local/contracts/analysis/m03-section-artifact-request.schema.json",
  "title": "M03SectionArtifactRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "sectionId", "rendererProfile", "narrativeSha256"],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "sectionId": { "const": "M03" },
    "rendererProfile": { "const": "m03-section-artifact-html-vi-v1" },
    "narrativeSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
