          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "frozenStartSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "frozenScopeSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
