        "scope": {
          "title": "InsightReaderFrozenScope",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "keyword",
            "definition",
            "requestedPeriod"
          ],
          "properties": {
            "keyword": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*$"
