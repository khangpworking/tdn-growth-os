                  "BOUNDED",
                  "SOURCE_EVIDENCE",
                  "SOURCE_CLAIMS",
                  "DECISION_PACKET",
                  "DECISION_SYNTHESIS",
                  "I14_ADMISSION",
                  "I14_SYNTHESIS"
