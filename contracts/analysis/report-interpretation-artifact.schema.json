{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdn.local/contracts/analysis/report-interpretation-artifact.schema.json",
  "title": "ReportInterpretationArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "interpretationId", "interpretationContentSha256", "requestSha256", "completedAt", "source", "generation", "items", "limitations"],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "interpretationId": { "type": "string", "format": "uuid" },
    "interpretationContentSha256": { "$ref": "#/$defs/digest" },
    "requestSha256": { "$ref": "#/$defs/digest" },
    "completedAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semanticVersionId", "packetId", "packetSha256", "claimsSha256"],
      "properties": {
        "semanticVersionId": { "$ref": "#/$defs/digest" },
        "packetId": { "$ref": "#/$defs/digest" },
        "packetSha256": { "$ref": "#/$defs/digest" },
        "claimsSha256": { "$ref": "#/$defs/digest" }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerId", "modelId", "promptId", "promptVersion", "promptSha256", "outputSchemaVersion"],
      "properties": {
        "providerId": { "type": "string", "minLength": 1, "maxLength": 120 },
        "modelId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "promptId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "promptVersion": { "type": "integer", "minimum": 1 },
        "promptSha256": { "$ref": "#/$defs/digest" },
        "outputSchemaVersion": { "const": "1.0.0" },
        "providerRequestId": { "type": "string", "minLength": 1, "maxLength": 300 },
        "inputTokenCount": { "type": "integer", "minimum": 0 },
        "outputTokenCount": { "type": "integer", "minimum": 0 },
        "latencyMs": { "type": "integer", "minimum": 0, "maximum": 3600000 }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": { "$ref": "#/$defs/resolvedItem" }
    },
    "limitations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "resolvedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemId", "sectionId", "kind", "conclusion", "evidenceLogic", "supportingClaimIds", "citations", "assumptions", "limitations"],
      "properties": {
        "itemId": { "$ref": "#/$defs/digest" },
        "sectionId": { "type": "string", "pattern": "^[MI][0-9]{2,3}$" },
        "kind": { "enum": ["INTERPRETATION", "HYPOTHESIS"] },
        "conclusion": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "evidenceLogic": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "supportingClaimIds": {
          "type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        "citations": {
          "type": "array", "minItems": 1, "maxItems": 12,
          "items": { "$ref": "#/$defs/citation" }
        },
        "assumptions": {
          "type": "array", "maxItems": 8, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 400 }
        },
        "limitations": {
          "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 400 }
        }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimId", "sectionId", "statementKind", "scopeKey", "value", "unit", "metricPointer", "scopePointer", "membershipPointer", "denominatorPointer", "coveragePointer", "limitations"],
      "properties": {
        "claimId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "sectionId": { "type": "string", "pattern": "^[MI][0-9]{2,3}$" },
        "statementKind": { "enum": ["LISTING_COUNT", "SHOP_COUNT", "OBSERVED_REVENUE", "OBSERVED_UNITS", "TOP_SHOP_SHARE"] },
        "scopeKey": { "enum": ["all", "wide", "core"] },
        "value": {
          "anyOf": [
            { "type": "string", "minLength": 1, "maxLength": 80 },
            { "type": "integer", "minimum": 0 }
          ]
        },
        "unit": { "enum": ["listing", "shop", "VND", "unit", "percent"] },
        "metricPointer": { "type": "string", "pattern": "^/", "maxLength": 400 },
        "scopePointer": { "const": "/input/scope" },
        "membershipPointer": { "type": "string", "pattern": "^/", "maxLength": 400 },
        "denominatorPointer": {
          "anyOf": [{ "type": "string", "pattern": "^/", "maxLength": 400 }, { "type": "null" }]
        },
        "coveragePointer": {
          "anyOf": [{ "type": "string", "pattern": "^/", "maxLength": 400 }, { "type": "null" }]
        },
        "limitations": {
          "type": "array", "minItems": 1, "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    }
  }
}
