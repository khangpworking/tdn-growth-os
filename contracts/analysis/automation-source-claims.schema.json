{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdn.local/contracts/analysis/automation-source-claims.schema.json",
  "title": "AutomationSourceClaims",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "methodId", "methodVersion", "runId", "workspaceId", "scopeSha256", "claimsSha256", "claims", "limitations"],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "methodId": { "const": "automation-source-claims" },
    "methodVersion": { "const": "1.0.0" },
    "runId": { "$ref": "#/$defs/uuid" },
    "workspaceId": { "$ref": "#/$defs/uuid" },
    "scopeSha256": { "$ref": "#/$defs/digest" },
    "claimsSha256": { "$ref": "#/$defs/digest" },
    "claims": {
      "type": "array",
      "maxItems": 20000,
      "items": { "$ref": "#/$defs/claim" }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/text" }
    }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 4000, "pattern": "\\S" },
    "nullableText": { "anyOf": [{ "$ref": "#/$defs/text" }, { "type": "null" }] },
    "decimal": { "type": "string", "maxLength": 200, "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$" },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageId", "version", "manifestArtifactSha256", "packageContentSha256"],
      "properties": {
        "packageId": { "$ref": "#/$defs/uuid" },
        "version": { "type": "integer", "minimum": 1 },
        "manifestArtifactSha256": { "$ref": "#/$defs/digest" },
        "packageContentSha256": { "$ref": "#/$defs/digest" }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["methodId", "methodVersion", "methodOutputId", "artifact", "outputPointer"],
      "properties": {
        "methodId": { "$ref": "#/$defs/text" },
        "methodVersion": { "$ref": "#/$defs/text" },
        "methodOutputId": { "$ref": "#/$defs/digest" },
        "artifact": { "$ref": "#/$defs/package" },
        "outputPointer": { "type": "string", "pattern": "^/", "maxLength": 400 }
      }
    },
    "sourceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "logicalPath", "sha256", "locator", "recordLocator", "statement", "attribution", "spans"],
      "properties": {
        "package": { "$ref": "#/$defs/package" },
        "logicalPath": { "$ref": "#/$defs/text" },
        "sha256": { "$ref": "#/$defs/digest" },
        "locator": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "recordLocator": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 2000 }, { "type": "null" }] },
        "statement": { "$ref": "#/$defs/nullableText" },
        "attribution": { "$ref": "#/$defs/nullableText" },
        "spans": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/span" } }
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "start", "end", "quote"],
      "properties": {
        "role": { "enum": ["RECORD", "DECLARATION", "QUALIFIER", "COUNTEREVIDENCE", "CONTEXT"] },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 1 },
        "quote": { "type": "string", "minLength": 1, "maxLength": 1000000, "pattern": "\\S" }
      }
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "timezone", "basis"],
      "properties": {
        "start": { "type": "string", "format": "date" },
        "end": { "type": "string", "format": "date" },
        "timezone": { "$ref": "#/$defs/text" },
        "basis": { "$ref": "#/$defs/text" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scopeSha256", "universe", "geography", "frame", "inclusionRule", "exclusionRule", "variantRule", "description"],
      "properties": {
        "scopeSha256": { "$ref": "#/$defs/digest" },
        "universe": { "$ref": "#/$defs/nullableText" },
        "geography": { "$ref": "#/$defs/nullableText" },
        "frame": { "$ref": "#/$defs/nullableText" },
        "inclusionRule": { "$ref": "#/$defs/nullableText" },
        "exclusionRule": { "$ref": "#/$defs/nullableText" },
        "variantRule": { "$ref": "#/$defs/nullableText" },
        "description": { "$ref": "#/$defs/text" }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "observedCount", "zeroCount", "missingCount", "unknownCount", "nonExactCount", "description"],
      "properties": {
        "unit": { "enum": ["SOURCE_OBSERVATIONS", "LOCATED_RECORDS"] },
        "observedCount": { "type": "integer", "minimum": 0 },
        "zeroCount": { "type": "integer", "minimum": 0 },
        "missingCount": { "type": "integer", "minimum": 0 },
        "unknownCount": { "type": "integer", "minimum": 0 },
        "nonExactCount": { "type": "integer", "minimum": 0 },
        "description": { "$ref": "#/$defs/text" }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "state", "measure", "value", "unit", "precision", "period", "periodText", "scope", "coverage", "limitations"],
      "properties": {
        "basis": { "enum": ["SOURCE_OBSERVED", "DECLARED"] },
        "state": { "enum": ["observed_zero", "observed_value", "DECLARED"] },
        "measure": {
          "anyOf": [{
            "type": "object", "additionalProperties": false,
            "required": ["literal", "definition", "entityLabel"],
            "properties": {
              "literal": { "$ref": "#/$defs/text" },
              "definition": { "$ref": "#/$defs/text" },
              "entityLabel": { "$ref": "#/$defs/nullableText" }
            }
          }, { "type": "null" }]
        },
        "value": { "anyOf": [{ "$ref": "#/$defs/decimal" }, { "type": "null" }] },
        "unit": { "$ref": "#/$defs/nullableText" },
        "precision": { "enum": ["exact", "non_exact", "not_applicable"] },
        "period": { "anyOf": [{ "$ref": "#/$defs/period" }, { "type": "null" }] },
        "periodText": { "$ref": "#/$defs/nullableText" },
        "scope": { "$ref": "#/$defs/scope" },
        "coverage": { "$ref": "#/$defs/coverage" },
        "limitations": { "type": "array", "minItems": 1, "maxItems": 30, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } }
      }
    },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceAttribution", "annotationAttribution", "provenance"],
      "properties": {
        "sourceAttribution": { "$ref": "#/$defs/text" },
        "annotationAttribution": { "$ref": "#/$defs/nullableText" },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["basis", "coderRole", "adjudication", "disagreement"],
          "properties": {
            "basis": { "const": "DECLARED" },
            "coderRole": { "$ref": "#/$defs/text" },
            "adjudication": { "$ref": "#/$defs/nullableText" },
            "disagreement": { "$ref": "#/$defs/nullableText" }
          }
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimId", "sectionId", "method", "source", "observation", "declaration", "limitations"],
      "properties": {
        "claimId": { "$ref": "#/$defs/digest" },
        "sectionId": { "enum": ["M05", "I02", "I04"] },
        "method": { "$ref": "#/$defs/method" },
        "source": { "$ref": "#/$defs/sourceFile" },
        "observation": { "$ref": "#/$defs/observation" },
        "declaration": { "anyOf": [{ "$ref": "#/$defs/declaration" }, { "type": "null" }] },
        "limitations": { "type": "array", "minItems": 1, "maxItems": 30, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } }
      }
    }
  }
}
