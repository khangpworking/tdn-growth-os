{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdn.local/contracts/analysis/research-evidence-index-result.schema.json",
  "title": "ResearchEvidenceIndexResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "resultId", "calculationKey", "calculationVersion", "completedAt", "researchPack", "coverage", "documents"],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "resultId": { "type": "string", "format": "uuid" },
    "calculationKey": { "const": "research_evidence_index_v1" },
    "calculationVersion": { "const": 1 },
    "completedAt": { "type": "string", "format": "date-time" },
    "researchPack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["researchPackId", "manifestArtifactSha256"],
      "properties": {
        "researchPackId": { "type": "string", "format": "uuid" },
        "manifestArtifactSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentCount", "retainedSegmentCount"],
      "properties": {
        "documentCount": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "retainedSegmentCount": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1048576,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["documentId", "rawArtifactSha256", "languageTag", "documentType", "title", "sourceLocator", "segments"],
        "properties": {
          "documentId": { "type": "string", "format": "uuid" },
          "rawArtifactSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "languageTag": { "type": "string", "minLength": 1, "maxLength": 80 },
          "documentType": { "enum": ["news_article", "report", "web_page", "transcript", "other"] },
          "title": { "type": "string", "minLength": 1, "maxLength": 500 },
          "sourceLocator": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "segments": {
            "type": "array",
            "minItems": 1,
            "maxItems": 524288,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["segmentIndex", "byteStart", "byteEnd", "textSha256", "text", "citationPointer"],
              "properties": {
                "segmentIndex": { "type": "integer", "minimum": 0 },
                "byteStart": { "type": "integer", "minimum": 0, "maximum": 1048576 },
                "byteEnd": { "type": "integer", "minimum": 1, "maximum": 1048576 },
                "textSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "text": { "type": "string", "minLength": 1, "maxLength": 1048576 },
                "citationPointer": { "type": "string", "minLength": 28, "maxLength": 120, "pattern": "^/documents/(0|[1-9][0-9]*)/segments/(0|[1-9][0-9]*)/text$" }
              }
            }
          }
        }
      }
    }
  }
}
