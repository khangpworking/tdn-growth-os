{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdn-growth-os.local/contracts/analysis/world-bank-intake-v1.schema.json",
  "title": "WorldBankIntakeV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "binding",
    "requestKey",
    "sourceLabel",
    "acquiredAt",
    "condition",
    "observationPath",
    "metadataPath",
    "projection"
  ],
  "properties": {
    "contractVersion": {
      "const": "world-bank-intake-v1",
      "type": "string"
    },
    "binding": {
      "$ref": "#/$defs/binding"
    },
    "requestKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,100}$"
    },
    "sourceLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "acquiredAt": {
      "type": "string",
      "format": "date-time"
    },
    "condition": {
      "const": "MULTI_YEAR_SERIES",
      "type": "string"
    },
    "observationPath": {
      "const": "macro/observations.json",
      "type": "string"
    },
    "metadataPath": {
      "const": "macro/metadata.json",
      "type": "string"
    },
    "projection": {
      "$ref": "#/$defs/projection"
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaceId",
        "runId",
        "startSha256",
        "scopeSha256",
        "sourceSetSha256"
      ],
      "properties": {
        "workspaceId": {
          "type": "string",
          "format": "uuid"
        },
        "runId": {
          "type": "string",
          "format": "uuid"
        },
        "startSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "scopeSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sourceSetSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "packageRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageId",
        "manifestArtifactSha256",
        "packageContentSha256"
      ],
      "properties": {
        "packageId": {
          "type": "string",
          "format": "uuid"
        },
        "manifestArtifactSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "packageContentSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator",
        "indicatorCode",
        "indicatorName",
        "countryCode",
        "countryName",
        "year",
        "value",
        "valueLexeme",
        "unit",
        "unitLiteral",
        "observationUnitLiteral",
        "lastUpdated",
        "statusLiteral",
        "footnote",
        "decimal"
      ],
      "properties": {
        "locator": {
          "type": "string",
          "pattern": "^/1/[0-9]+$"
        },
        "indicatorCode": {
          "enum": [
            "NE.CON.PRVT.PC.KD",
            "SP.POP.TOTL"
          ],
          "type": "string"
        },
        "indicatorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "countryCode": {
          "const": "VN",
          "type": "string"
        },
        "countryName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "year": {
          "type": "string",
          "pattern": "^[0-9]{4}$"
        },
        "value": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$",
              "maxLength": 405
            },
            {
              "type": "null"
            }
          ]
        },
        "valueLexeme": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000
            },
            {
              "type": "null"
            }
          ]
        },
        "unitLiteral": {
          "type": "string",
          "maxLength": 10000
        },
        "observationUnitLiteral": {
          "type": "string",
          "maxLength": 10000
        },
        "lastUpdated": {
          "type": "string",
          "format": "date"
        },
        "statusLiteral": {
          "type": "string",
          "maxLength": 10000
        },
        "footnote": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 10000
            },
            {
              "type": "null"
            }
          ]
        },
        "decimal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileId",
        "sourceSha256",
        "metadataSha256",
        "sourceUrl",
        "metadataUrl",
        "datasetId",
        "datasetName",
        "sourceNote",
        "sourceOrganization",
        "rows"
      ],
      "properties": {
        "profileId": {
          "const": "world-bank-vn-two-indicators-v1",
          "type": "string"
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "metadataSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sourceUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "metadataUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "datasetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "datasetName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "sourceNote": {
          "type": "string",
          "maxLength": 10000
        },
        "sourceOrganization": {
          "type": "string",
          "maxLength": 10000
        },
        "rows": {
          "type": "array",
          "minItems": 2,
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/row"
          }
        }
      }
    }
  }
}
