{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdn.local/contracts/analysis/research-evidence-audit-output.schema.json",
  "title": "ResearchEvidenceAuditOutput",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "claims", "unansweredQuestions", "overallAssessment", "limitations"],
  "properties": {
    "summary": { "type": "string", "minLength": 1, "maxLength": 1200 },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "claimText", "claimType", "assessment", "reasoning", "claimCitations", "supportingCitations", "contradictingCitations", "uncertainty"],
        "properties": {
          "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$" },
          "claimText": { "type": "string", "minLength": 1, "maxLength": 1200 },
          "claimType": { "enum": ["factual", "attribution", "inference", "opinion", "framing"] },
          "assessment": { "enum": ["supported", "contradicted", "mixed", "insufficient_evidence"] },
          "reasoning": { "type": "string", "minLength": 1, "maxLength": 1200 },
          "claimCitations": { "$ref": "#/$defs/citations" },
          "supportingCitations": { "$ref": "#/$defs/optionalCitations" },
          "contradictingCitations": { "$ref": "#/$defs/optionalCitations" },
          "uncertainty": { "type": "string", "minLength": 1, "maxLength": 800 }
        }
      }
    },
    "unansweredQuestions": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "whyMaterial"],
        "properties": {
          "question": { "type": "string", "minLength": 1, "maxLength": 800 },
          "whyMaterial": { "type": "string", "minLength": 1, "maxLength": 800 },
          "triggerCitations": { "$ref": "#/$defs/optionalCitations" }
        }
      }
    },
    "overallAssessment": { "enum": ["supported_within_pack", "supported_but_incomplete", "insufficient_evidence", "potentially_misleading_within_pack"] },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 800 }
    }
  },
  "$defs": {
    "citations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 28, "maxLength": 120 }
    },
    "optionalCitations": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 28, "maxLength": 120 }
    }
  }
}
