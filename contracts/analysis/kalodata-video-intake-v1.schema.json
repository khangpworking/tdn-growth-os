{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdn.local/contracts/analysis/kalodata-video-intake-v1.schema.json",
  "title": "KalodataVideoIntakeV1",
  "description": "Request, validated cited table, receipt and prepared list for one run-bound operator-supplied video/creator export (CSV or XLSX). Preparation stores an unverified, non-independent source only: it is not revision admission, report execution, data collection, transcription, provider authentication or business approval. There is no transcription code path in this package.",
  "oneOf": [{ "$ref": "#/$defs/request" }, { "$ref": "#/$defs/table" }, { "$ref": "#/$defs/receipt" }, { "$ref": "#/$defs/preparedList" }],
  "$defs": {
    "requestKey": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sourceLabel": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" },
    "acquiredAt": { "type": ["string", "null"], "format": "date-time" },
    "tableSelector": {
      "description": "Which cited table the uploaded file carries. A CSV file carries exactly one table; an XLSX workbook carries exactly the sheets of the declared tables.",
      "enum": ["video", "creator", "both"]
    },
    "missingDisplay": { "const": "không có dữ liệu" },
    "exactDecimal": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,39})(\\.[0-9]{1,10})?$" },
    "nullableDecimal": { "type": ["string", "null"], "pattern": "^(0|[1-9][0-9]{0,39})(\\.[0-9]{1,10})?$" },
    "nonEmptyText": { "type": "string", "minLength": 1, "maxLength": 10000, "pattern": "\\S" },
    "nullableText": { "type": ["string", "null"], "minLength": 1, "maxLength": 10000 },
    "dateText": { "type": ["string", "null"], "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$" },
    "request": {
      "title": "KalodataVideoPrepareRequest",
      "type": "object", "additionalProperties": false,
      "required": ["contractVersion", "requestKey", "table", "sourceLabel", "acquiredAt"],
      "properties": {
        "contractVersion": { "const": "automation-video-prepare-v1" },
        "requestKey": { "$ref": "#/$defs/requestKey" },
        "table": { "$ref": "#/$defs/tableSelector" },
        "sourceLabel": { "$ref": "#/$defs/sourceLabel" },
        "acquiredAt": { "$ref": "#/$defs/acquiredAt" }
      }
    },
    "context": {
      "title": "KalodataVideoUploadContext",
      "description": "Server-created record of the operator request bound to one run. Its declarations remain unverified.",
      "type": "object", "additionalProperties": false,
      "required": ["contractVersion", "declaration", "workspaceId", "runId", "runBindingSha256", "request"],
      "properties": {
        "contractVersion": { "const": "automation-video-upload-context-v1" },
        "declaration": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "workspaceId": { "$ref": "#/$defs/uuid" },
        "runId": { "$ref": "#/$defs/uuid" },
        "runBindingSha256": { "$ref": "#/$defs/digest" },
        "request": { "$ref": "#/$defs/request" }
      }
    },
    "videoRow": {
      "title": "KalodataVideoRow",
      "type": "object", "additionalProperties": false,
      "required": ["line", "video", "creator", "revenue", "views", "units", "adSpend", "publishDate", "productLink", "unitsPer1000Views", "adShare"],
      "properties": {
        "line": { "$ref": "#/$defs/nonEmptyText" },
        "video": { "$ref": "#/$defs/nullableText" },
        "creator": { "$ref": "#/$defs/nullableText" },
        "revenue": { "$ref": "#/$defs/nullableDecimal" },
        "views": { "$ref": "#/$defs/nullableDecimal" },
        "units": { "$ref": "#/$defs/nullableDecimal" },
        "adSpend": { "$ref": "#/$defs/nullableDecimal" },
        "publishDate": { "$ref": "#/$defs/dateText" },
        "productLink": { "$ref": "#/$defs/nullableText" },
        "unitsPer1000Views": { "$ref": "#/$defs/nullableDecimal" },
        "adShare": { "$ref": "#/$defs/nullableDecimal" }
      }
    },
    "creatorRow": {
      "title": "KalodataCreatorRow",
      "type": "object", "additionalProperties": false,
      "required": ["line", "creator", "followers", "revenue", "videoCount"],
      "properties": {
        "line": { "$ref": "#/$defs/nonEmptyText" },
        "creator": { "$ref": "#/$defs/nullableText" },
        "followers": { "$ref": "#/$defs/nullableDecimal" },
        "revenue": { "$ref": "#/$defs/nullableDecimal" },
        "videoCount": { "$ref": "#/$defs/nullableDecimal" }
      }
    },
    "table": {
      "title": "KalodataVideoTable",
      "description": "Validated cited video and creator rows. A null value means the export cell was missing and renders as the missing display text, never as zero. Derived values are never computed over a zero denominator.",
      "type": "object", "additionalProperties": false,
      "required": ["contractVersion", "exportSha256", "exportKind", "tables", "missingDisplay", "videos", "creators"],
      "properties": {
        "contractVersion": { "const": "video-intake-table-v1" },
        "exportSha256": { "$ref": "#/$defs/digest" },
        "exportKind": { "enum": ["csv", "xlsx"] },
        "tables": {
          "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true,
          "items": { "enum": ["video", "creator"] }
        },
        "missingDisplay": { "$ref": "#/$defs/missingDisplay" },
        "videos": { "type": "array", "maxItems": 5000, "items": { "$ref": "#/$defs/videoRow" } },
        "creators": { "type": "array", "maxItems": 5000, "items": { "$ref": "#/$defs/creatorRow" } }
      }
    },
    "preparedEntry": {
      "title": "KalodataVideoPreparedEntry",
      "type": "object", "additionalProperties": false,
      "required": ["packageId", "videoCount", "creatorCount", "request", "provenance"],
      "properties": {
        "packageId": { "$ref": "#/$defs/uuid" },
        "videoCount": { "type": "integer", "minimum": 0, "maximum": 5000 },
        "creatorCount": { "type": "integer", "minimum": 0, "maximum": 5000 },
        "request": { "$ref": "#/$defs/request" },
        "provenance": { "const": "OPERATOR_SUPPLIED_UNVERIFIED" }
      }
    },
    "preparedList": {
      "title": "KalodataVideoPreparedList",
      "type": "object", "additionalProperties": false,
      "required": ["contractVersion", "workspaceId", "runId", "sources"],
      "properties": {
        "contractVersion": { "const": "automation-video-prepared-list-v1" },
        "workspaceId": { "$ref": "#/$defs/uuid" },
        "runId": { "$ref": "#/$defs/uuid" },
        "sources": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/preparedEntry" } }
      }
    },
    "receiptFile": {
      "title": "KalodataVideoReceiptFile",
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "byteSize", "mediaType"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 200 },
        "sha256": { "$ref": "#/$defs/digest" },
        "byteSize": { "type": "integer", "minimum": 1, "maximum": 8388608 },
        "mediaType": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "receipt": {
      "title": "KalodataVideoPrepareReceipt",
      "description": "Exact package identity for an explicit later report-block selection. Preparation is inert: no transcription, confirmation, calculation or report execution.",
      "type": "object", "additionalProperties": false,
      "required": ["contractVersion", "requestKey", "table", "packageId", "state", "exactRetry", "manifestArtifactSha256", "packageContentSha256", "videoCount", "creatorCount", "files", "sourceLabel", "acquiredAt", "provenance"],
      "properties": {
        "contractVersion": { "const": "automation-video-prepared-v1" },
        "requestKey": { "$ref": "#/$defs/requestKey" },
        "table": { "$ref": "#/$defs/tableSelector" },
        "packageId": { "$ref": "#/$defs/uuid" },
        "state": { "const": "PREPARED_NOT_ADMITTED" },
        "exactRetry": { "type": "boolean" },
        "manifestArtifactSha256": { "$ref": "#/$defs/digest" },
        "packageContentSha256": { "$ref": "#/$defs/digest" },
        "videoCount": { "type": "integer", "minimum": 0, "maximum": 5000 },
        "creatorCount": { "type": "integer", "minimum": 0, "maximum": 5000 },
        "files": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/receiptFile" } },
        "sourceLabel": { "$ref": "#/$defs/sourceLabel" },
        "acquiredAt": { "type": ["string", "null"], "format": "date-time" },
        "provenance": { "const": "OPERATOR_SUPPLIED_UNVERIFIED" }
      }
    }
  }
}
