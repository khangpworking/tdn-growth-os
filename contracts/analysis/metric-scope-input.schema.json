{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdn.local/contracts/analysis/metric-scope-input.schema.json",
  "title": "MetricScopeInput",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contractVersion": {
      "const": "1.0.0"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "platform": {
          "enum": [
            "shopee",
            "tiktok"
          ]
        },
        "selection": {
          "enum": [
            "ON",
            "OFF",
            "UNSPECIFIED"
          ]
        },
        "start": {
          "type": "string",
          "format": "date"
        },
        "end": {
          "type": "string",
          "format": "date"
        },
        "periodBasis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "acquiredAt": {
          "description": "Declared acquisition time, or explicit null when unconfirmed. Never inferred from the reporting period or filesystem timestamp.",
          "type": ["string", "null"],
          "format": "date-time"
        }
      },
      "required": [
        "key",
        "platform",
        "selection",
        "start",
        "end",
        "periodBasis",
        "acquiredAt"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "representationRole": {
            "enum": [
              "primary",
              "structured",
              "derived"
            ]
          },
          "evidenceFamily": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "provenanceBasis": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "sha256",
          "label",
          "representationRole",
          "evidenceFamily",
          "provenanceBasis"
        ]
      }
    },
    "records": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "shopId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "listingId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "source": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "revenue": {
            "$ref": "#/$defs/Observation"
          },
          "units": {
            "$ref": "#/$defs/Observation"
          },
          "label": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/Label"
              }
            ]
          },
          "measurement": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "profileId",
              "scopeKey",
              "platform",
              "selection",
              "start",
              "end",
              "currency"
            ],
            "properties": {
              "profileId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "scopeKey": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "platform": {
                "enum": [
                  "shopee",
                  "tiktok"
                ]
              },
              "selection": {
                "enum": [
                  "ON",
                  "OFF",
                  "UNSPECIFIED"
                ]
              },
              "start": {
                "type": "string",
                "format": "date"
              },
              "end": {
                "type": "string",
                "format": "date"
              },
              "currency": {
                "const": "VND"
              }
            }
          }
        },
        "required": [
          "shopId",
          "listingId",
          "title",
          "category",
          "source",
          "revenue",
          "units",
          "label",
          "measurement"
        ]
      }
    },
    "profileId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "labelCodebookVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "wideUnknownPolicy": {
      "enum": [
        "include",
        "exclude"
      ]
    }
  },
  "required": [
    "contractVersion",
    "scope",
    "sources",
    "records",
    "profileId",
    "labelCodebookVersion",
    "wideUnknownPolicy"
  ],
  "$defs": {
    "EvidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "sourceSha256",
        "locator"
      ]
    },
    "Observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "missing",
            "observed_zero",
            "observed_value"
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,39})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "precision": {
          "enum": [
            "exact",
            "display_rounded",
            "estimated",
            "unknown"
          ]
        },
        "source": {
          "$ref": "#/$defs/EvidenceRef"
        },
        "displayedValue": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        }
      },
      "required": [
        "state",
        "value",
        "precision",
        "source",
        "displayedValue"
      ]
    },
    "Label": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "classification": {
          "enum": [
            "CORE_CANDIDATE",
            "ADJACENT",
            "OUTSIDE",
            "UNKNOWN"
          ]
        },
        "group": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "contentSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "methodVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "source": {
          "$ref": "#/$defs/EvidenceRef"
        },
        "adjudication": {
          "enum": [
            "human",
            "assistant",
            "unknown"
          ]
        }
      },
      "required": [
        "classification",
        "group",
        "contentSha256",
        "methodVersion",
        "source",
        "adjudication"
      ]
    }
  }
}
