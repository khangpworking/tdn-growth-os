{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdn.local/contracts/analysis/m03-verified-metric-set.schema.json",
  "title": "M03VerifiedMetricSet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion", "metricSetSha256", "request", "section", "preparation",
    "readiness", "calculation", "scope", "labelPolicy", "sources", "scopes",
    "comparisons", "limitations"
  ],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "metricSetSha256": { "$ref": "#/$defs/digest" },
    "request": { "$ref": "m03-section-recipe-request.schema.json" },
    "section": {
      "type": "object", "additionalProperties": false,
      "required": ["sectionId", "title", "methodId", "methodVersion", "recipeId", "recipeVersion"],
      "properties": {
        "sectionId": { "const": "M03" },
        "title": { "const": "Quy mô và diễn biến" },
        "methodId": { "const": "metric-scope-packet-totals" },
        "methodVersion": { "const": "1.0.0" },
        "recipeId": { "const": "m03-scope-totals" },
        "recipeVersion": { "const": "1.0.0" }
      }
    },
    "preparation": {
      "type": "object", "additionalProperties": false,
      "required": ["preparationSha256", "normalizedInputArtifactSha256", "normalizedInputValueSha256"],
      "properties": {
        "preparationSha256": { "$ref": "#/$defs/digest" },
        "normalizedInputArtifactSha256": { "$ref": "#/$defs/digest" },
        "normalizedInputValueSha256": { "$ref": "#/$defs/digest" }
      }
    },
    "readiness": {
      "type": "object", "additionalProperties": false,
      "required": ["readinessSha256", "profile", "catalogId", "catalogVersion", "catalogSha256", "state"],
      "properties": {
        "readinessSha256": { "$ref": "#/$defs/digest" },
        "profile": { "const": "metric-preparation-readiness-v1" },
        "catalogId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "catalogVersion": { "type": "string", "minLength": 1, "maxLength": 40 },
        "catalogSha256": { "$ref": "#/$defs/digest" },
        "state": { "const": "READY_TO_CALCULATE" }
      }
    },
    "calculation": {
      "type": "object", "additionalProperties": false,
      "required": ["methodVersion", "rounding", "verification", "inputSha256"],
      "properties": {
        "methodVersion": { "const": "metric-scope-v1" },
        "rounding": { "const": "percent-half-even-2-v1" },
        "verification": { "const": "NORMALIZED_INPUT_ONLY" },
        "inputSha256": { "$ref": "#/$defs/digest" }
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "platform", "selection", "start", "end", "periodBasis", "acquiredAt"],
      "properties": {
        "key": { "type": "string", "minLength": 1, "maxLength": 100 },
        "platform": { "enum": ["shopee", "tiktok"] },
        "selection": { "enum": ["ON", "OFF", "UNSPECIFIED"] },
        "start": { "type": "string", "format": "date" },
        "end": { "type": "string", "format": "date" },
        "periodBasis": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "acquiredAt": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "labelPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["codebookVersion", "wideUnknownPolicy", "unknownRetention"],
      "properties": {
        "codebookVersion": { "type": "string", "minLength": 1, "maxLength": 100 },
        "wideUnknownPolicy": { "const": "exclude" },
        "unknownRetention": { "const": "RETAIN_IN_ALL_EXCLUDE_FROM_WIDE" }
      }
    },
    "sources": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["sha256", "label", "representationRole", "evidenceFamily", "provenanceBasis"],
        "properties": {
          "sha256": { "$ref": "#/$defs/digest" },
          "label": { "type": "string", "minLength": 1, "maxLength": 200 },
          "representationRole": { "enum": ["primary", "structured", "derived"] },
          "evidenceFamily": { "type": "string", "minLength": 1, "maxLength": 200 },
          "provenanceBasis": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "scopes": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": { "$ref": "#/$defs/baseScope" }
    },
    "comparisons": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": { "$ref": "#/$defs/baseComparison" }
    },
    "limitations": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {
        "enum": [
          "NORMALIZED_INPUT_ONLY",
          "MISSING_VALUES_ARE_NOT_ZERO",
          "ALL_WIDE_CORE_OVERLAP_AND_ARE_NOT_ADDITIVE",
          "UNKNOWN_IS_RETAINED_IN_ALL_AND_EXCLUDED_FROM_WIDE",
          "LISTING_IS_NOT_A_UNIQUE_PRODUCT",
          "MEMBERSHIP_DIFFERENCE_IS_NOT_MARKET_GROWTH_OR_CAUSATION"
        ]
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "total": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "observedCount", "missingCount", "nonExactCount", "complete"],
      "properties": {
        "value": { "anyOf": [{ "type": "string", "pattern": "^(0|[1-9][0-9]{0,49})$" }, { "type": "null" }] },
        "observedCount": { "type": "integer", "minimum": 0 },
        "missingCount": { "type": "integer", "minimum": 0 },
        "nonExactCount": { "type": "integer", "minimum": 0 },
        "complete": { "type": "boolean" }
      }
    },
    "baseScope": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "recordIndices", "listingCount", "shopCount", "revenue", "units", "warnings"],
      "properties": {
        "key": { "enum": ["all", "wide", "core"] },
        "recordIndices": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "listingCount": { "type": "integer", "minimum": 0 },
        "shopCount": { "type": "integer", "minimum": 0 },
        "revenue": { "$ref": "#/$defs/total" },
        "units": { "$ref": "#/$defs/total" },
        "warnings": {
          "type": "array",
          "items": { "enum": ["EMPTY_SCOPE", "MISSING_REVENUE", "MISSING_UNITS", "NON_EXACT_REVENUE", "NON_EXACT_UNITS", "ZERO_REVENUE", "LABELS_REQUIRE_ADJUDICATION"] }
        }
      }
    },
    "baseComparison": {
      "type": "object", "additionalProperties": false,
      "required": ["from", "to", "revenueDelta", "unitsDelta", "removedRecordIndices"],
      "properties": {
        "from": { "const": "all" },
        "to": { "enum": ["wide", "core"] },
        "revenueDelta": { "anyOf": [{ "type": "string", "pattern": "^-?(0|[1-9][0-9]*)$" }, { "type": "null" }] },
        "unitsDelta": { "anyOf": [{ "type": "string", "pattern": "^-?(0|[1-9][0-9]*)$" }, { "type": "null" }] },
        "removedRecordIndices": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
      }
    }
  }
}
