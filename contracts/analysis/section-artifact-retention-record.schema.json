{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdn.local/contracts/analysis/section-artifact-retention-record.schema.json",
  "title": "SectionArtifactRetentionRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "sectionArtifactSha256",
    "section",
    "renderer",
    "dependencies",
    "members"
  ],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "sectionArtifactSha256": { "$ref": "#/$defs/digest" },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sectionId", "title"],
      "properties": {
        "sectionId": { "const": "M03" },
        "title": { "const": "Quy mô và diễn biến" }
      }
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rendererProfile"],
      "properties": {
        "rendererProfile": { "const": "m03-section-artifact-html-vi-v1" }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preparationSha256", "metricSetSha256", "chartBundleSha256", "envelopeSha256", "narrativeSha256"],
      "properties": {
        "preparationSha256": { "$ref": "#/$defs/digest" },
        "metricSetSha256": { "$ref": "#/$defs/digest" },
        "chartBundleSha256": { "$ref": "#/$defs/digest" },
        "envelopeSha256": { "$ref": "#/$defs/digest" },
        "narrativeSha256": { "$ref": "#/$defs/digest" }
      }
    },
    "members": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metricSet", "chartBundle", "envelope", "narrative", "receipt", "html"],
      "properties": {
        "metricSet": { "$ref": "#/$defs/member" },
        "chartBundle": { "$ref": "#/$defs/member" },
        "envelope": { "$ref": "#/$defs/member" },
        "narrative": { "$ref": "#/$defs/member" },
        "receipt": { "$ref": "#/$defs/member" },
        "html": { "$ref": "#/$defs/member" }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactSha256", "byteSize"],
      "properties": {
        "artifactSha256": { "$ref": "#/$defs/digest" },
        "byteSize": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
