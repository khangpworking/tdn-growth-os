{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research.local/contracts/analysis/temporal-window-method.schema.json",
  "title": "TemporalWindowMethod",
  "type": "object", "additionalProperties": false,
  "required": ["contractVersion", "methodId", "methodVersion", "inputSha256", "methodOutputId", "input", "series", "operations", "limitations"],
  "properties": {
    "contractVersion": { "const": "1.0.0" }, "methodId": { "const": "source-compatible-temporal-v1" }, "methodVersion": { "const": "1.0.0" },
    "inputSha256": { "$ref": "#/$defs/digest" }, "methodOutputId": { "$ref": "#/$defs/digest" }, "input": { "$ref": "#/$defs/input" },
    "series": {
      "type": "array", "maxItems": 500,
      "items": { "type": "object", "additionalProperties": false, "required": ["seriesKey", "observationPointers"], "properties": { "seriesKey": { "$ref": "#/$defs/digest" }, "observationPointers": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/pointer" } } } }
    },
    "operations": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["operationId", "operation", "status", "reasons", "seriesKey", "exact", "display", "displayPolicy", "operandPointers", "coverage"],
        "properties": {
          "operationId": { "$ref": "#/$defs/text" }, "operation": { "$ref": "#/$defs/operation" }, "status": { "enum": ["AVAILABLE", "UNAVAILABLE"] },
          "reasons": { "type": "array", "maxItems": 30, "uniqueItems": true, "items": { "enum": ["NO_OPERANDS", "SERIES_MISMATCH", "IDENTITY_UNRESOLVED", "VALUE_NOT_EXACT", "METRIC_UNIT_UNKNOWN", "DEFINITION_UNKNOWN", "NOT_PERIOD_FLOW", "ADDITIVITY_NOT_PROVEN", "TIME_BASIS_UNKNOWN", "BOUNDARY_MAPPING_MISSING", "TIME_BASIS_MISMATCH", "MEMBERSHIP_INCOMPLETE", "UPSTREAM_SCALAR_NOT_READY", "DUPLICATE_CAPTURE", "WINDOW_REVISION_UNRESOLVED", "UNSELECTED_WINDOW_REVISION", "WINDOW_OVERLAP", "TARGET_GAP", "TARGET_BOUNDARY_MISMATCH", "NOT_CHRONOLOGICAL", "DURATION_UNKNOWN", "DURATION_MISMATCH", "BASELINE_ZERO"] } },
          "seriesKey": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
          "exact": { "anyOf": [{ "$ref": "#/$defs/rational" }, { "type": "null" }] },
          "display": { "type": ["string", "null"], "maxLength": 180, "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$" },
          "displayPolicy": { "enum": ["EXACT_DECIMAL", "HALF_EVEN_2", "UNKNOWN"] },
          "operandPointers": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/pointer" } },
          "coverage": { "type": "object", "additionalProperties": false, "required": ["requiredObservationIds", "exactObservationIds", "subjectMemberKeys", "frameMemberKeys", "complete", "entireFrameComplete"], "properties": { "requiredObservationIds": { "$ref": "#/$defs/keys" }, "exactObservationIds": { "$ref": "#/$defs/keys" }, "subjectMemberKeys": { "$ref": "#/$defs/keys" }, "frameMemberKeys": { "$ref": "#/$defs/keys" }, "complete": { "type": "boolean" }, "entireFrameComplete": { "type": "boolean" } } }
        }
      }
    },
    "limitations": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/text" } }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nullableDigest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
    "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "nullableText": { "anyOf": [{ "$ref": "#/$defs/text" }, { "type": "null" }] },
    "pointer": { "type": "string", "maxLength": 2000, "pattern": "^(?:/(?:[^~/]|~[01])*)+$" },
    "keys": { "type": "array", "maxItems": 500, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
    "decimal": { "type": "string", "maxLength": 80, "pattern": "^(0|[1-9][0-9]{0,39})(\\.[0-9]{1,18})?$" },
    "rational": { "type": "object", "additionalProperties": false, "required": ["numerator", "denominator"], "properties": { "numerator": { "type": "string", "pattern": "^-?(0|[1-9][0-9]{0,159})$" }, "denominator": { "type": "string", "pattern": "^[1-9][0-9]{0,159}$" } } },
    "ref": { "type": "object", "additionalProperties": false, "required": ["sourceSha256", "locator", "fieldPointer"], "properties": { "sourceSha256": { "$ref": "#/$defs/digest" }, "locator": { "$ref": "#/$defs/text" }, "fieldPointer": { "$ref": "#/$defs/pointer" } } },
    "nullableRef": { "anyOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] },
    "interval": { "type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": { "start": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?(Z|[+-][0-9]{2}:[0-9]{2})$" }, "end": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?(Z|[+-][0-9]{2}:[0-9]{2})$" } } },
    "nullableInterval": { "anyOf": [{ "$ref": "#/$defs/interval" }, { "type": "null" }] },
    "operation": { "enum": ["SUM_DISJOINT_WINDOWS", "ABSOLUTE_CHANGE", "RELATIVE_CHANGE"] },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["contractVersion", "sourcePackage", "sources", "configuration", "frame", "observations", "requests", "snapshotDispositions"],
      "properties": {
        "contractVersion": { "const": "1.0.0" },
        "sourcePackage": { "type": "object", "additionalProperties": false, "required": ["packageId", "version", "manifestArtifactSha256", "packageContentSha256"], "properties": { "packageId": { "type": "string", "format": "uuid" }, "version": { "type": "integer", "minimum": 1 }, "manifestArtifactSha256": { "$ref": "#/$defs/digest" }, "packageContentSha256": { "$ref": "#/$defs/digest" } } },
        "sources": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "type": "object", "additionalProperties": false, "required": ["logicalPath", "sha256", "role"], "properties": { "logicalPath": { "$ref": "#/$defs/text" }, "sha256": { "$ref": "#/$defs/digest" }, "role": { "enum": ["SOURCE", "OWNER_DECLARATION", "UPSTREAM_RESULT"] } } } },
        "configuration": { "type": "object", "additionalProperties": false, "required": ["profileId", "profileVersion", "profileSha256", "profileRef", "mappingRevision", "compatibilityPolicyRevision", "configurationRef"], "properties": { "profileId": { "const": "source-compatible-temporal-v1" }, "profileVersion": { "const": "1.0.0" }, "profileSha256": { "$ref": "#/$defs/digest" }, "profileRef": { "$ref": "#/$defs/ref" }, "mappingRevision": { "$ref": "#/$defs/text" }, "compatibilityPolicyRevision": { "const": "fixed-frame-equal-declared-duration-v1" }, "configurationRef": { "$ref": "#/$defs/ref" } } },
        "frame": {
          "type": "object", "additionalProperties": false, "required": ["frameId", "revision", "universePurpose", "scopeRuleRevision", "labelsRevision", "selectionRef", "scopeRef", "members", "externalCoverage"],
          "properties": {
            "frameId": { "$ref": "#/$defs/text" }, "revision": { "$ref": "#/$defs/text" }, "universePurpose": { "$ref": "#/$defs/text" }, "scopeRuleRevision": { "$ref": "#/$defs/text" }, "labelsRevision": { "$ref": "#/$defs/text" }, "selectionRef": { "$ref": "#/$defs/ref" }, "scopeRef": { "$ref": "#/$defs/ref" }, "externalCoverage": { "const": "UNKNOWN_NOT_MARKET_POPULATION" },
            "members": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "type": "object", "additionalProperties": false, "required": ["memberKey", "identityState", "provider", "country", "platform", "shopId", "listingId", "variantScope", "variantId", "source"], "properties": { "memberKey": { "$ref": "#/$defs/text" }, "identityState": { "enum": ["EXACT", "UNKNOWN", "CONFLICTING"] }, "provider": { "$ref": "#/$defs/nullableText" }, "country": { "$ref": "#/$defs/nullableText" }, "platform": { "$ref": "#/$defs/nullableText" }, "shopId": { "$ref": "#/$defs/nullableText" }, "listingId": { "$ref": "#/$defs/nullableText" }, "variantScope": { "enum": ["EXACT_VARIANT", "LISTING_AGGREGATE", "UNKNOWN"] }, "variantId": { "$ref": "#/$defs/nullableText" }, "source": { "$ref": "#/$defs/ref" } } } }
          }
        },
        "observations": {
          "type": "array", "maxItems": 500,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["observationId", "source", "sourceNamespace", "rawRequestSha256", "rawResponseSha256", "retrievedAt", "subjectMemberKeys", "measure", "value", "requestedWindow", "rawQuery", "observedWindow", "membership", "upstream"],
            "properties": {
              "observationId": { "$ref": "#/$defs/text" }, "source": { "$ref": "#/$defs/ref" }, "sourceNamespace": { "$ref": "#/$defs/text" }, "rawRequestSha256": { "$ref": "#/$defs/nullableDigest" }, "rawResponseSha256": { "$ref": "#/$defs/digest" }, "retrievedAt": { "type": "string", "format": "date-time" }, "subjectMemberKeys": { "$ref": "#/$defs/keys" },
              "measure": { "type": "object", "additionalProperties": false, "required": ["literal", "canonicalMapping", "definition", "definitionRevision", "definitionRef", "dimension", "unit", "currency", "semantics", "semanticsRef", "additive", "additivityRef", "displayPolicy", "displayPolicyRef"], "properties": { "literal": { "$ref": "#/$defs/text" }, "canonicalMapping": { "$ref": "#/$defs/text" }, "definition": { "$ref": "#/$defs/nullableText" }, "definitionRevision": { "$ref": "#/$defs/nullableText" }, "definitionRef": { "$ref": "#/$defs/nullableRef" }, "dimension": { "enum": ["CURRENCY", "COUNT", "OTHER", "UNKNOWN"] }, "unit": { "$ref": "#/$defs/nullableText" }, "currency": { "$ref": "#/$defs/nullableText" }, "semantics": { "enum": ["PERIOD_FLOW", "ROLLING", "CUMULATIVE", "STOCK", "UNKNOWN"] }, "semanticsRef": { "$ref": "#/$defs/nullableRef" }, "additive": { "type": ["boolean", "null"] }, "additivityRef": { "$ref": "#/$defs/nullableRef" }, "displayPolicy": { "enum": ["EXACT_DECIMAL", "HALF_EVEN_2", "UNKNOWN"] }, "displayPolicyRef": { "$ref": "#/$defs/nullableRef" } } },
              "value": { "type": "object", "additionalProperties": false, "required": ["state", "decimal", "literal"], "properties": { "state": { "enum": ["EXACT", "OBSERVED_ZERO", "MISSING", "NON_EXACT", "UNREADABLE", "CONFLICTING", "UNKNOWN"] }, "decimal": { "anyOf": [{ "$ref": "#/$defs/decimal" }, { "type": "null" }] }, "literal": { "$ref": "#/$defs/nullableText" } } },
              "requestedWindow": { "$ref": "#/$defs/rawWindow" }, "rawQuery": { "$ref": "#/$defs/rawWindow" },
              "observedWindow": {
                "type": "object", "additionalProperties": false,
                "required": ["rawStart", "rawEnd", "interval", "basisKind", "basisLiteral", "basisRef", "boundaryConvention", "boundaryRef", "mappingRef", "duration"],
                "properties": {
                  "rawStart": { "$ref": "#/$defs/nullableText" }, "rawEnd": { "$ref": "#/$defs/nullableText" }, "interval": { "$ref": "#/$defs/nullableInterval" },
                  "basisKind": { "enum": ["TIMEZONE", "SOURCE_CALENDAR", "UNKNOWN"] }, "basisLiteral": { "$ref": "#/$defs/nullableText" }, "basisRef": { "$ref": "#/$defs/nullableRef" },
                  "boundaryConvention": { "enum": ["HALF_OPEN", "INCLUSIVE_BOTH", "START_EXCLUSIVE_END_INCLUSIVE", "UNKNOWN"] }, "boundaryRef": { "$ref": "#/$defs/nullableRef" }, "mappingRef": { "$ref": "#/$defs/nullableRef" },
                  "duration": { "type": "object", "additionalProperties": false, "required": ["basis", "value", "unit", "proof"], "properties": { "basis": { "enum": ["ELAPSED_MILLISECONDS", "SOURCE_CALENDAR_UNITS", "UNKNOWN"] }, "value": { "type": ["string", "null"], "pattern": "^[1-9][0-9]{0,17}$" }, "unit": { "$ref": "#/$defs/nullableText" }, "proof": { "$ref": "#/$defs/nullableRef" } } }
                }
              },
              "membership": { "type": "object", "additionalProperties": false, "required": ["observedMemberKeys", "unknownMemberKeys", "excludedMemberKeys", "complete", "proof"], "properties": { "observedMemberKeys": { "$ref": "#/$defs/keys" }, "unknownMemberKeys": { "$ref": "#/$defs/keys" }, "excludedMemberKeys": { "$ref": "#/$defs/keys" }, "complete": { "type": "boolean" }, "proof": { "$ref": "#/$defs/nullableRef" } } },
              "upstream": { "type": "object", "additionalProperties": false, "required": ["kind", "ready", "complete", "entityOverlapResolved", "proof"], "properties": { "kind": { "enum": ["DIRECT_SOURCE_SCALAR", "METHOD_RESULT", "UNKNOWN"] }, "ready": { "type": "boolean" }, "complete": { "type": "boolean" }, "entityOverlapResolved": { "type": "boolean" }, "proof": { "$ref": "#/$defs/nullableRef" } } }
            }
          }
        },
        "requests": { "type": "array", "maxItems": 100, "items": { "type": "object", "additionalProperties": false, "required": ["operationId", "operation", "observationIds", "targetInterval", "baselineId", "comparisonId"], "properties": { "operationId": { "$ref": "#/$defs/text" }, "operation": { "$ref": "#/$defs/operation" }, "observationIds": { "$ref": "#/$defs/keys" }, "targetInterval": { "$ref": "#/$defs/nullableInterval" }, "baselineId": { "$ref": "#/$defs/nullableText" }, "comparisonId": { "$ref": "#/$defs/nullableText" } } } },
        "snapshotDispositions": { "type": "array", "maxItems": 500, "items": { "type": "object", "additionalProperties": false, "required": ["selectedObservationId", "rejectedObservationIds", "binding"], "properties": { "selectedObservationId": { "$ref": "#/$defs/text" }, "rejectedObservationIds": { "$ref": "#/$defs/keys" }, "binding": { "$ref": "#/$defs/ref" } } } }
      }
    },
    "rawWindow": { "type": "object", "additionalProperties": false, "required": ["start", "end", "binding"], "properties": { "start": { "$ref": "#/$defs/nullableText" }, "end": { "$ref": "#/$defs/nullableText" }, "binding": { "$ref": "#/$defs/nullableRef" } } }
  }
}
