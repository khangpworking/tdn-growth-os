{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdn.local/contracts/analysis/automation-insight-report-revision.schema.json",
  "title": "AutomationInsightReportRevisionRequest",
  "description": "Owner report-revision request carrying either accepted coding receipts (v1) or one versioned receipt-free draft selection. Exactly one variant validates; historical v1 payloads match only the accepted branch.",
  "oneOf": [
    {
      "$ref": "#/$defs/acceptedRequest"
    },
    {
      "$ref": "#/$defs/draftRequest"
    },
    {
      "$ref": "#/$defs/literalRequest"
    },
    {
      "$ref": "#/$defs/defaultRequest"
    }
  ],
  "$defs": {
    "selection": {
      "title": "InsightReportSelection",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposalId",
        "receiptIds"
      ],
      "properties": {
        "proposalId": {
          "type": "string",
          "format": "uuid"
        },
        "receiptIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    },
    "draftSelection": {
      "title": "InsightDraftSelection",
      "oneOf": [
        {
          "$ref": "#/$defs/draftSelectionV1"
        },
        {
          "$ref": "#/$defs/draftSelectionV2"
        }
      ]
    },
    "requestSources": {
      "title": "InsightRevisionSources",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "nativeReview"
      ],
      "properties": {
        "metric": {
          "$ref": "automation-classified-report-revision.schema.json#/$defs/keep"
        },
        "nativeReview": {
          "$ref": "automation-classified-report-revision.schema.json#/$defs/keep"
        }
      }
    },
    "acceptedRequest": {
      "title": "AutomationInsightAcceptedReportRevisionRequest",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "requestKey",
        "previousPairId",
        "sources",
        "acceptedInsight"
      ],
      "properties": {
        "contractVersion": {
          "const": "automation-insight-report-revision-v1"
        },
        "requestKey": {
          "type": "string",
          "format": "uuid"
        },
        "previousPairId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sources": {
          "$ref": "#/$defs/requestSources"
        },
        "acceptedInsight": {
          "$ref": "#/$defs/selection"
        }
      }
    },
    "draftRequest": {
      "title": "AutomationInsightDraftReportRevisionRequest",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "requestKey",
        "previousPairId",
        "sources",
        "draftInsight"
      ],
      "properties": {
        "contractVersion": {
          "const": "automation-insight-report-revision-v1"
        },
        "requestKey": {
          "type": "string",
          "format": "uuid"
        },
        "previousPairId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sources": {
          "$ref": "#/$defs/requestSources"
        },
        "draftInsight": {
          "$ref": "#/$defs/draftSelection"
        }
      }
    },
    "draftSelectionV1": {
      "title": "InsightDraftSelectionV1",
      "description": "Versioned receipt-free draft selection of one exact retained proposal. Zero receipts by construction; never an implicit latest, never approval.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "proposalId"
      ],
      "properties": {
        "contractVersion": {
          "const": "insight-draft-select-v1"
        },
        "proposalId": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "draftSelectionV2": {
      "title": "InsightDraftSelectionV2",
      "description": "Versioned receipt-free draft selection of one exact retained proposal. Zero receipts by construction; never an implicit latest, never approval.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "proposalId"
      ],
      "properties": {
        "contractVersion": {
          "const": "insight-draft-select-v2"
        },
        "proposalId": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "literalSelection": {
      "title": "InsightLiteralSelection",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion"
      ],
      "properties": {
        "contractVersion": {
          "const": "insight-literal-select-v1"
        }
      }
    },
    "literalRequest": {
      "title": "AutomationInsightLiteralReportRevisionRequest",
      "description": "Explicit source-only literal projection from the exact previous pair. Does not create coding adoption or bypass existing inherited coding lineage.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "requestKey",
        "previousPairId",
        "sources",
        "literalInsight"
      ],
      "properties": {
        "contractVersion": {
          "const": "automation-insight-literal-report-revision-v1"
        },
        "requestKey": {
          "type": "string",
          "format": "uuid"
        },
        "previousPairId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sources": {
          "$ref": "#/$defs/requestSources"
        },
        "literalInsight": {
          "$ref": "#/$defs/literalSelection"
        }
      }
    },
    "defaultSelection": {
      "title": "InsightDefaultDraftSelection",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "proposalId",
        "proposalSha256"
      ],
      "properties": {
        "contractVersion": {
          "const": "insight-default-draft-select-v1"
        },
        "proposalId": {
          "$ref": "automation-insight-coding.schema.json#/$defs/uuid"
        },
        "proposalSha256": {
          "$ref": "automation-insight-coding.schema.json#/$defs/digest"
        }
      }
    },
    "defaultRequest": {
      "title": "AutomationInsightDefaultReportRevisionRequest",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "requestKey",
        "previousPairId",
        "sources",
        "defaultInsight"
      ],
      "properties": {
        "contractVersion": {
          "const": "automation-insight-default-report-revision-v1"
        },
        "requestKey": {
          "$ref": "automation-insight-coding.schema.json#/$defs/uuid"
        },
        "previousPairId": {
          "$ref": "automation-insight-coding.schema.json#/$defs/digest"
        },
        "sources": {
          "$ref": "#/$defs/requestSources"
        },
        "defaultInsight": {
          "$ref": "#/$defs/defaultSelection"
        }
      }
    }
  }
}
