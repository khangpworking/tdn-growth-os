{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdn.local/contracts/analysis/automation-insight-report-revision.schema.json",
  "title": "AutomationInsightReportRevisionRequest",
  "type": "object", "additionalProperties": false,
  "required": ["contractVersion", "requestKey", "previousPairId", "sources", "acceptedInsight"],
  "properties": {
    "contractVersion": { "const": "automation-insight-report-revision-v1" },
    "requestKey": { "type": "string", "format": "uuid" },
    "previousPairId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sources": {
      "type": "object", "additionalProperties": false, "required": ["metric", "nativeReview"],
      "properties": {
        "metric": { "$ref": "automation-classified-report-revision.schema.json#/$defs/keep" },
        "nativeReview": { "$ref": "automation-classified-report-revision.schema.json#/$defs/keep" }
      }
    },
    "acceptedInsight": { "$ref": "#/$defs/selection" }
  },
  "$defs": {
    "selection": {
      "title": "InsightReportSelection", "type": "object", "additionalProperties": false,
      "required": ["proposalId", "receiptIds"],
      "properties": {
        "proposalId": { "type": "string", "format": "uuid" },
        "receiptIds": { "type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": { "type": "string", "format": "uuid" } }
      }
    }
  }
}
