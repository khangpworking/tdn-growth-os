        },
        "ordering": {
          "const": "CATALOG_SECTION_ORDER_M05_I02_I04_UNRANKED"
        },
        "status": {
          "enum": [
            "UNRANKED_EVIDENCE_INVENTORY",
            "INSUFFICIENT_EVIDENCE"
          ]
        },
        "insufficientEvidence": {
          "anyOf": [
            {
              "const": "NO_ELIGIBLE_UPSTREAM_CLAIMS"
            },
            {
              "type": "null"
            }
          ]
        },
        "items": {
          "$ref": "#/$defs/packetItems"
        },
        "evidenceGaps": {
          "$ref": "#/$defs/evidenceGaps"
        },
        "candidateEligibility": {
          "$ref": "#/$defs/candidateEligibility"
        },
        "opportunity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ownerHypotheses",
            "opportunityDefinition",
            "size",
            "weights",
            "risk",
            "expectedReturn",
            "priority"
          ],
          "properties": {
            "ownerHypotheses": {
              "$ref": "#/$defs/emptyOwnerList"
            },
            "opportunityDefinition": {
              "$ref": "#/$defs/unset"
            },
            "size": {
              "$ref": "#/$defs/unset"
            },
            "weights": {
              "$ref": "#/$defs/unset"
            },
            "risk": {
              "$ref": "#/$defs/unset"
            },
            "expectedReturn": {
              "$ref": "#/$defs/unset"
            },
            "priority": {
              "type": "null"
