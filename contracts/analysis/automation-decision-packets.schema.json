{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdn.local/contracts/analysis/automation-decision-packets.schema.json",
  "title": "AutomationDecisionPackets",
  "description": "Source-neutral M11/I15/M12 deterministic packets and their separate optional retained AI candidate envelopes. Structural and reference validation does not verify semantic truth or authenticate raw sources.",
  "oneOf": [
    {
      "$ref": "#/$defs/packet"
    },
    {
      "$ref": "#/$defs/candidates"
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "\\S"
    },
    "aiText": {
      "description": "Untrusted layer-3 draft text. It must contain a non-space character and no Unicode number character; numeric facts stay application-owned claim bindings.",
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "^\\P{N}*[^\\s\\p{N}]\\P{N}*$"
    },
    "unset": {
      "description": "An owner input that was not supplied. This version admits no owner-authored value; AI output cannot complete it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "text"
      ],
      "properties": {
        "state": {
          "const": "UNSET"
        },
        "text": {
          "type": "null"
        }
      }
    },
    "emptyOwnerList": {
      "description": "Owner-authored entries. Always empty in this version; AI candidates never populate it.",
      "type": "array",
      "maxItems": 0,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "sourceClaimsBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "methodId",
        "methodVersion",
        "claimsSha256"
      ],
      "properties": {
        "methodId": {
          "const": "automation-source-claims"
        },
        "methodVersion": {
          "const": "1.0.0"
        },
        "claimsSha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "admissionBinding": {
      "description": "The exact I14 use-context admission rebuilt from the same claims. It is the CURRENT support adapter: its I02 anchors are the only claims this version lets a candidate cite as support. That is a temporary adapter coverage limit, not the business eligibility rule.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "methodId",
        "methodVersion",
        "admissionSha256"
      ],
      "properties": {
        "methodId": {
          "const": "automation-i14-evidence-admission"
        },
        "methodVersion": {
          "enum": [
            "1.0.0",
            "1.1.0"
          ]
        },
        "admissionSha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "synthesisProfileSha256",
        "adoptionSha256",
        "policyRevision"
      ],
      "properties": {
        "synthesisProfileSha256": {
          "const": "5fd879f42d6c9c82cbc87710b69206aaac2fc8d6bac2da18ba158825f910225a"
        },
        "adoptionSha256": {
          "const": "5c5d1ea4d6d8b8aebfbdc3d92cb51718351890184cc290aac82411722636b7e7"
        },
        "policyRevision": {
          "const": "a41-source-neutral-decision-packets-v1"
        }
      }
    },
    "ownerQuestion": {
      "$ref": "#/$defs/unset"
    },
    "packetItem": {
      "title": "DecisionPacketItem",
      "description": "A reference to one verified upstream claim; never a new fact. Statements, spans, values and bindings stay in the referenced claims artifact.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimId",
        "sectionId",
        "basis",
        "evidenceKind",
        "currentAdapterSupport",
        "currentAdapterReason",
        "encodedCounterevidenceSpans",
        "encodedQualifierSpans"
      ],
      "properties": {
        "claimId": {
          "$ref": "#/$defs/digest"
        },
        "sectionId": {
          "enum": [
            "M05",
            "I02",
            "I04"
          ]
        },
        "basis": {
          "enum": [
            "SOURCE_OBSERVED",
            "DECLARED"
          ]
        },
        "evidenceKind": {
          "enum": [
            "SOURCE_OBSERVATION",
            "SELF_REPORTED_DECLARATION"
          ]
        },
        "currentAdapterSupport": {
          "description": "Whether the CURRENT I14 adapter admits the claim as candidate support. NOT_ADMITTED_BY_CURRENT_ADAPTER is adapter coverage, not a business finding that the claim cannot support a candidate.",
          "enum": [
            "USE_CONTEXT_ANCHOR",
            "NOT_ADMITTED_BY_CURRENT_ADAPTER",
            "OBSERVED_LITERAL",
            "BEHAVIOR_WITH_USE_CONTEXT"
          ]
        },
        "currentAdapterReason": {
          "description": "The exact I14 unassigned reason, or null for an anchor. M05 and I04 reasons record what the current adapter does not encode.",
          "anyOf": [
            {
              "enum": [
                "NOT_A_LOCATED_DECLARATION",
                "I04_BEHAVIOR_ALONE_IS_NOT_USE_CONTEXT",
                "NO_SOURCE_STATED_USE_CONTEXT_FIELD",
                "CONTEXT_FIELD_CONFLICTING",
                "CONTEXT_QUALIFIER_SEMANTICS_NOT_ENCODED",
                "OBSERVATION_IDENTIFICATION_INCOMPLETE",
                "BEHAVIOR_CONTEXT_NOT_ADMITTED"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "encodedCounterevidenceSpans": {
          "description": "Count of COUNTEREVIDENCE spans encoded on the claim. Zero means none encoded, not that none exists.",
          "type": "integer",
          "minimum": 0
        },
        "encodedQualifierSpans": {
          "type": "integer",
          "minimum": 0
        },
        "contextClaimRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    },
    "packetItems": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "$ref": "#/$defs/packetItem"
      }
    },
    "evidenceGaps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "enum": [
          "WORKING_QUESTION_AI_PROPOSED_AWAITING_OWNER",
          "OWNER_QUESTION_UNSET",
          "NO_ELIGIBLE_UPSTREAM_CLAIMS",
          "NO_SOURCE_OBSERVATION_CLAIMS",
          "NO_LOCATED_DECLARATION_CLAIMS",
          "NO_ADMISSIBLE_SOURCE_STATED_USE_CONTEXT",
          "CROSS_CLAIM_COUNTEREVIDENCE_NOT_ASSIGNED_WITHOUT_OWNER_HYPOTHESIS",
          "UPSTREAM_CLAIM_ADAPTERS_LIMITED_TO_M05_I02_I04",
          "SUPPORT_ADAPTER_COVERS_ONLY_I02_SOURCE_STATED_USE_CONTEXT",
          "NO_ADMISSIBLE_DECISION_SUPPORT",
          "SUPPORT_ADAPTER_ADMITS_LITERAL_OBSERVATIONS_AND_CONTAINED_BEHAVIOR_NOT_VERIFIED_PATTERNS"
        ]
      }
    },
    "candidateEligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "status",
        "insufficientEvidence"
      ],
      "properties": {
        "rule": {
          "enum": [
            "CURRENT_ADAPTER_I14_SOURCE_STATED_USE_CONTEXT_ANCHORS_V1",
            "LITERAL_OBSERVATION_AND_SOURCE_CONTEXT_DRAFT_SUPPORT_V2"
          ]
        },
        "status": {
          "enum": [
            "SUPPORT_ANCHORS_AVAILABLE",
            "INSUFFICIENT_EVIDENCE"
          ]
        },
        "insufficientEvidence": {
          "anyOf": [
            {
              "enum": [
                "NO_ADMISSIBLE_SOURCE_STATED_USE_CONTEXT",
                "NO_ADMISSIBLE_DECISION_SUPPORT"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
