    "packet": {
      "title": "AutomationDecisionPacket",
      "oneOf": [
        {
          "$ref": "#/$defs/m11Packet"
        },
        {
          "$ref": "#/$defs/i15Packet"
        },
        {
          "$ref": "#/$defs/m12Packet"
        }
      ]
    },
    "supportRefs": {
      "description": "Exact upstream claim ids that the CURRENT adapter admits as use-context anchors of the bound packet. Candidate ids or indexes are not evidence.",
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/digest"
      }
    },
    "counterevidenceRefs": {
      "description": "Exact upstream claim ids of the bound packet proposed as counterevidence. Each needs exactly one counterevidenceRelations entry. Empty means none was supplied, not that no counterevidence exists.",
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/digest"
      }
    },
    "requiredAiTexts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/aiText"
      }
    },
    "optionalAiTexts": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/aiText"
      }
    },
    "counterevidenceRelation": {
      "title": "DecisionCounterevidenceRelation",
      "description": "A PROPOSED layer-3 draft saying how one referenced upstream claim may counter this candidate. It is not a verified counterclaim, a new source claim or owner input. Only the claim reference and the exact target binding are machine-checked. Whether the claim counters the target, and every compatibility statement, are unverified human-review drafts, not machine proof.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimRef",
        "relationType",
        "relationStatus",
        "layer",
        "counteredTarget",
        "compatibility",
        "inferentialLimitations"
      ],
      "properties": {
        "claimRef": {
          "description": "Exactly one entry of this candidate's counterevidenceRefs, unchanged.",
          "$ref": "#/$defs/digest"
        },
        "relationType": {
          "const": "PROPOSED_COUNTEREVIDENCE"
        },
        "relationStatus": {
          "const": "HUMAN_REVIEW_REQUIRED"
        },
        "layer": {
          "const": 3
        },
        "counteredTarget": {
