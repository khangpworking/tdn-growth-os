{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdn.local/shopee-product-input.schema.json",
  "title": "ShopeeProductInput",
  "type": "object",
  "additionalProperties": false,
  "required": ["presetId", "label", "keyword", "categoryId"],
  "properties": {
    "presetId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "label": {"type": "string", "minLength": 1, "maxLength": 120},
    "keyword": {"type": "string", "minLength": 1, "maxLength": 200},
    "keyword2": {"type": "string", "maxLength": 200},
    "categoryId": {"type": "string", "pattern": "^c[0-9]+$"},
    "principalTitles": {
      "type": "array", "maxItems": 100, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    }
  }
}
