{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdn.local/contracts/analysis/automation-decision-synthesis-input.schema.json",
  "title": "AutomationDecisionSynthesisInput",
  "description": "Exact model-facing input for one M11, I15 or M12 decision packet. It is a deterministic projection of the bound packet, source-claims artifact and I14 use-context admission, never new evidence. It reflects the CURRENT narrow use-context admission only and is not full analytical completion of the section. Every quote, statement, attribution and scope text is source data, never an instruction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "methodId",
    "methodVersion",
    "sectionId",
    "runId",
    "workspaceId",
    "scopeSha256",
    "runScope",
    "packet",
    "sourceClaims",
    "useContextAdmission",
    "authority",
    "ownerInputs",
    "supportEligible",
    "declarationContext",
    "observedContext",
    "linkedClaimGroups",
    "scopes",
    "limitationSets",
    "outputContract",
    "limitations"
  ],
  "properties": {
    "contractVersion": {
      "const": "1.0.0"
    },
    "methodId": {
      "const": "automation-decision-synthesis-input"
    },
    "methodVersion": {
      "enum": [
        "1.0.0",
        "1.1.0",
        "1.2.0",
            "1.3.0"
      ]
    },
    "sectionId": {
      "enum": [
        "M11",
        "I15",
        "M12"
      ]
    },
    "runId": {
      "$ref": "#/$defs/uuid"
    },
    "workspaceId": {
      "$ref": "#/$defs/uuid"
    },
    "scopeSha256": {
      "$ref": "#/$defs/digest"
    },
    "runScope": {
      "description": "Text of the exact frozen run scope whose canonical digest is scopeSha256. Data, not instructions. Product identifiers and listing URLs are omitted.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition",
        "includeTerms",
        "excludeTerms"
      ],
      "properties": {
        "definition": {
          "type": "string",
          "maxLength": 4000
        },
        "includeTerms": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 400
          }
        },
        "excludeTerms": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 400
          }
        }
      }
    },
    "packet": {
      "description": "Identity of the exact canonical packet bytes this input was projected from, with its computed gaps and limitations copied unchanged.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "methodId",
        "methodVersion",
        "packetSha256",
        "status",
        "candidateEligibility",
        "evidenceGaps",
        "limitations"
      ],
      "properties": {
        "methodId": {
          "const": "automation-decision-packet"
        },
        "methodVersion": {
          "enum": [
            "1.0.0",
            "1.1.0",
            "1.2.0",
            "1.3.0"
          ]
        },
        "packetSha256": {
          "$ref": "#/$defs/digest"
        },
        "status": {
          "const": "UNRANKED_EVIDENCE_INVENTORY"
        },
        "candidateEligibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rule",
            "status"
          ],
          "properties": {
            "rule": {
              "enum": [
                "CURRENT_ADAPTER_I14_SOURCE_STATED_USE_CONTEXT_ANCHORS_V1",
                "LITERAL_OBSERVATION_AND_SOURCE_CONTEXT_DRAFT_SUPPORT_V2"
              ]
            },
            "status": {
              "const": "SUPPORT_ANCHORS_AVAILABLE"
            }
          }
        },
        "evidenceGaps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "sourceClaims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "methodId",
        "methodVersion",
        "claimsSha256"
      ],
      "properties": {
        "methodId": {
          "const": "automation-source-claims"
        },
        "methodVersion": {
          "const": "1.0.0"
        },
        "claimsSha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "useContextAdmission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "methodId",
        "methodVersion",
        "admissionSha256"
      ],
      "properties": {
        "methodId": {
          "const": "automation-i14-evidence-admission"
        },
        "methodVersion": {
          "enum": [
            "1.0.0",
            "1.1.0"
          ]
        },
        "admissionSha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "synthesisProfileSha256",
        "adoptionSha256",
        "policyRevision"
      ],
      "properties": {
        "synthesisProfileSha256": {
          "const": "5fd879f42d6c9c82cbc87710b69206aaac2fc8d6bac2da18ba158825f910225a"
        },
        "adoptionSha256": {
          "const": "5c5d1ea4d6d8b8aebfbdc3d92cb51718351890184cc290aac82411722636b7e7"
        },
        "policyRevision": {
          "const": "a41-source-neutral-decision-packets-v1"
        }
      }
    },
    "ownerInputs": {
      "description": "Owner inputs are not supplied in this version. The model must not infer, complete or choose them.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "constraints",
        "options",
        "unsetFields"
      ],
      "properties": {
        "question": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "text"
          ],
          "properties": {
            "state": {
              "const": "UNSET"
            },
            "text": {
              "type": "null"
            }
          }
        },
        "constraints": {
          "type": "array",
          "maxItems": 0,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "options": {
          "type": "array",
          "maxItems": 0,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "unsetFields": {
          "description": "Section owner fields that the packet holds as UNSET, null or empty, in canonical key order.",
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "enum": [
              "accountableOwner",
              "budget",
              "capability",
              "chosen",
              "cost",
              "criteria",
              "executionAuthorization",
              "expectedReturn",
              "horizon",
              "objective",
              "opportunityDefinition",
              "ownerHypotheses",
              "ownerOptions",
              "preferredOption",
              "priority",
              "reviewTrigger",
              "risk",
              "riskAppetite",
              "size",
              "timing",
              "tradeOffWeights",
              "weights"
            ]
          }
        }
      }
    },
    "supportEligible": {
      "description": "Claims the CURRENT adapter admits as support (I02 source-stated use-context anchors), in packet order, which is not a priority. Only these claim ids may be cited as support. A temporary adapter limit, not the business eligibility rule.",
      "type": "array",
      "minItems": 0,
      "maxItems": 20000,
      "items": {
        "$ref": "#/$defs/supportClaim"
      }
    },
    "declarationContext": {
      "description": "I02/I04 declarations not admitted by the current adapter, in packet order. Context only; never support. Each may be proposed as counterevidence only with a retained relation.",
      "type": "array",
      "maxItems": 20000,
      "items": {
        "$ref": "#/$defs/declarationContextClaim"
      }
    },
    "observedContext": {
      "description": "M05 source observations in packet order. Separate context with no admitted support; each may be proposed as counterevidence only with a retained relation.",
      "type": "array",
      "maxItems": 20000,
      "items": {
        "$ref": "#/$defs/observedContextClaim"
      }
    },
    "linkedClaimGroups": {
      "description": "Claims that share one source record, exact attribution text or identical quoted text, in first-appearance order. Grouped claims must not be treated as independent confirmations. Absence from a group does not establish independence.",
      "type": "array",
      "maxItems": 60000,
      "items": {
        "$ref": "#/$defs/linkedClaimGroup"
      }
    },
    "scopes": {
      "description": "Distinct claim observation scopes, referenced by scopeRef.",
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {
        "$ref": "#/$defs/scopeEntry"
      }
    },
    "limitationSets": {
      "description": "Distinct claim limitation lists (claim then observation limitations, de-duplicated in order), referenced by limitationSetRef.",
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {
        "$ref": "#/$defs/limitationSet"
      }
    },
    "outputContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "methodId",
        "methodVersion",
        "shape",
        "candidateTypes"
      ],
      "properties": {
        "methodId": {
          "const": "automation-decision-candidates"
        },
        "methodVersion": {
          "const": "1.0.0"
        },
        "shape": {
          "const": "JSON_OBJECT_WITH_ONLY_AI_CANDIDATES"
        },
        "candidateTypes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "HYPOTHESIS",
              "OPPORTUNITY_DIRECTION",
              "STRATEGY_OPTION",
              "ACTION_OPTION"
            ]
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "workingQuestion": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "label",
            "text",
            "ownerFieldsToAdd"
          ],
          "properties": {
            "state": {
              "const": "AI_PROPOSED_AWAITING_OWNER"
            },
            "label": {
              "$ref": "#/$defs/text"
            },
            "text": {
              "anyOf": [
                {
                  "$ref": "#/$defs/text"
                },
                {
                  "type": "null"
                }
              ]
            },
            "ownerFieldsToAdd": {
              "type": "array",
              "maxItems": 10000,
              "items": {
                "$ref": "#/$defs/text"
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "sectionId": {
            "const": "M11"
          }
        },
        "required": [
          "sectionId"
        ]
      },
      "then": {
        "properties": {
          "outputContract": {
            "type": "object",
            "properties": {
              "candidateTypes": {
                "const": [
                  "HYPOTHESIS",
                  "OPPORTUNITY_DIRECTION"
                ]
              }
            }
          },
          "ownerInputs": {
            "type": "object",
            "properties": {
              "unsetFields": {
                "const": [
                  "expectedReturn",
                  "opportunityDefinition",
                  "ownerHypotheses",
                  "priority",
                  "risk",
                  "size",
                  "weights"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "sectionId": {
            "const": "I15"
          }
        },
        "required": [
          "sectionId"
        ]
      },
      "then": {
        "properties": {
          "outputContract": {
            "type": "object",
            "properties": {
              "candidateTypes": {
                "const": [
                  "STRATEGY_OPTION"
                ]
              }
            }
          },
          "ownerInputs": {
            "type": "object",
            "properties": {
              "unsetFields": {
                "const": [
                  "capability",
                  "cost",
                  "horizon",
                  "objective",
                  "ownerOptions",
                  "preferredOption",
                  "reviewTrigger",
                  "riskAppetite",
                  "tradeOffWeights"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "sectionId": {
            "const": "M12"
          }
        },
        "required": [
          "sectionId"
        ]
      },
      "then": {
        "properties": {
          "outputContract": {
            "type": "object",
            "properties": {
              "candidateTypes": {
                "const": [
                  "ACTION_OPTION"
                ]
              }
            }
          },
          "ownerInputs": {
            "type": "object",
            "properties": {
              "unsetFields": {
                "const": [
                  "accountableOwner",
                  "budget",
                  "capability",
                  "chosen",
                  "criteria",
                  "executionAuthorization",
                  "ownerOptions",
                  "risk",
                  "timing"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "methodVersion": {
            "const": "1.0.0"
          }
        },
        "required": [
          "methodVersion"
        ]
      },
      "then": {
        "properties": {
          "supportEligible": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "\\S"
    },
    "nullableText": {
      "anyOf": [
        {
          "$ref": "#/$defs/text"
        },
        {
          "type": "null"
        }
      ]
    },
    "quote": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000000,
      "pattern": "\\S"
    },
    "source": {
      "title": "DecisionSynthesisSource",
      "description": "Where the claim was read. sourceRecordRef is the SHA-256 of the canonical file digest, locator and record locator; claims sharing it come from one record. Package and method identities resolve through claimId in the bound claims artifact.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceRecordRef",
        "logicalPath",
        "locator",
        "recordLocator",
        "attribution",
        "statement"
      ],
      "properties": {
        "sourceRecordRef": {
          "$ref": "#/$defs/digest"
        },
        "logicalPath": {
          "$ref": "#/$defs/text"
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "recordLocator": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "attribution": {
          "$ref": "#/$defs/nullableText"
        },
        "statement": {
          "$ref": "#/$defs/nullableText"
        }
      }
    },
    "span": {
      "title": "DecisionSynthesisSpan",
      "description": "An exact encoded source quote and its role, in claim order. Offsets resolve through claimId. QUALIFIER and COUNTEREVIDENCE spans are never dropped.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "quote"
      ],
      "properties": {
        "role": {
          "enum": [
            "RECORD",
            "DECLARATION",
            "QUALIFIER",
            "COUNTEREVIDENCE",
            "CONTEXT"
          ]
        },
        "quote": {
          "$ref": "#/$defs/quote"
        }
      }
    },
    "spans": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/span"
      }
    },
    "declaration": {
      "title": "DecisionSynthesisDeclaration",
      "description": "Attributed self-report provenance. Not authenticated truth or owner approval.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceAttribution",
        "annotationAttribution",
        "coderRole",
        "adjudication",
        "disagreement"
      ],
      "properties": {
        "sourceAttribution": {
          "$ref": "#/$defs/text"
        },
        "annotationAttribution": {
          "$ref": "#/$defs/nullableText"
        },
        "coderRole": {
          "$ref": "#/$defs/text"
        },
        "adjudication": {
          "$ref": "#/$defs/nullableText"
        },
        "disagreement": {
          "$ref": "#/$defs/nullableText"
        }
      }
    },
    "period": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end",
            "timezone",
            "basis"
          ],
          "properties": {
            "start": {
              "type": "string",
              "format": "date"
            },
            "end": {
              "type": "string",
              "format": "date"
            },
            "timezone": {
              "$ref": "#/$defs/text"
            },
            "basis": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "coverage": {
      "title": "DecisionSynthesisCoverage",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "observedCount",
        "zeroCount",
        "missingCount",
        "unknownCount",
        "nonExactCount",
        "description"
      ],
      "properties": {
        "unit": {
          "enum": [
            "SOURCE_OBSERVATIONS",
            "LOCATED_RECORDS"
          ]
        },
        "observedCount": {
          "type": "integer",
          "minimum": 0
        },
        "zeroCount": {
          "type": "integer",
          "minimum": 0
        },
        "missingCount": {
          "type": "integer",
          "minimum": 0
        },
        "unknownCount": {
          "type": "integer",
          "minimum": 0
        },
        "nonExactCount": {
          "type": "integer",
          "minimum": 0
        },
        "description": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "supportClaim": {
      "title": "DecisionSynthesisSupportClaim",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimId",
        "sectionId",
        "currentAdapterSupport",
        "source",
        "declaration",
        "contextFields",
        "encodedCounterevidenceQuotes",
        "spans",
        "observation",
        "scopeRef",
        "limitationSetRef"
      ],
      "properties": {
        "claimId": {
          "$ref": "#/$defs/digest"
        },
        "sectionId": {
          "const": "I02"
        },
        "currentAdapterSupport": {
          "const": "USE_CONTEXT_ANCHOR"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "declaration": {
          "$ref": "#/$defs/declaration"
        },
        "contextFields": {
          "description": "The admitted structured I02 context fields with their exact quotes, in admission order.",
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "quote"
            ],
            "properties": {
              "field": {
                "enum": [
                  "role",
                  "situation",
                  "task",
                  "setting",
                  "time"
                ]
              },
              "quote": {
                "$ref": "#/$defs/quote"
              }
            }
          }
        },
        "encodedCounterevidenceQuotes": {
          "description": "Counterevidence quotes the admission retained on this anchor. If the claim is cited as support they must be acknowledged, not dropped. Empty means none encoded, not none exists.",
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/quote"
          }
        },
        "spans": {
          "$ref": "#/$defs/spans"
        },
        "observation": {
          "$ref": "#/$defs/declarationObservation"
        },
        "scopeRef": {
          "$ref": "#/$defs/digest"
        },
        "limitationSetRef": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "declarationContextClaim": {
      "title": "DecisionSynthesisDeclarationContextClaim",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimId",
        "sectionId",
        "currentAdapterSupport",
        "currentAdapterReason",
        "source",
        "declaration",
        "spans",
        "observation",
        "scopeRef",
        "limitationSetRef"
      ],
      "properties": {
        "claimId": {
          "$ref": "#/$defs/digest"
        },
        "sectionId": {
          "enum": [
            "I02",
            "I04"
          ]
        },
        "currentAdapterSupport": {
          "enum": [
            "NOT_ADMITTED_BY_CURRENT_ADAPTER",
            "BEHAVIOR_WITH_USE_CONTEXT"
          ]
        },
        "currentAdapterReason": {
          "anyOf": [
            {
              "enum": [
                "I04_BEHAVIOR_ALONE_IS_NOT_USE_CONTEXT",
                "NO_SOURCE_STATED_USE_CONTEXT_FIELD",
                "CONTEXT_FIELD_CONFLICTING",
                "CONTEXT_QUALIFIER_SEMANTICS_NOT_ENCODED",
                "BEHAVIOR_CONTEXT_NOT_ADMITTED"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "declaration": {
          "$ref": "#/$defs/declaration"
        },
        "spans": {
          "$ref": "#/$defs/spans"
        },
        "observation": {
          "$ref": "#/$defs/declarationObservation"
        },
        "scopeRef": {
          "$ref": "#/$defs/digest"
        },
        "limitationSetRef": {
          "$ref": "#/$defs/digest"
        },
        "behavior": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "eventKind",
            "attribution",
            "quote",
            "contextClaimRefs"
          ],
          "properties": {
            "eventKind": {
              "enum": [
                "ACTION_REPORTED",
                "ATTEMPT_REPORTED",
                "COMPLETION_REPORTED"
              ]
            },
            "attribution": {
              "enum": [
                "SOURCE_LOGGED",
                "SELF_REPORTED"
              ]
            },
            "quote": {
              "$ref": "#/$defs/quote"
            },
            "contextClaimRefs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20000,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/digest"
              }
            }
          }
        }
      }
    },
    "observedContextClaim": {
      "title": "DecisionSynthesisObservedContextClaim",
      "description": "One M05 source observation with its exact literal, value, unit, precision, period, scope and coverage. Values are data for context and proposed counterevidence only; there is no admitted M05 support.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimId",
        "sectionId",
        "currentAdapterSupport",
        "currentAdapterReason",
        "permittedUse",
        "source",
        "spans",
        "observation",
        "scopeRef",
        "limitationSetRef"
      ],
      "properties": {
        "claimId": {
          "$ref": "#/$defs/digest"
        },
        "sectionId": {
          "const": "M05"
        },
        "currentAdapterSupport": {
          "enum": [
            "NOT_ADMITTED_BY_CURRENT_ADAPTER",
            "OBSERVED_LITERAL"
          ]
        },
        "currentAdapterReason": {
          "anyOf": [
            {
              "enum": [
                "NOT_A_LOCATED_DECLARATION",
                "OBSERVATION_IDENTIFICATION_INCOMPLETE"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "permittedUse": {
          "enum": [
            "SEPARATE_CONTEXT_OR_PROPOSED_COUNTEREVIDENCE_WITH_RETAINED_RELATION",
            "LITERAL_OBSERVATION_FOR_UNREVIEWED_RELATION_DRAFT"
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "spans": {
          "$ref": "#/$defs/spans"
        },
        "observation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "measure",
            "value",
            "unit",
            "precision",
            "period",
            "periodText",
            "coverage"
          ],
          "properties": {
            "state": {
              "enum": [
                "observed_zero",
                "observed_value"
              ]
            },
            "measure": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "literal",
                "definition",
                "entityLabel"
              ],
              "properties": {
                "literal": {
                  "$ref": "#/$defs/text"
                },
                "definition": {
                  "$ref": "#/$defs/text"
                },
                "entityLabel": {
                  "$ref": "#/$defs/nullableText"
                }
              }
            },
            "value": {
              "type": "string",
              "maxLength": 200,
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            },
            "unit": {
              "$ref": "#/$defs/nullableText"
            },
            "precision": {
              "enum": [
                "exact",
                "non_exact",
                "not_applicable"
              ]
            },
            "period": {
              "$ref": "#/$defs/period"
            },
            "periodText": {
              "$ref": "#/$defs/nullableText"
            },
            "coverage": {
              "$ref": "#/$defs/coverage"
            }
          }
        },
        "scopeRef": {
          "$ref": "#/$defs/digest"
        },
        "limitationSetRef": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "linkedClaimGroup": {
      "title": "DecisionSynthesisLinkedClaimGroup",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "linkType",
        "independence",
        "claimIds"
      ],
      "properties": {
        "linkType": {
          "enum": [
            "SAME_SOURCE_RECORD",
            "SAME_ATTRIBUTION_TEXT",
            "IDENTICAL_QUOTED_TEXT"
          ]
        },
        "independence": {
          "description": "NOT_INDEPENDENT for one source record; INDEPENDENCE_NOT_ESTABLISHED for shared attribution text or identical quoted text across records.",
          "enum": [
            "NOT_INDEPENDENT",
            "INDEPENDENCE_NOT_ESTABLISHED"
          ]
        },
        "claimIds": {
          "type": "array",
          "minItems": 2,
          "maxItems": 20000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    },
    "scopeEntry": {
      "title": "DecisionSynthesisScope",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scopeRef",
        "scopeSha256",
        "universe",
        "geography",
        "frame",
        "inclusionRule",
        "exclusionRule",
        "variantRule",
        "description"
      ],
      "properties": {
        "scopeRef": {
          "$ref": "#/$defs/digest"
        },
        "scopeSha256": {
          "$ref": "#/$defs/digest"
        },
        "universe": {
          "$ref": "#/$defs/nullableText"
        },
        "geography": {
          "$ref": "#/$defs/nullableText"
        },
        "frame": {
          "$ref": "#/$defs/nullableText"
        },
        "inclusionRule": {
          "$ref": "#/$defs/nullableText"
        },
        "exclusionRule": {
          "$ref": "#/$defs/nullableText"
        },
        "variantRule": {
          "$ref": "#/$defs/nullableText"
        },
        "description": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "limitationSet": {
      "title": "DecisionSynthesisLimitationSet",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "limitationSetRef",
        "limitations"
      ],
      "properties": {
        "limitationSetRef": {
          "$ref": "#/$defs/digest"
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 60,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "declarationObservation": {
      "title": "DecisionSynthesisDeclarationObservation",
      "description": "Observation fields of a declared claim. Measure and value are always null and precision is not_applicable for declarations, so they are not repeated.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "period",
        "periodText",
        "coverage"
      ],
      "properties": {
        "unit": {
          "$ref": "#/$defs/nullableText"
        },
        "period": {
          "$ref": "#/$defs/period"
        },
        "periodText": {
          "$ref": "#/$defs/nullableText"
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        }
      }
    }
  }
}
