{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdn.local/contracts/analysis/report-section-catalog.schema.json",
  "title": "ReportSectionCatalog",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contractVersion": {
      "const": "1.0.0"
    },
    "catalogId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "catalogVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "authority": {
      "const": "PLANNING_METADATA_NOT_EXECUTABLE_METHOD"
    },
    "sections": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/SectionDefinition"
      },
      "minItems": 1
    }
  },
  "required": [
    "contractVersion",
    "catalogId",
    "catalogVersion",
    "authority",
    "sections"
  ],
  "$defs": {
    "SectionDefinition": {
      "title": "SectionDefinition",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sectionId": {
          "type": "string",
          "pattern": "^[MI][0-9]{2,3}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "methodId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "methodVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "historicalTemplateMaturity": {
          "enum": [
            "PILOT",
            "SYNTHESIS",
            "METHOD",
            "SCENARIO"
          ]
        },
        "moduleIds": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "minItems": 1
        },
        "requiredInputs": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "reopenCondition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "fallbackState": {
          "enum": [
            "BLOCKED",
            "METHOD_ONLY",
            "MANUAL_REVIEW_REQUIRED",
            "NOT_IMPLEMENTED"
          ]
        },
        "fallbackReasons": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "minItems": 1
        }
      },
      "required": [
        "sectionId",
        "title",
        "methodId",
        "methodVersion",
        "historicalTemplateMaturity",
        "moduleIds",
        "requiredInputs",
        "reopenCondition",
        "fallbackState",
        "fallbackReasons"
      ]
    }
  }
}
