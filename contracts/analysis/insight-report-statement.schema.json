{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "statementId",
    "revisionId",
    "purchaseStage",
    "customer",
    "hiddenTruth",
    "motivation",
    "conflict",
    "insight",
    "evidence",
    "confidence"
  ],
  "properties": {
    "contractVersion": {
      "const": "1.0.0"
    },
    "statementId": {
      "type": "string",
      "format": "uuid"
    },
    "revisionId": {
      "type": "string",
      "format": "uuid"
    },
    "purchaseStage": {
      "enum": [
        "AWARENESS",
        "INTEREST",
        "DESIRE",
        "PURCHASE",
        "POST_PURCHASE"
      ]
    },
    "customer": {
      "type": "string",
      "pattern": "\\S"
    },
    "hiddenTruth": {
      "type": "string",
      "pattern": "\\S"
    },
    "motivation": {
      "type": "string",
      "pattern": "\\S"
    },
    "conflict": {
      "type": "string",
      "pattern": "\\S"
    },
    "insight": {
      "type": "string",
      "pattern": "\\S"
    },
    "threeC": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "customer",
            "brand",
            "category"
          ],
          "properties": {
            "customer": {
              "type": "string",
              "pattern": "\\S"
            },
            "brand": {
              "type": "string",
              "pattern": "\\S"
            },
            "category": {
              "type": "string",
              "pattern": "\\S"
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "platform",
          "count"
        ],
        "properties": {
          "platform": {
            "enum": [
              "shopee",
              "tiktok"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "denominator": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "hypothesis"
      ],
      "properties": {
        "level": {
          "enum": [
            "CERTAIN",
            "FAIR",
            "WEAK",
            "NONE"
          ]
        },
        "hypothesis": {
          "type": "boolean"
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InsightReportStatement",
  "$id": "https://tdn.local/contracts/analysis/insight-report-statement.schema.json"
}
