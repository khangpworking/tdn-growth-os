{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdn.local/contracts/analysis/metric-source-labels.schema.json",
  "title": "MetricSourceLabels",
  "type": "object", "additionalProperties": false,
  "required": ["contractVersion", "sourceSha256", "codebookVersion", "provenanceBasis", "rows"],
  "properties": {
    "contractVersion": {"const": "1.0.0"},
    "sourceSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "codebookVersion": {"type": "string", "minLength": 1, "maxLength": 100},
    "provenanceBasis": {"type": "string", "minLength": 1, "maxLength": 1000},
    "rows": {
      "type": "array", "minItems": 1, "maxItems": 10000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["row", "rowSha256", "shopId", "listingId", "contentSha256", "classification", "group", "methodVersion", "adjudication"],
        "properties": {
          "row": {"type": "integer", "minimum": 2, "maximum": 10001},
          "rowSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "shopId": {"type": "string", "pattern": "^[1-9][0-9]{0,127}$"},
          "listingId": {"type": "string", "pattern": "^[1-9][0-9]{0,127}$"},
          "contentSha256": {"$ref": "metric-scope-input.schema.json#/$defs/Label/properties/contentSha256"},
          "classification": {"$ref": "metric-scope-input.schema.json#/$defs/Label/properties/classification"},
          "group": {"$ref": "metric-scope-input.schema.json#/$defs/Label/properties/group"},
          "methodVersion": {"$ref": "metric-scope-input.schema.json#/$defs/Label/properties/methodVersion"},
          "adjudication": {"$ref": "metric-scope-input.schema.json#/$defs/Label/properties/adjudication"}
        }
      }
    }
  }
}
