{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdn.local/contracts/analysis/source-package-field-audit-request.schema.json",
  "title": "SourcePackageFieldAuditRequest", "type": "object", "additionalProperties": false,
  "required": ["contractVersion", "packageKey", "version", "observations", "conflicts", "periodComparisons"],
  "properties": {
    "contractVersion": { "const": "1.0.0" }, "packageKey": { "type": "string", "minLength": 3, "maxLength": 160 },
    "version": { "type": "integer", "minimum": 1 },
    "observations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/observation" } },
    "conflicts": { "type": "array", "items": { "$ref": "#/$defs/conflict" } },
    "periodComparisons": { "type": "array", "items": { "$ref": "#/$defs/periodComparison" } }
  },
  "$defs": {
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["observationKey", "field", "state", "value", "unit", "precision", "evidenceFamily", "representationPath", "representationSha256", "locator", "notes"],
      "properties": {
        "observationKey": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$", "maxLength": 160 },
        "field": { "type": "string", "minLength": 1, "maxLength": 200 }, "state": { "enum": ["missing", "observed_zero", "observed_value"] },
        "value": { "type": ["string", "null"], "maxLength": 1000 }, "unit": { "type": ["string", "null"], "maxLength": 100 },
        "precision": { "enum": ["exact", "display_rounded", "estimated", "unknown"] },
        "evidenceFamily": { "type": "string", "minLength": 1, "maxLength": 120 },
        "representationPath": { "type": "string", "minLength": 1, "maxLength": 500 },
        "representationSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "locator": { "oneOf": [
          { "type": "object", "additionalProperties": false, "required": ["type", "text"], "properties": { "type": { "const": "html_text" }, "text": { "type": "string", "minLength": 1 } } },
          { "type": "object", "additionalProperties": false, "required": ["type", "page"], "properties": { "type": { "const": "pdf_page" }, "page": { "type": "integer", "minimum": 1 } } },
          { "type": "object", "additionalProperties": false, "required": ["type", "sheet", "cell"], "properties": { "type": { "const": "xlsx_cell" }, "sheet": { "type": "string", "minLength": 1 }, "cell": { "type": "string", "pattern": "^[A-Z]+[1-9][0-9]*$" } } },
          { "type": "object", "additionalProperties": false, "required": ["type", "pointer"], "properties": { "type": { "const": "json_pointer" }, "pointer": { "type": "string", "pattern": "^(?:/(?:[^~/]|~[01])*)*$" } } }
        ] },
        "notes": { "type": "string", "maxLength": 2000 }
      }
    },
    "conflict": {
      "type": "object", "additionalProperties": false, "required": ["type", "observationKeys", "resolution", "notes"],
      "properties": { "type": { "enum": ["representation_mismatch", "rounding_difference", "scope_mismatch", "other"] },
        "observationKeys": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string" } },
        "resolution": { "const": "unresolved" }, "notes": { "type": "string", "minLength": 1, "maxLength": 2000 } }
    },
    "periodComparison": {
      "type": "object", "additionalProperties": false, "required": ["leftObservationKey", "rightObservationKey", "compatibility", "claim", "notes"],
      "properties": { "leftObservationKey": { "type": "string" }, "rightObservationKey": { "type": "string" },
        "compatibility": { "enum": ["compatible", "incompatible"] }, "claim": { "type": ["string", "null"], "maxLength": 2000 }, "notes": { "type": "string", "maxLength": 2000 } }
    }
  }
}
