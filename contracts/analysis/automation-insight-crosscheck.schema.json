{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdn.local/contracts/analysis/automation-insight-crosscheck.schema.json",
  "title": "AutomationInsightCrosscheckContract",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/source"
    },
    {
      "$ref": "#/$defs/input"
    },
    {
      "$ref": "#/$defs/prompt"
    },
    {
      "$ref": "#/$defs/candidates"
    },
    {
      "$ref": "#/$defs/snapshot"
    },
    {
      "$ref": "#/$defs/selection"
    }
  ],
  "$defs": {
    "request": {
      "title": "InsightCrosscheckRequest",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "requestKey",
        "binding",
        "firstProposalId",
        "firstProposalSha256",
        "codebookSha256",
        "seed",
        "secondConfigurationSha256"
      ],
      "properties": {
        "contractVersion": {
          "const": "insight-crosscheck-request-v1"
        },
        "requestKey": {
          "type": "string",
          "format": "uuid"
        },
        "binding": {
          "$ref": "automation-insight-coding.schema.json#/$defs/binding"
        },
        "firstProposalId": {
          "type": "string",
          "format": "uuid"
        },
        "firstProposalSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "codebookSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "seed": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "secondConfigurationSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "sourceRecord": {
      "title": "InsightCrosscheckSourceRecord",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recordIndex",
        "sourceSha256",
        "locator"
      ],
      "properties": {
        "recordIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        }
      }
    },
    "firstExecution": {
      "title": "InsightCrosscheckFirstExecution",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executionId",
        "proposalId",
        "proposalSha256",
        "admissionSha256",
        "inputSha256",
        "promptSha256",
        "configurationSha256",
        "configuration",
        "candidatesSha256"
      ],
      "properties": {
        "executionId": {
          "type": "string",
          "format": "uuid"
        },
        "proposalId": {
          "type": "string",
          "format": "uuid"
        },
        "proposalSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "admissionSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "inputSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "promptSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "configurationSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "configuration": {
          "$ref": "automation-insight-model.schema.json#/$defs/configuration"
        },
        "candidatesSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "plan": {
      "title": "InsightCrosscheckPlan",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sampleVersion",
        "seed",
        "eligible",
        "eligibleSha256",
        "sample",
        "sampleSha256",
        "batches",
        "firstExecutions",
        "secondConfiguration",
        "secondConfigurationSha256"
      ],
      "properties": {
        "sampleVersion": {
          "const": "sha256-ranked-source-records-v1"
        },
        "seed": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "eligible": {
          "type": "array",
          "minItems": 0,
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/sourceRecord"
          }
        },
        "eligibleSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sample": {
          "type": "array",
          "minItems": 0,
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/sourceRecord"
          }
        },
        "sampleSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "batches": {
          "type": "array",
          "minItems": 0,
          "maxItems": 2,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9999
            }
          }
        },
        "firstExecutions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/firstExecution"
          }
        },
        "secondConfiguration": {
          "$ref": "automation-insight-model.schema.json#/$defs/configuration"
        },
        "secondConfigurationSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "source": {
      "title": "InsightCrosscheckSource",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "request",
        "binding",
        "actorId",
        "defaultRuleId",
        "defaultRuleSha256",
        "input",
        "plan",
        "batchIndex",
        "previousSecondAnnotations"
      ],
      "properties": {
        "contractVersion": {
          "const": "insight-crosscheck-source-v1"
        },
        "request": {
          "$ref": "#/$defs/request"
        },
        "binding": {
          "$ref": "automation-insight-coding.schema.json#/$defs/binding"
        },
        "actorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "defaultRuleId": {
          "type": "string",
          "format": "uuid"
        },
        "defaultRuleSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "input": {
          "$ref": "located-insight-methods.schema.json#/$defs/input"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "batchIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "previousSecondAnnotations": {
          "$ref": "automation-insight-coding.schema.json#/$defs/annotations"
        }
      }
    },
    "code": {
      "title": "InsightCrosscheckCodeMeaning",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "label",
        "phrase"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "phrase": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        }
      }
    },
    "record": {
      "title": "InsightCrosscheckBlindedRecord",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recordIndex",
        "sourceSha256",
        "locator",
        "text"
      ],
      "properties": {
        "recordIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000000
        }
      }
    },
    "corpus": {
      "title": "InsightCrosscheckBlindedCorpus",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "corpusIndex",
        "sectionId",
        "recordIndexes",
        "multiCode",
        "codes"
      ],
      "properties": {
        "corpusIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        "sectionId": {
          "enum": [
            "I10",
            "I13"
          ]
        },
        "recordIndexes": {
          "type": "array",
          "minItems": 0,
          "maxItems": 10000,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9999
          }
        },
        "multiCode": {
          "type": "boolean"
        },
        "codes": {
          "type": "array",
          "minItems": 0,
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/code"
          }
        }
      }
    },
    "input": {
      "title": "InsightCrosscheckBlindedInput",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectionVersion",
        "codebookSha256",
        "question",
        "inclusionRule",
        "adjudicationRule",
        "records",
        "corpora"
      ],
      "properties": {
        "projectionVersion": {
          "const": "insight-crosscheck-blinded-v1"
        },
        "codebookSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "question": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 20000
        },
        "inclusionRule": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 20000
        },
        "adjudicationRule": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 20000
        },
        "records": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/record"
          }
        },
        "corpora": {
          "type": "array",
          "minItems": 0,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/corpus"
          }
        }
      }
    },
    "prompt": {
      "title": "InsightCrosscheckPrompt",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "systemText"
      ],
      "properties": {
        "contractVersion": {
          "const": "insight-crosscheck-prompt-v1"
        },
        "systemText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 262144
        }
      }
    },
    "candidates": {
      "title": "InsightCrosscheckCandidates",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "completionText",
        "batchAnnotations",
        "annotations"
      ],
      "properties": {
        "contractVersion": {
          "const": "insight-crosscheck-candidates-v1"
        },
        "completionText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8388608
        },
        "batchAnnotations": {
          "$ref": "automation-insight-coding.schema.json#/$defs/annotations"
        },
        "annotations": {
          "$ref": "automation-insight-coding.schema.json#/$defs/annotations"
        }
      }
    },
    "literalRow": {
      "title": "InsightCrosscheckLiteralRow",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recordIndex",
        "sourceSha256",
        "locator",
        "text",
        "first",
        "second",
        "literalDifferences"
      ],
      "properties": {
        "recordIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000000
        },
        "first": {
          "$ref": "automation-insight-coding.schema.json#/$defs/annotations"
        },
        "second": {
          "$ref": "automation-insight-coding.schema.json#/$defs/annotations"
        },
        "literalDifferences": {
          "type": "array",
          "minItems": 0,
          "maxItems": 9,
          "items": {
            "enum": [
              "i02",
              "i04",
              "i05",
              "i06",
              "i07",
              "i08",
              "i09",
              "i13Mentions",
              "corpora"
            ]
          }
        }
      }
    },
    "executionReference": {
      "title": "InsightCrosscheckExecutionReference",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executionId",
        "admissionSha256",
        "inputSha256",
        "promptSha256",
        "configurationSha256",
        "candidatesSha256"
      ],
      "properties": {
        "executionId": {
          "type": "string",
          "format": "uuid"
        },
        "admissionSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "inputSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "promptSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "configurationSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidatesSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "selection": {
      "$ref": "automation-insight-report-revision.schema.json#/$defs/crosscheckSelection"
    },
    "snapshot": {
      "title": "InsightCrosscheckSnapshot",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "request",
        "actorId",
        "defaultRuleId",
        "defaultRuleSha256",
        "plan",
        "secondExecutions",
        "secondAnnotations",
        "literalRows",
        "firstWireCompletion",
        "releaseState"
      ],
      "properties": {
        "contractVersion": {
          "const": "insight-crosscheck-snapshot-v1"
        },
        "request": {
          "$ref": "#/$defs/request"
        },
        "actorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "defaultRuleId": {
          "type": "string",
          "format": "uuid"
        },
        "defaultRuleSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "secondExecutions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/executionReference"
          }
        },
        "secondAnnotations": {
          "$ref": "automation-insight-coding.schema.json#/$defs/annotations"
        },
        "literalRows": {
          "type": "array",
          "minItems": 0,
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/literalRow"
          }
        },
        "firstWireCompletion": {
          "const": "NOT_RETAINED_BY_ORIGINAL_EXECUTION"
        },
        "releaseState": {
          "const": "U11_STATISTIC_UNAVAILABLE"
        }
      }
    }
  }
}
