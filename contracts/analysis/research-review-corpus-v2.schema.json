{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResearchReviewCorpusV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "mappingRevision",
    "corpusId",
    "collectionId",
    "collectionSha256",
    "requestSha256",
    "selectionBasis",
    "selectedListings",
    "sourcePages",
    "capture",
    "corpusState",
    "codingState",
    "records",
    "coverage",
    "blockers",
    "limitations",
    "confirmedSourceSetSha256"
  ],
  "properties": {
    "contractVersion": {
      "const": "research-review-corpus-v2"
    },
    "mappingRevision": {
      "const": "shopee-public-review-row-v1"
    },
    "corpusId": {
      "$ref": "#/$defs/digest"
    },
    "collectionId": {
      "type": "string",
      "format": "uuid"
    },
    "collectionSha256": {
      "$ref": "#/$defs/digest"
    },
    "requestSha256": {
      "$ref": "#/$defs/digest"
    },
    "selectionBasis": {
      "const": "OWNER_EXACT_URL"
    },
    "selectedListings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "platform",
          "shopId",
          "itemId",
          "listingKey",
          "productUrl"
        ],
        "properties": {
          "platform": {
            "const": "shopee"
          },
          "shopId": {
            "$ref": "#/$defs/platformId"
          },
          "itemId": {
            "$ref": "#/$defs/platformId"
          },
          "listingKey": {
            "$ref": "#/$defs/shortText"
          },
          "productUrl": {
            "$ref": "#/$defs/shortText"
          }
        }
      }
    },
    "sourcePages": {
      "type": "array",
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sha256",
          "pageIndex",
          "byteSize",
          "offset",
          "rowCount"
        ],
        "properties": {
          "sha256": {
            "$ref": "#/$defs/digest"
          },
          "pageIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 24
          },
          "byteSize": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8388608
          },
          "offset": {
            "$ref": "#/$defs/count"
          },
          "rowCount": {
            "$ref": "#/$defs/count"
          }
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerId",
        "listings"
      ],
      "properties": {
        "providerId": {
          "const": "shopee-public-review"
        },
        "listings": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "$ref": "../foundation/shopee-public-collection.schema.json#/$defs/receipt"
          }
        }
      }
    },
    "corpusState": {
      "const": "RAW_CAPTURE_ONLY"
    },
    "codingState": {
      "const": "NOT_CODED"
    },
    "records": {
      "type": "array",
      "maxItems": 1500,
      "items": {
        "$ref": "research-review-corpus.schema.json#/$defs/record"
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceRows",
        "uniqueScopedGroups",
        "equalDuplicates",
        "conflictingGroups",
        "quarantinedRows",
        "capturedReviewRecords",
        "readableCommentRecords",
        "attributesOnlyRecords",
        "emptyComments",
        "unreadableComments",
        "missingRatings",
        "invalidRatings",
        "sourceExcludedIds"
      ],
      "properties": {
        "sourceRows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "uniqueScopedGroups": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "equalDuplicates": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "conflictingGroups": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "quarantinedRows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "capturedReviewRecords": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "readableCommentRecords": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "attributesOnlyRecords": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "emptyComments": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "unreadableComments": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "missingRatings": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "invalidRatings": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "sourceExcludedIds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        }
      }
    },
    "blockers": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/shortText"
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/shortText"
      }
    },
    "confirmedSourceSetSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "platformId": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "nullableText": {
      "anyOf": [
        {
          "$ref": "#/$defs/shortText"
        },
        {
          "type": "null"
        }
      ]
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2500
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pageSha256",
        "pageIndex",
        "rowIndex",
        "rowPointer",
        "textPointer"
      ],
      "properties": {
        "pageSha256": {
          "$ref": "#/$defs/digest"
        },
        "pageIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 24
        },
        "rowIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2499
        },
        "rowPointer": {
          "type": "string",
          "pattern": "^/(0|[1-9][0-9]*)$"
        },
        "textPointer": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^/(0|[1-9][0-9]*)/comment$"
        }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rawRowSha256",
        "text",
        "textState",
        "rating",
        "sourceRefs",
        "reasons"
      ],
      "properties": {
        "rawRowSha256": {
          "$ref": "#/$defs/digest"
        },
        "text": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 8388608
        },
        "textState": {
          "enum": [
            "READABLE",
            "EMPTY",
            "UNREADABLE"
          ]
        },
        "rating": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "value"
          ],
          "properties": {
            "state": {
              "enum": [
                "VALID",
                "MISSING",
                "INVALID"
              ]
            },
            "value": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 5
            }
          }
        },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2500,
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        },
        "reasons": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/shortText"
          }
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "listingAdmission",
        "disposition",
        "occurrenceCount",
        "versions"
      ],
      "properties": {
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "nativeReviewId",
            "listingKey",
            "internalLocator"
          ],
          "properties": {
            "kind": {
              "enum": [
                "NATIVE_REVIEW_ID",
                "SOURCE_ROW_LOCATOR",
                "UNRESOLVED"
              ]
            },
            "nativeReviewId": {
              "$ref": "#/$defs/nullableText"
            },
            "listingKey": {
              "$ref": "#/$defs/nullableText"
            },
            "internalLocator": {
              "$ref": "#/$defs/nullableText"
            }
          }
        },
        "listingAdmission": {
          "enum": [
            "SELECTED_LISTING",
            "WRONG_LISTING",
            "UNRESOLVED_LISTING"
          ]
        },
        "disposition": {
          "enum": [
            "RETAINED_RAW",
            "QUARANTINED",
            "UNRESOLVED_CONFLICT"
          ]
        },
        "occurrenceCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2500
        },
        "versions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2500,
          "items": {
            "$ref": "#/$defs/version"
          }
        }
      }
    }
  },
  "$id": "https://tdn.local/contracts/analysis/research-review-corpus-v2.schema.json"
}
