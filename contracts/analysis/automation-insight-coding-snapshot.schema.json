{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdn.local/contracts/analysis/automation-insight-coding-snapshot.schema.json",
  "title": "AutomationInsightCodingSnapshot",
  "description": "Retained coding snapshot: accepted receipts (v1, legacy) or one versioned receipt-free draft selection (v2). Exactly one branch validates; historical v1 payloads match only the accepted branch.",
  "oneOf": [
    {
      "$ref": "#/$defs/acceptedSnapshot"
    },
    {
      "$ref": "#/$defs/draftSnapshot"
    },
    {
      "$ref": "#/$defs/familyDraftSnapshot"
    },
    {
      "$ref": "#/$defs/defaultDraftSnapshot"
    },
    {
      "$ref": "#/$defs/privateDefaultDraftSnapshot"
    }
  ],
  "$defs": {
    "acceptedSnapshot": {
      "title": "AutomationInsightCodingAcceptedSnapshot",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "binding",
        "selection",
        "adoptionId",
        "proposalSha256",
        "receipts",
        "output"
      ],
      "properties": {
        "contractVersion": {
          "const": "automation-insight-coding-snapshot-v1"
        },
        "selectionContractVersion": {
          "const": "automation-insight-selection-v2"
        },
        "binding": {
          "$ref": "automation-insight-coding.schema.json#/$defs/binding"
        },
        "selection": {
          "$ref": "automation-insight-report-revision.schema.json#/$defs/selection"
        },
        "adoptionId": {
          "type": "string",
          "format": "uuid"
        },
        "proposalSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "receipts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "receiptId",
              "sha256"
            ],
            "properties": {
              "receiptId": {
                "type": "string",
                "format": "uuid"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "output": {
          "$ref": "located-insight-methods.schema.json"
        }
      }
    },
    "draftSnapshot": {
      "title": "AutomationInsightCodingDraftSnapshot",
      "description": "Zero receipts by construction with an explicit draft selection echo. Never an implicit latest, never approval.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "binding",
        "selection",
        "adoptionId",
        "proposalSha256",
        "receipts",
        "draftSelection",
        "output"
      ],
      "properties": {
        "contractVersion": {
          "const": "automation-insight-coding-snapshot-v2"
        },
        "binding": {
          "$ref": "automation-insight-coding.schema.json#/$defs/binding"
        },
        "selection": {
          "title": "InsightDraftSelectionEcho",
          "description": "Explicit empty selection echo of a versioned draft selection.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "proposalId",
            "receiptIds"
          ],
          "properties": {
            "proposalId": {
              "type": "string",
              "format": "uuid"
            },
            "receiptIds": {
              "type": "array",
              "maxItems": 0
            }
          }
        },
        "adoptionId": {
          "type": "string",
          "format": "uuid"
        },
        "proposalSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "receipts": {
          "type": "array",
          "maxItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "receiptId",
              "sha256"
            ],
            "properties": {
              "receiptId": {
                "type": "string",
                "format": "uuid"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "draftSelection": {
          "$ref": "automation-insight-report-revision.schema.json#/$defs/draftSelectionV1"
        },
        "output": {
          "$ref": "located-insight-methods.schema.json",
          "allOf": [
            {
              "properties": {
                "input": {
                  "properties": {
                    "draftCountsVersion": {
                      "const": "draft-counts-v1"
                    }
                  },
                  "required": [
                    "draftCountsVersion"
                  ],
                  "type": "object"
                }
              },
              "type": "object"
            }
          ]
        }
      }
    },
    "familyDraftSnapshot": {
      "title": "AutomationInsightCodingFamilyDraftSnapshot",
      "description": "Zero receipts by construction with an explicit draft selection echo. Never an implicit latest, never approval.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "binding",
        "selection",
        "adoptionId",
        "proposalSha256",
        "receipts",
        "draftSelection",
        "output",
        "groupCounts"
      ],
      "properties": {
        "contractVersion": {
          "const": "automation-insight-coding-snapshot-v3"
        },
        "binding": {
          "$ref": "automation-insight-coding.schema.json#/$defs/binding"
        },
        "selection": {
          "title": "InsightDraftSelectionEcho",
          "description": "Explicit empty selection echo of a versioned draft selection.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "proposalId",
            "receiptIds"
          ],
          "properties": {
            "proposalId": {
              "type": "string",
              "format": "uuid"
            },
            "receiptIds": {
              "type": "array",
              "maxItems": 0
            }
          }
        },
        "adoptionId": {
          "type": "string",
          "format": "uuid"
        },
        "proposalSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "receipts": {
          "type": "array",
          "maxItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "receiptId",
              "sha256"
            ],
            "properties": {
              "receiptId": {
                "type": "string",
                "format": "uuid"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "draftSelection": {
          "$ref": "automation-insight-report-revision.schema.json#/$defs/draftSelectionV2"
        },
        "output": {
          "$ref": "located-insight-methods.schema.json",
          "allOf": [
            {
              "properties": {
                "input": {
                  "properties": {
                    "draftCountsVersion": {
                      "const": "draft-counts-v2"
                    }
                  },
                  "required": [
                    "draftCountsVersion"
                  ],
                  "type": "object"
                }
              },
              "type": "object"
            }
          ]
        },
        "groupCounts": {
          "$ref": "#/$defs/groupCounts"
        }
      }
    },
    "groupCounts": {
      "title": "InsightDraftGroupCounts",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "state",
        "platform",
        "groups",
        "rates",
        "differences",
        "label",
        "blockers"
      ],
      "properties": {
        "contractVersion": {
          "const": "insight-draft-group-counts-v1"
        },
        "state": {
          "const": "PARTIAL_UNREVIEWED_DRAFT"
        },
        "platform": {
          "enum": [
            "SHOPEE",
            null
          ]
        },
        "groups": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "platform",
              "buyerType",
              "corpusIndex",
              "sectionId",
              "codebookRevision",
              "scope",
              "memberRecordPointers",
              "memberCount",
              "counts",
              "blockers"
            ],
            "properties": {
              "platform": {
                "const": "SHOPEE"
              },
              "buyerType": {
                "type": "null"
              },
              "corpusIndex": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9999
              },
              "sectionId": {
                "enum": [
                  "I10",
                  "I13"
                ]
              },
              "codebookRevision": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 10000
              },
              "scope": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "unit",
                  "period",
                  "frame",
                  "channel",
                  "inclusionRule"
                ],
                "properties": {
                  "unit": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1,
                    "maxLength": 10000
                  },
                  "period": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1,
                    "maxLength": 10000
                  },
                  "frame": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1,
                    "maxLength": 10000
                  },
                  "channel": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1,
                    "maxLength": 10000
                  },
                  "inclusionRule": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1,
                    "maxLength": 10000
                  }
                }
              },
              "memberRecordPointers": {
                "type": "array",
                "maxItems": 10000,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^/input/records/(0|[1-9][0-9]*)$"
                }
              },
              "memberCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              },
              "counts": {
                "type": "array",
                "maxItems": 10000,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "code",
                    "recordPointers",
                    "recordCount",
                    "state",
                    "label"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 10000
                    },
                    "recordPointers": {
                      "type": "array",
                      "maxItems": 10000,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "pattern": "^/input/records/(0|[1-9][0-9]*)$"
                      }
                    },
                    "recordCount": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 10000
                    },
                    "state": {
                      "enum": [
                        "UNAVAILABLE",
                        "PROPOSED_COUNT"
                      ]
                    },
                    "label": {
                      "const": "đề xuất, chờ chủ duyệt"
                    }
                  }
                }
              },
              "blockers": {
                "type": "array",
                "maxItems": 10000,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "rates": {
          "type": "null"
        },
        "differences": {
          "type": "null"
        },
        "label": {
          "const": "đề xuất, chờ chủ duyệt"
        },
        "blockers": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "defaultDraftSnapshot": {
      "title": "AutomationInsightCodingDefaultDraftSnapshot",
      "description": "Exact unapproved source-default proposal; storage compatibility root is not human adoption.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "binding",
        "selection",
        "proposalSha256",
        "receipts",
        "draftSelection",
        "output",
        "groupCounts",
        "defaultRuleId",
        "defaultRuleSha256",
        "codebookSha256",
        "executionId"
      ],
      "properties": {
        "contractVersion": {
          "const": "automation-insight-coding-snapshot-v4"
        },
        "binding": {
          "$ref": "automation-insight-coding.schema.json#/$defs/binding"
        },
        "selection": {
          "title": "InsightDraftSelectionEcho",
          "description": "Explicit empty selection echo of a versioned draft selection.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "proposalId",
            "receiptIds"
          ],
          "properties": {
            "proposalId": {
              "type": "string",
              "format": "uuid"
            },
            "receiptIds": {
              "type": "array",
              "maxItems": 0
            }
          }
        },
        "proposalSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "receipts": {
          "type": "array",
          "maxItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "receiptId",
              "sha256"
            ],
            "properties": {
              "receiptId": {
                "type": "string",
                "format": "uuid"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "draftSelection": {
          "$ref": "automation-insight-report-revision.schema.json#/$defs/defaultSelection"
        },
        "output": {
          "$ref": "located-insight-methods.schema.json",
          "allOf": [
            {
              "properties": {
                "input": {
                  "properties": {
                    "draftCountsVersion": {
                      "const": "draft-counts-v2"
                    }
                  },
                  "required": [
                    "draftCountsVersion"
                  ],
                  "type": "object"
                }
              },
              "type": "object"
            }
          ]
        },
        "groupCounts": {
          "$ref": "#/$defs/groupCounts"
        },
        "defaultRuleId": {
          "$ref": "automation-insight-coding.schema.json#/$defs/uuid"
        },
        "defaultRuleSha256": {
          "$ref": "automation-insight-coding.schema.json#/$defs/digest"
        },
        "codebookSha256": {
          "$ref": "automation-insight-coding.schema.json#/$defs/digest"
        },
        "executionId": {
          "$ref": "automation-insight-coding.schema.json#/$defs/uuid"
        }
      }
    },
    "privateDefaultDraftSnapshot": {
      "title": "AutomationInsightCodingPrivateDefaultDraftSnapshot",
      "description": "Exact unapproved source-default proposal; storage compatibility root is not human adoption.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "binding",
        "selection",
        "proposalSha256",
        "receipts",
        "draftSelection",
        "output",
        "groupCounts",
        "defaultRuleId",
        "defaultRuleSha256",
        "codebookSha256",
        "executionId",
        "privateSource"
      ],
      "properties": {
        "contractVersion": {
          "const": "automation-insight-coding-snapshot-v5"
        },
        "binding": {
          "$ref": "private-insight-source-projection.schema.json#/$defs/binding"
        },
        "selection": {
          "title": "InsightDraftSelectionEcho",
          "description": "Explicit empty selection echo of a versioned draft selection.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "proposalId",
            "receiptIds"
          ],
          "properties": {
            "proposalId": {
              "type": "string",
              "format": "uuid"
            },
            "receiptIds": {
              "type": "array",
              "maxItems": 0
            }
          }
        },
        "proposalSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "receipts": {
          "type": "array",
          "maxItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "receiptId",
              "sha256"
            ],
            "properties": {
              "receiptId": {
                "type": "string",
                "format": "uuid"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "draftSelection": {
          "$ref": "automation-insight-report-revision.schema.json#/$defs/defaultSelection"
        },
        "output": {
          "$ref": "located-insight-methods.schema.json",
          "allOf": [
            {
              "properties": {
                "input": {
                  "properties": {
                    "draftCountsVersion": {
                      "const": "draft-counts-v2"
                    }
                  },
                  "required": [
                    "draftCountsVersion"
                  ],
                  "type": "object"
                }
              },
              "type": "object"
            }
          ]
        },
        "groupCounts": {
          "$ref": "#/$defs/groupCounts"
        },
        "defaultRuleId": {
          "$ref": "automation-insight-coding.schema.json#/$defs/uuid"
        },
        "defaultRuleSha256": {
          "$ref": "automation-insight-coding.schema.json#/$defs/digest"
        },
        "codebookSha256": {
          "$ref": "automation-insight-coding.schema.json#/$defs/digest"
        },
        "executionId": {
          "$ref": "automation-insight-coding.schema.json#/$defs/uuid"
        },
        "privateSource": {
          "$ref": "private-insight-source-projection.schema.json"
        }
      }
    }
  }
}
