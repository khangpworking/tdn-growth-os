{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdn.local/contracts/analysis/automation-insight-coding-snapshot.schema.json",
  "title": "AutomationInsightCodingSnapshot",
  "description": "Retained coding snapshot: accepted receipts (v1, legacy) or one versioned receipt-free draft selection (v2). Exactly one branch validates; historical v1 payloads match only the accepted branch.",
  "oneOf": [{ "$ref": "#/$defs/acceptedSnapshot" }, { "$ref": "#/$defs/draftSnapshot" }],
  "$defs": {
    "acceptedSnapshot": {
      "title": "AutomationInsightCodingAcceptedSnapshot",
      "type": "object", "additionalProperties": false,
      "required": ["contractVersion", "binding", "selection", "adoptionId", "proposalSha256", "receipts", "output"],
      "properties": {
        "contractVersion": { "const": "automation-insight-coding-snapshot-v1" },
        "selectionContractVersion": { "const": "automation-insight-selection-v2" },
        "binding": { "$ref": "automation-insight-coding.schema.json#/$defs/binding" },
        "selection": { "$ref": "automation-insight-report-revision.schema.json#/$defs/selection" },
        "adoptionId": { "type": "string", "format": "uuid" },
        "proposalSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "receipts": {
          "type": "array", "minItems": 1, "maxItems": 1000,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["receiptId", "sha256"],
            "properties": { "receiptId": { "type": "string", "format": "uuid" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
          }
        },
        "output": { "$ref": "located-insight-methods.schema.json" }
      }
    },
    "draftSnapshot": {
      "title": "AutomationInsightCodingDraftSnapshot",
      "description": "Zero receipts by construction with an explicit draft selection echo. Never an implicit latest, never approval.",
      "type": "object", "additionalProperties": false,
      "required": ["contractVersion", "binding", "selection", "adoptionId", "proposalSha256", "receipts", "draftSelection", "output"],
      "properties": {
        "contractVersion": { "const": "automation-insight-coding-snapshot-v2" },
        "binding": { "$ref": "automation-insight-coding.schema.json#/$defs/binding" },
        "selection": {
          "title": "InsightDraftSelectionEcho",
          "description": "Explicit empty selection echo of a versioned draft selection.",
          "type": "object", "additionalProperties": false,
          "required": ["proposalId", "receiptIds"],
          "properties": {
            "proposalId": { "type": "string", "format": "uuid" },
            "receiptIds": { "type": "array", "maxItems": 0 }
          }
        },
        "adoptionId": { "type": "string", "format": "uuid" },
        "proposalSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "receipts": {
          "type": "array", "maxItems": 0,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["receiptId", "sha256"],
            "properties": { "receiptId": { "type": "string", "format": "uuid" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
          }
        },
        "draftSelection": { "$ref": "automation-insight-report-revision.schema.json#/$defs/draftSelection" },
        "output": { "$ref": "located-insight-methods.schema.json" }
      }
    }
  }
}
