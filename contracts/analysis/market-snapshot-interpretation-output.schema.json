{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdn.local/contracts/analysis/market-snapshot-interpretation-output.schema.json",
  "title": "MarketSnapshotInterpretationOutput",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "findings", "uncertainties"],
  "properties": {
    "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "findings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "statement", "citations"],
        "properties": {
          "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$" },
          "statement": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "citations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 200 }
          }
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "maxItems": 12,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    }
  }
}
