{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdn.local/contracts/analysis/tiktok-coding-proposal-v1.schema.json",
  "title": "TikTokCodingProposalV1",
  "description": "Run/source-bound draft coding of a retained S07 TikTok comment corpus. Only eligible INCLUDED CUSTOMER records are coded, with exact retained quotes; seller/creator/reply/tag/emoji/conflict/excluded/unclear rows stay reasoned evidence outside primary counts. Counts are proposed and await owner review, never human approval. No raw author identity, key material, cross-platform joins, population estimates, personas, or second classification. Source period remains unknown/unverified.",
  "oneOf": [
    {
      "$ref": "#/$defs/proposeRequest"
    },
    {
      "$ref": "#/$defs/draftCoding"
    },
    {
      "$ref": "#/$defs/receipt"
    },
    {
      "$ref": "#/$defs/history"
    },
    {
      "$ref": "#/$defs/report"
    },
    {
      "$ref": "#/$defs/readView"
    },
    {
      "$ref": "#/$defs/context"
    },
    {
      "$ref": "#/$defs/consumptionView"
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "binding": {
      "title": "TikTokCodingBinding",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaceId",
        "runId",
        "scopeSha256",
        "sourceSetSha256",
        "requestedPeriod"
      ],
      "properties": {
        "workspaceId": {
          "$ref": "#/$defs/uuid"
        },
        "runId": {
          "$ref": "#/$defs/uuid"
        },
        "scopeSha256": {
          "$ref": "#/$defs/digest"
        },
        "sourceSetSha256": {
          "$ref": "#/$defs/digest"
        },
        "requestedPeriod": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "startDate",
            "endDate"
          ],
          "properties": {
            "startDate": {
              "type": "string",
              "format": "date"
            },
            "endDate": {
              "type": "string",
              "format": "date"
            }
          }
        }
      }
    },
    "corpusIdentity": {
      "title": "TikTokCodingCorpusIdentity",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageId",
        "manifestArtifactSha256",
        "packageContentSha256"
      ],
      "properties": {
        "packageId": {
          "$ref": "#/$defs/uuid"
        },
        "manifestArtifactSha256": {
          "$ref": "#/$defs/digest"
        },
        "packageContentSha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "contextCounts": {
      "title": "TikTokCodingContextCounts",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible",
        "excluded",
        "unclear"
      ],
      "properties": {
        "eligible": {
          "type": "integer",
          "minimum": 0
        },
        "excluded": {
          "type": "integer",
          "minimum": 0
        },
        "unclear": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "context": {
      "title": "TikTokCodingContextView",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "binding",
        "corpus",
        "keywordDigest",
        "counts"
      ],
      "properties": {
        "contractVersion": {
          "const": "tiktok-coding-context-v1"
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "corpus": {
          "$ref": "#/$defs/corpusIdentity"
        },
        "keywordDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "counts": {
          "$ref": "#/$defs/contextCounts"
        }
      }
    },
    "consumptionEntry": {
      "title": "TikTokConsumptionEntry",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revisionId",
        "reportIdentitySha256",
        "corpusPackageId",
        "corpusPackageContentSha256",
        "codingDraftSha256",
        "actorId",
        "consumedAt"
      ],
      "properties": {
        "revisionId": {
          "type": "string",
          "format": "uuid"
        },
        "reportIdentitySha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "corpusPackageId": {
          "type": "string",
          "format": "uuid"
        },
        "corpusPackageContentSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "codingDraftSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "actorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "consumedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "consumptionView": {
      "title": "TikTokConsumptionView",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "entries"
      ],
      "properties": {
        "contractVersion": {
          "const": "tiktok-consumption-view-v1"
        },
        "entries": {
          "type": "array",
          "items": {
            "title": "TikTokConsumptionEntry",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "revisionId",
              "reportIdentitySha256",
              "corpusPackageId",
              "corpusPackageContentSha256",
              "codingDraftSha256",
              "actorId",
              "consumedAt"
            ],
            "properties": {
              "revisionId": {
                "type": "string",
                "format": "uuid"
              },
              "reportIdentitySha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "corpusPackageId": {
                "type": "string",
                "format": "uuid"
              },
              "corpusPackageContentSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "codingDraftSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "actorId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "consumedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    "proposeRequest": {
      "title": "TikTokCodingProposeRequest",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "requestKey",
        "binding",
        "corpus",
        "keywordDigest"
      ],
      "properties": {
        "contractVersion": {
          "const": "tiktok-coding-propose-v1"
        },
        "requestKey": {
          "$ref": "#/$defs/uuid"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "corpus": {
          "$ref": "#/$defs/corpusIdentity"
        },
        "keywordDigest": {
          "$ref": "#/$defs/digest"
        },
        "recordIndexes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6000,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "quote": {
      "title": "TikTokCodingQuote",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "start",
        "end"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "code": {
      "title": "TikTokDraftCode",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "label",
        "recordIndex",
        "quote",
        "citationId"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Z0-9][A-Z0-9_]{0,79}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "recordIndex": {
          "type": "integer",
          "minimum": 0
        },
        "quote": {
          "$ref": "#/$defs/quote"
        },
        "citationId": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "draftCoding": {
      "title": "TikTokDraftCoding",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "proposalId",
        "requestKey",
        "binding",
        "corpus",
        "keywordDigest",
        "promptVersion",
        "codes",
        "counts",
        "status",
        "limitations"
      ],
      "properties": {
        "contractVersion": {
          "const": "tiktok-draft-coding-v1"
        },
        "proposalId": {
          "$ref": "#/$defs/uuid"
        },
        "requestKey": {
          "$ref": "#/$defs/uuid"
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "corpus": {
          "$ref": "#/$defs/corpusIdentity"
        },
        "keywordDigest": {
          "$ref": "#/$defs/digest"
        },
        "promptVersion": {
          "const": "tiktok-coding-prompt-v1"
        },
        "codes": {
          "type": "array",
          "minItems": 0,
          "maxItems": 6000,
          "items": {
            "$ref": "#/$defs/code"
          }
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "recordsCoded",
            "codesProposed",
            "quotesCited"
          ],
          "properties": {
            "recordsCoded": {
              "type": "integer",
              "minimum": 0
            },
            "codesProposed": {
              "type": "integer",
              "minimum": 0
            },
            "quotesCited": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "status": {
          "const": "PROPOSED_AWAITING_REVIEW"
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "report": {
      "title": "TikTokCodedReport",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "proposalId",
        "draftSha256",
        "corpus",
        "keywordDigest",
        "findings",
        "counts",
        "status",
        "limitations"
      ],
      "properties": {
        "contractVersion": {
          "const": "tiktok-coded-report-v1"
        },
        "proposalId": {
          "type": "string",
          "format": "uuid"
        },
        "draftSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "corpus": {
          "$ref": "#/$defs/corpusIdentity"
        },
        "keywordDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "findings": {
          "type": "array",
          "minItems": 0,
          "maxItems": 6,
          "items": {
            "title": "TikTokCodedFinding",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sectionId",
              "code",
              "label",
              "template",
              "status",
              "scope",
              "citations"
            ],
            "properties": {
              "sectionId": {
                "enum": [
                  "I02",
                  "I10",
                  "I17"
                ]
              },
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[A-Z0-9][A-Z0-9_]{0,79}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "template": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "status": {
                "const": "PROPOSED_AWAITING_REVIEW"
              },
              "scope": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "citations": {
                "type": "array",
                "minItems": 1,
                "maxItems": 6000,
                "items": {
                  "title": "TikTokFindingCitation",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "citationId",
                    "locator",
                    "url"
                  ],
                  "properties": {
                    "citationId": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "locator": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    },
                    "url": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 2000
                    }
                  }
                }
              }
            }
          }
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "recordsCoded",
            "codesProposed",
            "quotesCited"
          ],
          "properties": {
            "recordsCoded": {
              "type": "integer",
              "minimum": 0
            },
            "codesProposed": {
              "type": "integer",
              "minimum": 0
            },
            "quotesCited": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "status": {
          "const": "PROPOSED_AWAITING_REVIEW"
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "readCitation": {
      "title": "TikTokReadCitation",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "citationId",
        "locator",
        "url"
      ],
      "properties": {
        "citationId": {
          "type": "integer",
          "minimum": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        }
      }
    },
    "readView": {
      "title": "TikTokCodingReadView",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "draft",
        "report",
        "citations",
        "finalizedAt"
      ],
      "properties": {
        "contractVersion": {
          "const": "tiktok-coding-read-v1"
        },
        "draft": {
          "$ref": "#/$defs/draftCoding"
        },
        "report": {
          "$ref": "#/$defs/report"
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/readCitation"
          }
        },
        "finalizedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "receipt": {
      "title": "TikTokCodingReceipt",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "proposalId",
        "requestKey",
        "exactRetry"
      ],
      "properties": {
        "contractVersion": {
          "const": "tiktok-coding-receipt-v1"
        },
        "proposalId": {
          "$ref": "#/$defs/uuid"
        },
        "requestKey": {
          "$ref": "#/$defs/uuid"
        },
        "exactRetry": {
          "type": "boolean"
        }
      }
    },
    "history": {
      "title": "TikTokCodingHistory",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "sources"
      ],
      "properties": {
        "contractVersion": {
          "const": "tiktok-coding-history-v1"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "proposalId",
              "requestKey",
              "packageId",
              "manifestArtifactSha256",
              "packageContentSha256",
              "createdAt",
              "status"
            ],
            "properties": {
              "proposalId": {
                "$ref": "#/$defs/uuid"
              },
              "requestKey": {
                "$ref": "#/$defs/uuid"
              },
              "packageId": {
                "type": "string",
                "format": "uuid"
              },
              "manifestArtifactSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "packageContentSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "createdAt": {
                "type": "string",
                "format": "date-time"
              },
              "status": {
                "const": "PROPOSED_AWAITING_REVIEW"
              }
            }
          }
        }
      }
    }
  }
}
