{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdn.local/contracts/orchestrator/analysis-backed-proposal-submission.schema.json",
  "title": "AnalysisBackedProposalSubmission",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "proposalKey", "proposalVersion", "proposalType", "sourceAuditId", "objective", "proposal", "requestedNextStep"],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "proposalKey": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{2,79}$" },
    "proposalVersion": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "proposalType": { "const": "research_evidence_review_v1" },
    "sourceAuditId": { "type": "string", "format": "uuid" },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "statement"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$" },
        "statement": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "summary", "rationale", "evidenceLinks", "openQuestions"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "evidenceLinks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claimCode", "use", "note"],
            "properties": {
              "claimCode": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$" },
              "use": { "enum": ["support", "risk", "uncertainty"] },
              "note": { "type": "string", "minLength": 1, "maxLength": 800 }
            }
          }
        },
        "openQuestions": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 800 }
        }
      }
    },
    "requestedNextStep": { "const": "request_human_review" }
  }
}
