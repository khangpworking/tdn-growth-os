{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdn.local/contracts/flow/content-package-version-request.schema.json",
  "title": "ContentPackageVersionRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "packageId", "requestId", "part", "expectedVersion", "action"],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "packageId": { "type": "string", "format": "uuid" },
    "requestId": { "type": "string", "format": "uuid" },
    "part": { "$ref": "content-package-generate-request.schema.json#/$defs/part" },
    "expectedVersion": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "action": { "title": "ContentPackageVersionAction", "enum": ["MANUAL", "RESTORE"] },
    "post": { "type": "string", "minLength": 1, "maxLength": 4000, "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$" },
    "restoreVersion": { "type": "integer", "minimum": 1, "maximum": 10000 }
  }
}
