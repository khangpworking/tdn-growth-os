{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdn.local/contracts/flow/content-campaign-create-request.schema.json",
  "title": "ContentCampaignCreateRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "campaignKey", "brandId", "campaign"],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "campaignKey": { "$ref": "#/$defs/campaignKey" },
    "brandId": { "type": "string", "format": "uuid" },
    "campaign": { "$ref": "#/$defs/campaign" }
  },
  "$defs": {
    "campaignKey": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{2,79}$" },
    "campaign": {
      "title": "ContentCampaignContent",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "objective", "items"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$" },
        "objective": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$" },
        "items": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/item" } },
        "researchProductWorkspaceId": { "type": "string", "format": "uuid" }
      }
    },
    "item": {
      "title": "ContentCampaignItemRef",
      "type": "object",
      "additionalProperties": false,
      "required": ["itemId", "itemVersion"],
      "properties": {
        "itemId": { "type": "string", "format": "uuid" },
        "itemVersion": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "tierKeys": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$" } }
      }
    }
  }
}
