{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdn.local/contracts/flow/content-campaign-artifact.schema.json",
  "title": "ContentCampaignArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "campaignId", "campaignKey", "brandId", "version", "campaign", "createdAt", "requestSha256"],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "campaignId": { "type": "string", "format": "uuid" },
    "campaignKey": { "$ref": "content-campaign-create-request.schema.json#/$defs/campaignKey" },
    "brandId": { "type": "string", "format": "uuid" },
    "version": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "campaign": { "$ref": "content-campaign-create-request.schema.json#/$defs/campaign" },
    "createdAt": { "type": "string", "format": "date-time" },
    "requestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
