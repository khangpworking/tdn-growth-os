{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdn.local/contracts/flow/discovery-workspace-request.schema.json",
  "title": "DiscoveryWorkspaceRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "workspaceKey", "title"],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "workspaceKey": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{2,79}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$" },
    "description": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$" }
  }
}
