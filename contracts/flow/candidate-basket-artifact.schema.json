{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdn.local/contracts/flow/candidate-basket-artifact.schema.json",
  "title": "CandidateBasketArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "basketId", "workspaceId", "basketKey", "version", "frozenAt", "requestSha256", "candidates"],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "basketId": { "type": "string", "format": "uuid" },
    "workspaceId": { "type": "string", "format": "uuid" },
    "basketKey": { "$ref": "candidate-basket-freeze-request.schema.json#/properties/basketKey" },
    "version": { "$ref": "candidate-basket-freeze-request.schema.json#/properties/version" },
    "frozenAt": { "type": "string", "format": "date-time" },
    "requestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidateId", "candidateKey", "candidateVersion", "candidateArtifactSha256", "label", "state"],
        "properties": {
          "candidateId": { "type": "string", "format": "uuid" },
          "candidateKey": { "$ref": "product-candidate-create-request.schema.json#/properties/candidateKey" },
          "candidateVersion": { "$ref": "candidate-basket-freeze-request.schema.json#/properties/version" },
          "candidateArtifactSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "label": { "$ref": "product-candidate-create-request.schema.json#/properties/label" },
          "summary": { "$ref": "product-candidate-create-request.schema.json#/properties/summary" },
          "state": { "const": "EXPLORING" }
        }
      }
    }
  }
}
