{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdn.local/contracts/flow/stp-content.schema.json",
  "title": "StpContent",
  "type": "object",
  "additionalProperties": false,
  "required": ["segments", "primaryTargetSegmentKey", "positioningStatement"],
  "properties": {
    "segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/segment" }
    },
    "primaryTargetSegmentKey": { "$ref": "#/$defs/segmentKey" },
    "secondaryTargetSegmentKeys": {
      "type": "array",
      "maxItems": 99,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/segmentKey" }
    },
    "positioningStatement": { "type": "string", "minLength": 1, "maxLength": 4000, "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$" }
  },
  "$defs": {
    "segmentKey": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{2,79}$" },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label"],
      "properties": {
        "key": { "$ref": "#/$defs/segmentKey" },
        "label": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$" },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$" }
      }
    }
  }
}
