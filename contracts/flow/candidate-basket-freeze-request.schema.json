{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdn.local/contracts/flow/candidate-basket-freeze-request.schema.json",
  "title": "CandidateBasketFreezeRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "workspaceId", "basketKey", "version", "candidates"],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "workspaceId": { "type": "string", "format": "uuid" },
    "basketKey": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{2,79}$" },
    "version": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidateId", "candidateVersion"],
        "properties": {
          "candidateId": { "type": "string", "format": "uuid" },
          "candidateVersion": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
        }
      }
    }
  }
}
