{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdn.local/contracts/api/research-automation-meta-page-api.schema.json",
  "title": "ResearchAutomationMetaPageApi",
  "oneOf": [
    {
      "$ref": "#/$defs/prepare"
    },
    {
      "$ref": "#/$defs/confirm"
    },
    {
      "$ref": "#/$defs/view"
    },
    {
      "$ref": "#/$defs/history"
    }
  ],
  "$defs": {
    "prepare": {
      "title": "MetaPagePrepareRequest",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "requestKey",
        "expectedRevision",
        "selection",
        "htmlBase64",
        "visibleFieldsBase64"
      ],
      "properties": {
        "contractVersion": {
          "const": "meta-page-prepare-v1"
        },
        "requestKey": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "selection": {
          "$ref": "../analysis/meta-page-source-v1.schema.json#/$defs/selection"
        },
        "htmlBase64": {
          "type": "string",
          "minLength": 4,
          "maxLength": 11184812
        },
        "visibleFieldsBase64": {
          "type": "string",
          "minLength": 4,
          "maxLength": 11184812
        }
      }
    },
    "confirm": {
      "title": "MetaPageConfirmRequest",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "requestKey",
        "expectedRevision",
        "packageId"
      ],
      "properties": {
        "contractVersion": {
          "const": "meta-page-confirm-v1"
        },
        "requestKey": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "packageId": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "view": {
      "title": "MetaPageSourceView",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "state",
        "prepared",
        "confirmation",
        "binding",
        "projection",
        "runtimeCollector",
        "capture"
      ],
      "properties": {
        "contractVersion": {
          "const": "meta-page-view-v1"
        },
        "state": {
          "enum": [
            "PREPARED",
            "CONFIRMED"
          ]
        },
        "prepared": {
          "$ref": "../analysis/meta-page-source-v1.schema.json#/$defs/package"
        },
        "confirmation": {
          "anyOf": [
            {
              "$ref": "../analysis/meta-page-source-v1.schema.json#/$defs/package"
            },
            {
              "type": "null"
            }
          ]
        },
        "binding": {
          "$ref": "../analysis/meta-page-source-v1.schema.json#/$defs/binding"
        },
        "projection": {
          "$ref": "../analysis/meta-page-source-v1.schema.json#/$defs/projection"
        },
        "runtimeCollector": {
          "const": "UNAVAILABLE_OPENCLI_CONTRACT_MISSING"
        },
        "capture": {
          "$ref": "../analysis/meta-page-source-v1.schema.json#/$defs/capture"
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/view"
      },
      "maxItems": 1000
    }
  }
}
