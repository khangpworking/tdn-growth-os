{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdn.local/contracts/api/research-automation-revision-api.schema.json",
  "title": "ResearchAutomationRevisionApiContract",
  "oneOf": [
    { "$ref": "../analysis/automation-report-revision.schema.json" },
    { "$ref": "#/$defs/cancelRequest" },
    { "$ref": "#/$defs/versionList" },
    { "$ref": "#/$defs/attemptList" },
    { "$ref": "#/$defs/receipt" }
  ],
  "$defs": {
    "uuid": { "$ref": "research-automation-api.schema.json#/$defs/uuid" },
    "digest": { "$ref": "research-automation-api.schema.json#/$defs/digest" },
    "cancelRequest": {
      "title": "ResearchAutomationRevisionCancelRequest",
      "type": "object", "additionalProperties": false,
      "required": ["contractVersion", "requestKey"],
      "properties": {
        "contractVersion": { "const": "automation-report-revision-cancel-v1" },
        "requestKey": { "$ref": "research-automation-api.schema.json#/$defs/requestKey" }
      }
    },
    "output": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "versionId", "pdfAvailable"],
      "properties": {
        "kind": { "enum": ["MARKET", "INSIGHT"] },
        "versionId": { "$ref": "#/$defs/digest" },
        "pdfAvailable": { "type": "boolean" }
      }
    },
    "pair": {
      "title": "ResearchAutomationReportPair",
      "type": "object", "additionalProperties": false,
      "required": ["pairId", "versionNumber", "attemptId", "outputs"],
      "properties": {
        "pairId": { "$ref": "#/$defs/digest" },
        "versionNumber": { "type": "integer", "minimum": 1 },
        "attemptId": { "anyOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "outputs": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "$ref": "#/$defs/output" } }
      }
    },
    "versionList": {
      "title": "ResearchAutomationReportVersionList",
      "type": "object", "additionalProperties": false,
      "required": ["contractVersion", "workspaceId", "runId", "versions"],
      "properties": {
        "contractVersion": { "const": "automation-report-version-list-v1" },
        "workspaceId": { "$ref": "#/$defs/uuid" },
        "runId": { "$ref": "#/$defs/uuid" },
        "versions": { "type": "array", "items": { "$ref": "#/$defs/pair" } }
      }
    },
    "attemptList": {
      "title": "ResearchAutomationReportAttemptList",
      "type": "object", "additionalProperties": false,
      "required": ["contractVersion", "workspaceId", "runId", "attempts"],
      "properties": {
        "contractVersion": { "const": "automation-report-attempt-list-v1" },
        "workspaceId": { "$ref": "#/$defs/uuid" },
        "runId": { "$ref": "#/$defs/uuid" },
        "attempts": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/receipt" } }
      }
    },
    "receipt": {
      "title": "ResearchAutomationRevisionReceipt",
      "type": "object", "additionalProperties": false,
      "required": ["attemptId", "attemptNumber", "state", "pairId", "exactRetry"],
      "properties": {
        "attemptId": { "$ref": "#/$defs/uuid" },
        "attemptNumber": { "type": "integer", "minimum": 1 },
        "state": { "enum": ["QUEUED", "RUNNING", "COMMITTED", "FAILED", "CANCELLED"] },
        "pairId": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "exactRetry": { "type": "boolean" }
      }
    }
  }
}
