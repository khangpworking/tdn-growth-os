{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdn.local/contracts/api/owner-product-workspace-api.schema.json",
  "title": "OwnerProductWorkspaceApiContract",
  "oneOf": [{ "$ref": "#/$defs/request" }, { "$ref": "#/$defs/receipt" }, { "$ref": "#/$defs/error" }],
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "request": {
      "title": "OwnerProductWorkspaceRequest", "type": "object", "additionalProperties": false,
      "required": ["contractVersion", "productWorkspaceKey"],
      "properties": {
        "contractVersion": { "const": "1.0.0" },
        "productWorkspaceKey": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{2,79}$" }
      }
    },
    "receipt": {
      "title": "OwnerProductWorkspaceReceipt", "type": "object", "additionalProperties": false,
      "required": ["contractVersion", "productWorkspaceId", "productWorkspaceKey", "workspaceId", "basketId", "candidateId", "candidateVersion", "b7DecisionId", "state", "entryStep", "title", "createdAt", "exactRetry"],
      "properties": {
        "contractVersion": { "const": "1.0.0" }, "productWorkspaceId": { "$ref": "#/$defs/uuid" },
        "productWorkspaceKey": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{2,79}$" },
        "workspaceId": { "$ref": "#/$defs/uuid" }, "basketId": { "$ref": "#/$defs/uuid" },
        "candidateId": { "$ref": "#/$defs/uuid" }, "candidateVersion": { "type": "integer", "minimum": 1 },
        "b7DecisionId": { "$ref": "#/$defs/uuid" },
        "state": { "const": "ACTIVE" }, "entryStep": { "const": "B8" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" }, "exactRetry": { "type": "boolean" }
      }
    },
    "error": {
      "title": "OwnerProductWorkspaceApiErrorResponse", "type": "object", "additionalProperties": false, "required": ["error"],
      "properties": { "error": { "type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": {
        "code": { "enum": ["bad_request", "unauthorized", "forbidden", "not_found", "method_not_allowed", "conflict", "integrity_error"] }, "message": { "type": "string" }
      } } }
    }
  }
}
