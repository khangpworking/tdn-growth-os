{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdn.local/contracts/api/report-api.schema.json",
  "title": "Research report read API responses",
  "oneOf": [
    { "$ref": "#/$defs/index" },
    { "$ref": "#/$defs/history" },
    { "$ref": "#/$defs/interpretationIndex" },
    { "$ref": "#/$defs/interpretationDetail" },
    { "$ref": "../analysis/report-review-target.schema.json" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "dateTime": { "type": "string", "format": "date-time" },
    "series": {
      "title": "ReportSeriesSummary",
      "type": "object",
      "additionalProperties": false,
      "required": ["reportId", "reportKey", "createdAt"],
      "properties": {
        "reportId": { "$ref": "#/$defs/uuid" },
        "reportKey": { "type": "string", "minLength": 1, "maxLength": 120 },
        "createdAt": { "$ref": "#/$defs/dateTime" }
      }
    },
    "index": {
      "title": "WorkspaceReportIndexResponse",
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "workspaceId", "reports"],
      "properties": {
        "contractVersion": { "const": "1.0.0" },
        "workspaceId": { "$ref": "#/$defs/uuid" },
        "reports": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/series" } }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "platform", "selection", "start", "end", "periodBasis", "acquiredAt"],
      "properties": {
        "key": { "type": "string" },
        "platform": { "enum": ["shopee", "tiktok"] },
        "selection": { "enum": ["ON", "OFF", "UNSPECIFIED"] },
        "start": { "type": "string", "format": "date" },
        "end": { "type": "string", "format": "date" },
        "periodBasis": { "type": "string" },
        "acquiredAt": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/dateTime" }] }
      }
    },
    "sectionCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "partialDeterministicDraft", "methodOnly", "blocked", "manualReviewRequired", "notImplemented"],
      "properties": {
        "total": { "type": "integer", "minimum": 1, "maximum": 100 },
        "partialDeterministicDraft": { "type": "integer", "minimum": 0, "maximum": 100 },
        "methodOnly": { "type": "integer", "minimum": 0, "maximum": 100 },
        "blocked": { "type": "integer", "minimum": 0, "maximum": 100 },
        "manualReviewRequired": { "type": "integer", "minimum": 0, "maximum": 100 },
        "notImplemented": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "mediaType", "byteSize"],
      "properties": {
        "fileName": { "type": "string", "pattern": "^[a-z0-9._-]{1,120}$" },
        "mediaType": { "type": "string" },
        "byteSize": { "type": "integer", "minimum": 0, "maximum": 33554432 }
      }
    },
    "version": {
      "title": "ReportVersionSummary",
      "type": "object",
      "additionalProperties": false,
      "required": ["versionId", "version", "previousSemanticVersionId", "semanticVersionId", "createdAt", "status", "interpretationState", "reviewState", "scope", "sectionCounts", "selectedSourceCount", "artifacts"],
      "properties": {
        "versionId": { "$ref": "#/$defs/uuid" },
        "version": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "previousSemanticVersionId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] },
        "semanticVersionId": { "$ref": "#/$defs/digest" },
        "createdAt": { "$ref": "#/$defs/dateTime" },
        "status": { "const": "DRAFT" },
        "interpretationState": { "const": "NONE" },
        "reviewState": { "const": "UNREVIEWED" },
        "scope": { "$ref": "#/$defs/scope" },
        "sectionCounts": { "$ref": "#/$defs/sectionCounts" },
        "selectedSourceCount": { "type": "integer", "minimum": 2, "maximum": 20 },
        "artifacts": { "type": "array", "minItems": 1, "maxItems": 40, "items": { "$ref": "#/$defs/artifact" } }
      }
    },
    "history": {
      "title": "ReportHistoryResponse",
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "reportId", "reportKey", "workspaceId", "versions"],
      "properties": {
        "contractVersion": { "const": "1.0.0" },
        "reportId": { "$ref": "#/$defs/uuid" },
        "reportKey": { "type": "string", "minLength": 1, "maxLength": 120 },
        "workspaceId": { "$ref": "#/$defs/uuid" },
        "versions": { "type": "array", "minItems": 1, "maxItems": 10000, "items": { "$ref": "#/$defs/version" } }
      }
    },
    "interpretationSummary": {
      "title": "ReportInterpretationSummary",
      "type": "object",
      "additionalProperties": false,
      "required": ["interpretationId", "interpretationNumber", "interpretationContentSha256", "completedAt", "storedAt", "sourceSemanticVersionId", "sourcePacketId", "providerId", "modelId", "promptId", "promptVersion", "itemCount", "sectionIds"],
      "properties": {
        "interpretationId": { "$ref": "#/$defs/uuid" },
        "interpretationNumber": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "interpretationContentSha256": { "$ref": "#/$defs/digest" },
        "completedAt": { "$ref": "#/$defs/dateTime" },
        "storedAt": { "$ref": "#/$defs/dateTime" },
        "sourceSemanticVersionId": { "$ref": "#/$defs/digest" },
        "sourcePacketId": { "$ref": "#/$defs/digest" },
        "providerId": { "type": "string", "minLength": 1, "maxLength": 120 },
        "modelId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "promptId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "promptVersion": { "type": "integer", "minimum": 1 },
        "itemCount": { "type": "integer", "minimum": 1, "maximum": 30 },
        "sectionIds": {
          "type": "array", "minItems": 1, "maxItems": 30, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[MI][0-9]{2,3}$" }
        }
      }
    },
    "interpretationIndex": {
      "title": "ReportInterpretationIndexResponse",
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "reportId", "reportVersion", "interpretations"],
      "properties": {
        "contractVersion": { "const": "1.0.0" },
        "reportId": { "$ref": "#/$defs/uuid" },
        "reportVersion": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "interpretations": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/interpretationSummary" } }
      }
    },
    "interpretationSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semanticVersionId", "packetId", "packetSha256", "claimsSha256"],
      "properties": {
        "semanticVersionId": { "$ref": "#/$defs/digest" },
        "packetId": { "$ref": "#/$defs/digest" },
        "packetSha256": { "$ref": "#/$defs/digest" },
        "claimsSha256": { "$ref": "#/$defs/digest" }
      }
    },
    "interpretationGeneration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerId", "modelId", "promptId", "promptVersion", "outputSchemaVersion"],
      "properties": {
        "providerId": { "type": "string", "minLength": 1, "maxLength": 120 },
        "modelId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "promptId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "promptVersion": { "type": "integer", "minimum": 1 },
        "outputSchemaVersion": { "const": "1.0.0" }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimId", "sectionId", "statementKind", "scopeKey", "value", "unit", "metricPointer", "scopePointer", "membershipPointer", "denominatorPointer", "coveragePointer", "limitations"],
      "properties": {
        "claimId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "sectionId": { "type": "string", "pattern": "^[MI][0-9]{2,3}$" },
        "statementKind": { "enum": ["LISTING_COUNT", "SHOP_COUNT", "OBSERVED_REVENUE", "OBSERVED_UNITS", "TOP_SHOP_SHARE"] },
        "scopeKey": { "enum": ["all", "wide", "core"] },
        "value": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 80 }, { "type": "integer", "minimum": 0 }] },
        "unit": { "enum": ["listing", "shop", "VND", "unit", "percent"] },
        "metricPointer": { "type": "string", "pattern": "^/", "maxLength": 400 },
        "scopePointer": { "const": "/input/scope" },
        "membershipPointer": { "type": "string", "pattern": "^/", "maxLength": 400 },
        "denominatorPointer": { "oneOf": [{ "type": "string", "pattern": "^/", "maxLength": 400 }, { "type": "null" }] },
        "coveragePointer": { "oneOf": [{ "type": "string", "pattern": "^/", "maxLength": 400 }, { "type": "null" }] },
        "limitations": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 200 } }
      }
    },
    "interpretationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemId", "sectionId", "kind", "conclusion", "evidenceLogic", "supportingClaimIds", "citations", "assumptions", "limitations"],
      "properties": {
        "itemId": { "$ref": "#/$defs/digest" },
        "sectionId": { "type": "string", "pattern": "^[MI][0-9]{2,3}$" },
        "kind": { "enum": ["INTERPRETATION", "HYPOTHESIS"] },
        "conclusion": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "evidenceLogic": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "supportingClaimIds": { "type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 100 } },
        "citations": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/citation" } },
        "assumptions": { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 400 } },
        "limitations": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 400 } }
      }
    },
    "interpretationDetailRecord": {
      "title": "ReportInterpretationDetail",
      "type": "object",
      "additionalProperties": false,
      "required": ["interpretationId", "interpretationNumber", "interpretationContentSha256", "completedAt", "storedAt", "source", "generation", "items", "limitations"],
      "properties": {
        "interpretationId": { "$ref": "#/$defs/uuid" },
        "interpretationNumber": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "interpretationContentSha256": { "$ref": "#/$defs/digest" },
        "completedAt": { "$ref": "#/$defs/dateTime" },
        "storedAt": { "$ref": "#/$defs/dateTime" },
        "source": { "$ref": "#/$defs/interpretationSource" },
        "generation": { "$ref": "#/$defs/interpretationGeneration" },
        "items": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "$ref": "#/$defs/interpretationItem" } },
        "limitations": { "type": "array", "minItems": 2, "maxItems": 12, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 200 } }
      }
    },
    "interpretationDetail": {
      "title": "ReportInterpretationDetailResponse",
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "reportId", "reportVersion", "interpretation"],
      "properties": {
        "contractVersion": { "const": "1.0.0" },
        "reportId": { "$ref": "#/$defs/uuid" },
        "reportVersion": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "interpretation": { "$ref": "#/$defs/interpretationDetailRecord" }
      }
    },
    "error": {
      "title": "ReportApiErrorResponse",
      "type": "object",
      "additionalProperties": false,
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "enum": ["bad_request", "not_found", "method_not_allowed", "integrity_error"] },
            "message": { "type": "string" }
          }
        }
      }
    }
  }
}
