{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdn.local/contracts/api/research-automation-insight-coding-api.schema.json",
  "title": "ResearchAutomationInsightCodingApi",
  "description": "OWNER HTTP boundary for exact-source Insight coding. Requests reuse the closed domain contracts; the server supplies the trusted OWNER actor. Views are verified pair history, never an implicit latest selection or report admission.",
  "oneOf": [
    {
      "$ref": "#/$defs/adoptRequest"
    },
    {
      "$ref": "#/$defs/proposeRequest"
    },
    {
      "$ref": "#/$defs/literalProposeRequest"
    },
    {
      "$ref": "#/$defs/acceptRequest"
    },
    {
      "$ref": "#/$defs/mutation"
    },
    {
      "$ref": "#/$defs/view"
    },
    {
      "$ref": "#/$defs/viewV2"
    }
  ],
  "$defs": {
    "adoptRequest": {
      "$ref": "../analysis/automation-insight-coding.schema.json#/$defs/adopt"
    },
    "proposeRequest": {
      "$ref": "../analysis/automation-insight-coding.schema.json#/$defs/propose"
    },
    "literalProposeRequest": {
      "$ref": "../analysis/automation-insight-coding.schema.json#/$defs/literalPropose"
    },
    "acceptRequest": {
      "$ref": "../analysis/automation-insight-coding.schema.json#/$defs/accept"
    },
    "kind": {
      "enum": [
        "ADOPTION",
        "PROPOSAL",
        "RECEIPT"
      ]
    },
    "mutation": {
      "title": "ResearchInsightCodingMutation",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "kind",
        "evidenceId",
        "exactRetry"
      ],
      "properties": {
        "contractVersion": {
          "const": "insight-coding-mutation-v1"
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "evidenceId": {
          "$ref": "../analysis/automation-insight-coding.schema.json#/$defs/uuid"
        },
        "exactRetry": {
          "type": "boolean"
        }
      }
    },
    "evidence": {
      "title": "ResearchInsightCodingEvidenceView",
      "type": "object",
      "additionalProperties": false,
      "description": "Verified immutable evidence without actor identity. sha256 is the digest of the full verified artifact and is the exact proposalSha256 an acceptance must name.",
      "required": [
        "evidenceId",
        "kind",
        "sequence",
        "binding",
        "request",
        "createdAt",
        "sha256"
      ],
      "properties": {
        "evidenceId": {
          "$ref": "../analysis/automation-insight-coding.schema.json#/$defs/uuid"
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "sequence": {
          "$ref": "../analysis/automation-insight-coding.schema.json#/$defs/evidence/properties/sequence"
        },
        "binding": {
          "$ref": "../analysis/automation-insight-coding.schema.json#/$defs/binding"
        },
        "request": {
          "$ref": "../analysis/automation-insight-coding.schema.json#/$defs/evidence/properties/request"
        },
        "createdAt": {
          "$ref": "../analysis/automation-insight-coding.schema.json#/$defs/evidence/properties/createdAt"
        },
        "sha256": {
          "$ref": "../analysis/automation-insight-coding.schema.json#/$defs/digest"
        }
      }
    },
    "view": {
      "title": "ResearchInsightCodingView",
      "type": "object",
      "additionalProperties": false,
      "description": "Exact source context and the full bounded coding history of one explicit report pair. An over-limit history is rejected, never truncated.",
      "required": [
        "contractVersion",
        "context",
        "evidence"
      ],
      "properties": {
        "contractVersion": {
          "const": "insight-coding-view-v1"
        },
        "context": {
          "title": "ResearchInsightSourceContext",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "binding",
            "input"
          ],
          "properties": {
            "binding": {
              "$ref": "../analysis/automation-insight-coding.schema.json#/$defs/binding"
            },
            "input": {
              "$ref": "../analysis/located-insight-methods.schema.json#/$defs/input"
            }
          }
        },
        "evidence": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "defaultRuleRequest": {
      "$ref": "../analysis/automation-insight-coding.schema.json#/$defs/defaultRule"
    },
    "defaultProposeRequest": {
      "$ref": "../analysis/automation-insight-coding.schema.json#/$defs/defaultPropose"
    },
    "defaultEvidence": {
      "title": "ResearchInsightDefaultEvidenceView",
      "description": "Verified immutable evidence without actor identity. sha256 is the digest of the full verified artifact and is the exact proposalSha256 an acceptance must name.",
      "allOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidenceId",
            "kind",
            "sequence",
            "binding",
            "request",
            "createdAt",
            "sha256"
          ],
          "properties": {
            "evidenceId": {
              "$ref": "../analysis/automation-insight-coding.schema.json#/$defs/uuid"
            },
            "kind": {
              "enum": [
                "DEFAULT_RULE",
                "PROPOSAL"
              ]
            },
            "sequence": {
              "$ref": "../analysis/automation-insight-coding.schema.json#/$defs/evidence/properties/sequence"
            },
            "binding": {
              "$ref": "../analysis/automation-insight-coding.schema.json#/$defs/binding"
            },
            "request": {
              "$ref": "../analysis/automation-insight-coding.schema.json#/$defs/defaultEvidence/properties/request"
            },
            "createdAt": {
              "$ref": "../analysis/automation-insight-coding.schema.json#/$defs/evidence/properties/createdAt"
            },
            "sha256": {
              "$ref": "../analysis/automation-insight-coding.schema.json#/$defs/digest"
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "DEFAULT_RULE"
              }
            }
          },
          "then": {
            "properties": {
              "request": {
                "$ref": "../analysis/automation-insight-coding.schema.json#/$defs/defaultRule"
              }
            }
          },
          "else": {
            "properties": {
              "request": {
                "$ref": "../analysis/automation-insight-coding.schema.json#/$defs/defaultPropose"
              }
            }
          }
        }
      ],
      "type": "object"
    },
    "viewV2": {
      "title": "ResearchInsightCodingDefaultView",
      "type": "object",
      "additionalProperties": false,
      "description": "Exact source context and the full bounded coding history of one explicit report pair. An over-limit history is rejected, never truncated.",
      "required": [
        "contractVersion",
        "context",
        "evidence"
      ],
      "properties": {
        "contractVersion": {
          "const": "insight-coding-view-v2"
        },
        "context": {
          "title": "ResearchInsightSourceContext",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "binding",
            "input"
          ],
          "properties": {
            "binding": {
              "$ref": "../analysis/automation-insight-coding.schema.json#/$defs/binding"
            },
            "input": {
              "$ref": "../analysis/located-insight-methods.schema.json#/$defs/input"
            }
          }
        },
        "evidence": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/evidence"
              },
              {
                "$ref": "#/$defs/defaultEvidence"
              }
            ]
          }
        }
      }
    },
    "anyView": {
      "title": "ResearchInsightCodingAnyView",
      "oneOf": [
        {
          "$ref": "#/$defs/view"
        },
        {
          "$ref": "#/$defs/viewV2"
        }
      ]
    }
  }
}
