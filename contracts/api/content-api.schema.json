        "version": { "type": "integer", "minimum": 1 },
        "defaults": { "$ref": "../flow/content-campaign-defaults-request.schema.json#/$defs/defaults" },
        "createdAt": { "$ref": "#/$defs/dateTime" }
      }
    },
    "packageList": {
      "title": "ContentPackageListResponse",
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "campaignId", "campaignName", "campaignDeleted", "insightLocked", "packages"],
      "properties": {
        "contractVersion": { "const": "1.0.0" },
        "campaignId": { "$ref": "#/$defs/uuid" },
        "campaignName": { "type": "string", "minLength": 1 },
        "campaignDeleted": { "type": "boolean" },
        "insightLocked": { "type": "boolean" },
        "defaults": { "$ref": "#/$defs/packageDefaults" },
        "packages": { "type": "array", "items": { "$ref": "#/$defs/packageListEntry" } }
      }
    },
    "factCheckRow": {
      "title": "ContentBrandFactCheckView",
      "type": "object",
      "additionalProperties": false,
      "required": ["element", "state", "found"],
      "properties": {
        "element": { "enum": ["name", "tagline", "hotline", "website", "fanpage", "address", "price"] },
        "state": { "enum": ["MATCH", "NOT_MENTIONED", "HIDDEN", "MISMATCH"] },
        "found": { "type": "array", "items": { "type": "string" } }
      }
    },
    "captionVersionView": {
      "title": "ContentCaptionVersionView",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "source", "post", "footer", "text", "factCheck", "createdAt"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "source": { "$ref": "#/$defs/packageVersionSource" },
        "attemptId": { "$ref": "#/$defs/uuid" },
        "restoredFromVersion": { "type": "integer", "minimum": 1 },
        "post": { "type": "string" },
        "footer": { "type": "string" },
        "text": { "type": "string" },
        "factCheck": { "type": "array", "items": { "$ref": "#/$defs/factCheckRow" } },
        "createdAt": { "$ref": "#/$defs/dateTime" }
      }
    },
    "posterVersionView": {
      "title": "ContentPosterVersionView",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "source", "mediaType", "width", "height", "sizeMatchesFormat", "captionVersion", "createdAt"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "source": { "$ref": "#/$defs/packageVersionSource" },
        "attemptId": { "$ref": "#/$defs/uuid" },
        "restoredFromVersion": { "type": "integer", "minimum": 1 },
        "mediaType": { "enum": ["image/png", "image/jpeg"] },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "sizeMatchesFormat": { "type": "boolean" },
        "captionVersion": { "type": "integer", "minimum": 1 },
        "createdAt": { "$ref": "#/$defs/dateTime" }
      }
    },
    "packageAttemptView": {
      "title": "ContentPackageAttemptView",
      "type": "object",
      "additionalProperties": false,
      "required": ["attemptId", "part", "state", "errorCode", "retryOf", "model", "createdAt", "closedAt"],
      "properties": {
        "attemptId": { "$ref": "#/$defs/uuid" },
        "part": { "$ref": "#/$defs/packagePart" },
        "state": { "type": "string", "minLength": 1 },
        "errorCode": { "type": ["string", "null"] },
        "retryOf": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "model": { "type": "string", "minLength": 1 },
        "createdAt": { "$ref": "#/$defs/dateTime" },
        "closedAt": { "oneOf": [{ "$ref": "#/$defs/dateTime" }, { "type": "null" }] }
      }
    },
    "packageSettingsView": {
      "title": "ContentPackageSettingsView",
      "type": "object",
      "additionalProperties": false,
      "required": ["brandId", "purposes", "captionPromptName", "captionModel", "captionStyle", "captionLength", "posterPromptName", "posterModel", "posterFormat", "includeLogo", "referenceMediaSha256s", "captionDisplay", "posterDisplay"],
      "properties": {
        "brandId": { "$ref": "#/$defs/uuid" },
        "purposes": { "type": "array", "items": { "type": "string" } },
        "captionPromptName": { "type": "string", "minLength": 1 },
        "captionModel": { "enum": ["gpt-5.6-sol", "gpt-5.6-luna", "gemini-3.5-flash-low"] },
        "captionStyle": { "enum": ["PROFESSIONAL", "FRIENDLY"] },
        "captionLength": { "enum": ["SHORT", "MEDIUM", "LONG"] },
        "posterPromptName": { "type": "string", "minLength": 1 },
        "posterModel": { "enum": ["gpt-image-2", "gemini-3.1-flash-image"] },
        "posterFormat": { "$ref": "#/$defs/posterFormat" },
        "includeLogo": { "type": "boolean" },
        "logoMediaSha256": { "$ref": "#/$defs/sha256" },
        "referenceMediaSha256s": { "type": "array", "items": { "$ref": "#/$defs/sha256" } },
        "captionDisplay": { "$ref": "#/$defs/captionDisplayView" },
        "posterDisplay": { "$ref": "#/$defs/posterDisplayView" }
      }
    },
    "captionDisplayView": {
      "title": "ContentCaptionDisplayView",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "tagline", "hotline", "web", "address"],
      "properties": {
        "name": { "$ref": "#/$defs/visibility" },
        "tagline": { "$ref": "#/$defs/visibility" },
        "hotline": { "$ref": "#/$defs/visibility" },
        "web": { "$ref": "#/$defs/visibility" },
        "address": { "$ref": "#/$defs/visibility" }
      }
    },
    "posterDisplayView": {
      "title": "ContentPosterDisplayView",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "logo", "tagline", "hotline", "web", "address"],
      "properties": {
        "name": { "type": "boolean" },
        "logo": { "type": "boolean" },
        "tagline": { "type": "boolean" },
        "hotline": { "type": "boolean" },
        "web": { "type": "boolean" },
        "address": { "type": "boolean" }
      }
    },
    "packageDetail": {
      "title": "ContentPackageDetailResponse",
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "packageId", "campaignId", "campaignName", "campaignDeleted", "angleId", "code", "deleted", "stateSequence", "settings", "footer", "captions", "posters", "attempts", "createdAt"],
      "properties": {
        "contractVersion": { "const": "1.0.0" },
        "packageId": { "$ref": "#/$defs/uuid" },
        "campaignId": { "$ref": "#/$defs/uuid" },
        "campaignName": { "type": "string", "minLength": 1 },
        "campaignDeleted": { "type": "boolean" },
        "angleId": { "$ref": "#/$defs/uuid" },
        "code": { "type": "string", "minLength": 1 },
        "deleted": { "type": "boolean" },
        "restorableUntil": { "$ref": "#/$defs/dateTime" },
        "stateSequence": { "type": "integer", "minimum": 0 },
        "settings": { "$ref": "#/$defs/packageSettingsView" },
        "footer": { "type": "string" },
        "captions": { "type": "array", "items": { "$ref": "#/$defs/captionVersionView" } },
        "posters": { "type": "array", "items": { "$ref": "#/$defs/posterVersionView" } },
        "attempts": { "type": "array", "items": { "$ref": "#/$defs/packageAttemptView" } },
        "createdAt": { "$ref": "#/$defs/dateTime" }
      }
    },
    "aiModelAvailability": {
      "title": "ContentAiModelAvailability",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "available"],
      "properties": {
        "id": { "enum": ["gpt-5.6-sol", "gpt-5.6-luna", "gemini-3.5-flash-low", "gpt-image-2", "gemini-3.1-flash-image"] },
        "kind": { "enum": ["text", "image"] },
        "available": { "type": "boolean" }
      }
    },
    "aiStatus": {
      "title": "ContentAiStatusResponse",
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "configured", "checkedAt", "models"],
      "properties": {
        "contractVersion": { "const": "1.0.0" },
        "configured": { "type": "boolean" },
        "checkedAt": { "oneOf": [{ "$ref": "#/$defs/dateTime" }, { "type": "null" }] },
        "error": {
          "enum": [
            "ai_not_configured", "model_not_allowed", "request_too_large", "timeout", "network_error",
            "gateway_http_error", "malformed_envelope", "response_too_large", "invalid_image", "schema_mismatch"
          ]
        },
        "models": { "type": "array", "items": { "$ref": "#/$defs/aiModelAvailability" } }
      }
    },
    "error": {
      "title": "ContentApiErrorResponse",
      "type": "object",
      "additionalProperties": false,
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "enum": ["bad_request", "not_found", "method_not_allowed", "integrity_error"] },
            "message": { "type": "string" }
          }
        }
      }
    }
  }
}
