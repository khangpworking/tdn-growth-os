{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdn.local/contracts/api/content-api.schema.json",
  "title": "ContentApiContract",
  "oneOf": [
    { "$ref": "#/$defs/brandList" },
    { "$ref": "#/$defs/brandDetail" },
    { "$ref": "#/$defs/catalogList" },
    { "$ref": "#/$defs/catalogDetail" },
    { "$ref": "#/$defs/promptList" },
    { "$ref": "#/$defs/promptDetail" },
    { "$ref": "#/$defs/systemPromptDetail" },
    { "$ref": "#/$defs/campaignList" },
    { "$ref": "#/$defs/campaignDetail" },
    { "$ref": "#/$defs/insightDetail" },
    { "$ref": "#/$defs/ideaList" },
    { "$ref": "#/$defs/packageList" },
    { "$ref": "#/$defs/packageDetail" },
    { "$ref": "#/$defs/aiStatus" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" },
    "dateTime": { "type": "string", "format": "date-time" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "visibility": { "title": "ContentVisibility", "enum": ["ALWAYS", "OPTIONAL", "HIDDEN"] },
    "elementRules": {
      "title": "ContentElementRules",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "logo", "tagline", "hotline", "web", "address"],
      "properties": {
        "name": { "$ref": "#/$defs/visibility" },
        "logo": { "$ref": "#/$defs/visibility" },
        "tagline": { "$ref": "#/$defs/visibility" },
        "hotline": { "$ref": "#/$defs/visibility" },
        "web": { "$ref": "#/$defs/visibility" },
        "address": { "$ref": "#/$defs/visibility" }
      }
    },
    "displayRules": {
      "title": "ContentDisplayRules",
      "type": "object",
      "additionalProperties": false,
      "required": ["sales", "trust", "education", "entertainment", "engagement"],
      "properties": {
        "sales": { "$ref": "#/$defs/elementRules" },
        "trust": { "$ref": "#/$defs/elementRules" },
        "education": { "$ref": "#/$defs/elementRules" },
        "entertainment": { "$ref": "#/$defs/elementRules" },
        "engagement": { "$ref": "#/$defs/elementRules" }
      }
    },
    "profile": {
      "title": "ContentProfile",
      "type": "object",
      "additionalProperties": false,
      "required": ["brandName"],
      "properties": {
        "brandName": { "type": "string" },
        "tagline": { "type": "string" },
        "hotline": { "type": "string" },
        "website": { "type": "string" },
        "fanpage": { "type": "string" },
        "address": { "type": "string" }
      }
    },
    "brandSummary": {
      "title": "ContentBrandSummary",
      "type": "object",
      "additionalProperties": false,
      "required": ["brandId", "brandKey", "version", "brandName", "updatedAt"],
      "properties": {
        "brandId": { "$ref": "#/$defs/uuid" },
        "brandKey": { "type": "string" },
        "version": { "type": "integer", "minimum": 1 },
        "brandName": { "type": "string" },
        "updatedAt": { "$ref": "#/$defs/dateTime" }
      }
    },
    "brandList": {
      "title": "ContentBrandListResponse",
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "brands"],
      "properties": {
        "contractVersion": { "const": "1.0.0" },
        "brands": { "type": "array", "items": { "$ref": "#/$defs/brandSummary" } }
      }
    },
    "brandHistoryItem": {
      "title": "ContentBrandHistoryItem",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "brandName", "createdAt"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "brandName": { "type": "string" },
        "createdAt": { "$ref": "#/$defs/dateTime" }
      }
    },
    "brandDetail": {
      "title": "ContentBrandDetailResponse",
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "brand", "history"],
      "properties": {
        "contractVersion": { "const": "1.0.0" },
        "brand": {
          "title": "ContentBrandRecord",
          "type": "object",
          "additionalProperties": false,
          "required": ["brandId", "brandKey", "version", "profile", "displayRules", "createdAt"],
          "properties": {
            "brandId": { "$ref": "#/$defs/uuid" },
            "brandKey": { "type": "string" },
            "version": { "type": "integer", "minimum": 1 },
            "profile": { "$ref": "#/$defs/profile" },
            "displayRules": { "$ref": "#/$defs/displayRules" },
            "logoMediaSha256": { "$ref": "#/$defs/sha256" },
            "createdAt": { "$ref": "#/$defs/dateTime" }
          }
        },
        "history": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/brandHistoryItem" } }
      }
    },
    "catalogItemSummary": {
      "title": "ContentCatalogItemSummary",
      "type": "object",
      "additionalProperties": false,
      "required": ["itemId", "itemKey", "version", "itemType", "name", "tierNames", "photoCount", "updatedAt"],
      "properties": {
        "itemId": { "$ref": "#/$defs/uuid" },
        "itemKey": { "type": "string" },
        "version": { "type": "integer", "minimum": 1 },
        "itemType": { "enum": ["PHYSICAL", "SERVICE"] },
        "name": { "type": "string" },
        "tierNames": { "type": "array", "items": { "type": "string" } },
        "photoCount": { "type": "integer", "minimum": 0 },
        "updatedAt": { "$ref": "#/$defs/dateTime" }
      }
    },
    "catalogList": {
      "title": "ContentCatalogListResponse",
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "brandId", "items"],
      "properties": {
        "contractVersion": { "const": "1.0.0" },
        "brandId": { "$ref": "#/$defs/uuid" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/catalogItemSummary" } }
      }
    },
    "catalogHistoryItem": {
      "title": "ContentCatalogHistoryItem",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "name", "createdAt"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "name": { "type": "string" },
        "createdAt": { "$ref": "#/$defs/dateTime" }
      }
    },
    "catalogDetail": {
      "title": "ContentCatalogDetailResponse",
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "item", "history"],
      "properties": {
        "contractVersion": { "const": "1.0.0" },
        "item": {
          "title": "ContentCatalogItemRecord",
          "type": "object",
          "additionalProperties": false,
          "required": ["itemId", "brandId", "itemKey", "version", "item", "createdAt"],
          "properties": {
            "itemId": { "$ref": "#/$defs/uuid" },
            "brandId": { "$ref": "#/$defs/uuid" },
            "itemKey": { "type": "string" },
            "version": { "type": "integer", "minimum": 1 },
            "item": { "$ref": "../flow/content-catalog-item-create-request.schema.json#/$defs/item" },
            "createdAt": { "$ref": "#/$defs/dateTime" }
          }
        },
        "history": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/catalogHistoryItem" } }
      }
    },
    "promptContent": { "$ref": "../flow/content-prompt-create-request.schema.json#/$defs/prompt" },
    "promptType": { "$ref": "../flow/content-prompt-create-request.schema.json#/$defs/promptType" },
    "promptDeletion": {
      "title": "ContentPromptDeletion",
      "type": "object",
      "additionalProperties": false,
      "required": ["deletedAt", "restorableUntil"],
      "properties": {
        "deletedAt": { "$ref": "#/$defs/dateTime" },
        "restorableUntil": { "$ref": "#/$defs/dateTime" }
      }
    },
    "systemLayer": {
      "title": "ContentPromptSystemLayer",
      "type": "object",
      "additionalProperties": false,
      "required": ["promptType", "version", "sha256", "text"],
      "properties": {
        "promptType": { "$ref": "#/$defs/promptType" },
        "version": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "text": { "type": "string" }
      }
    },
    "systemPromptSummary": {
      "title": "ContentSystemPromptSummary",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "promptType", "version", "name", "recommendedModel", "tags", "isDefault"],
      "properties": {
        "id": { "type": "string" },
        "promptType": { "$ref": "#/$defs/promptType" },
        "version": { "type": "integer", "minimum": 1 },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "recommendedModel": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "isDefault": { "type": "boolean" }
      }
    },
    "promptSummary": {
      "title": "ContentPromptSummary",
      "type": "object",
      "additionalProperties": false,
      "required": ["promptId", "promptKey", "promptType", "version", "name", "recommendedModel", "tags", "updatedAt"],
      "properties": {
        "promptId": { "$ref": "#/$defs/uuid" },
        "promptKey": { "type": "string" },
        "promptType": { "$ref": "#/$defs/promptType" },
        "version": { "type": "integer", "minimum": 1 },
        "name": { "type": "string" },
        "recommendedModel": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "updatedAt": { "$ref": "#/$defs/dateTime" },
        "deleted": { "$ref": "#/$defs/promptDeletion" }
      }
    },
    "promptList": {
      "title": "ContentPromptListResponse",
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "systemPrompts", "prompts"],
      "properties": {
        "contractVersion": { "const": "1.0.0" },
        "systemPrompts": { "type": "array", "items": { "$ref": "#/$defs/systemPromptSummary" } },
        "prompts": { "type": "array", "items": { "$ref": "#/$defs/promptSummary" } }
      }
    },
    "promptHistoryItem": {
      "title": "ContentPromptHistoryItem",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "name", "createdAt"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "name": { "type": "string" },
        "createdAt": { "$ref": "#/$defs/dateTime" }
      }
    },
    "promptDetail": {
      "title": "ContentPromptDetailResponse",
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "prompt", "history", "lifecycle", "systemLayer"],
      "properties": {
        "contractVersion": { "const": "1.0.0" },
        "prompt": {
          "title": "ContentPromptRecord",
          "type": "object",
          "additionalProperties": false,
          "required": ["promptId", "promptKey", "promptType", "version", "prompt", "createdAt"],
          "properties": {
            "promptId": { "$ref": "#/$defs/uuid" },
            "promptKey": { "type": "string" },
            "promptType": { "$ref": "#/$defs/promptType" },
            "version": { "type": "integer", "minimum": 1 },
            "prompt": { "$ref": "#/$defs/promptContent" },
            "duplicatedFrom": { "$ref": "../flow/content-prompt-create-request.schema.json#/$defs/lineage" },
            "createdAt": { "$ref": "#/$defs/dateTime" }
          }
        },
        "history": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/promptHistoryItem" } },
        "lifecycle": {
          "title": "ContentPromptLifecycleState",
          "type": "object",
          "additionalProperties": false,
          "required": ["sequence"],
          "properties": {
            "sequence": { "type": "integer", "minimum": 0 },
            "deleted": { "$ref": "#/$defs/promptDeletion" }
          }
        },
        "systemLayer": { "$ref": "#/$defs/systemLayer" }
      }
    },
    "systemPromptDetail": {
      "title": "ContentSystemPromptDetailResponse",
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "systemPrompt", "systemLayer"],
      "properties": {
        "contractVersion": { "const": "1.0.0" },
        "systemPrompt": {
          "title": "ContentSystemPromptRecord",
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "promptType", "version", "sha256", "prompt", "isDefault"],
          "properties": {
            "id": { "type": "string" },
            "promptType": { "$ref": "#/$defs/promptType" },
            "version": { "type": "integer", "minimum": 1 },
            "sha256": { "$ref": "#/$defs/sha256" },
            "prompt": { "$ref": "#/$defs/promptContent" },
            "isDefault": { "type": "boolean" }
          }
        },
        "systemLayer": { "$ref": "#/$defs/systemLayer" }
      }
    },
    "campaignContent": { "$ref": "../flow/content-campaign-create-request.schema.json#/$defs/campaign" },
    "campaignDeletion": {
      "title": "ContentCampaignDeletion",
      "type": "object",
      "additionalProperties": false,
      "required": ["deletedAt", "restorableUntil"],
      "properties": {
        "deletedAt": { "$ref": "#/$defs/dateTime" },
        "restorableUntil": { "$ref": "#/$defs/dateTime" }
      }
    },
    "campaignItemSummary": {
      "title": "ContentCampaignItemSummary",
      "type": "object",
      "additionalProperties": false,
      "required": ["itemId", "itemVersion", "name", "tierNames"],
      "properties": {
        "itemId": { "$ref": "#/$defs/uuid" },
        "itemVersion": { "type": "integer", "minimum": 1 },
        "name": { "type": "string" },
        "tierNames": { "type": "array", "items": { "type": "string" } }
      }
    },
    "campaignSummary": {
      "title": "ContentCampaignSummary",
      "type": "object",
      "additionalProperties": false,
      "required": ["campaignId", "campaignKey", "brandId", "version", "name", "items", "updatedAt"],
      "properties": {
        "campaignId": { "$ref": "#/$defs/uuid" },
        "campaignKey": { "type": "string" },
        "brandId": { "$ref": "#/$defs/uuid" },
        "version": { "type": "integer", "minimum": 1 },
        "name": { "type": "string" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/campaignItemSummary" } },
        "updatedAt": { "$ref": "#/$defs/dateTime" },
        "deleted": { "$ref": "#/$defs/campaignDeletion" }
      }
    },
    "campaignList": {
      "title": "ContentCampaignListResponse",
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "campaigns"],
      "properties": {
        "contractVersion": { "const": "1.0.0" },
        "campaigns": { "type": "array", "items": { "$ref": "#/$defs/campaignSummary" } }
      }
    },
    "campaignHistoryItem": {
      "title": "ContentCampaignHistoryItem",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "name", "createdAt"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "name": { "type": "string" },
        "createdAt": { "$ref": "#/$defs/dateTime" }
      }
    },
    "campaignItemView": {
      "title": "ContentCampaignItemView",
      "type": "object",
      "additionalProperties": false,
      "required": ["itemId", "itemVersion", "itemKey", "itemType", "name", "tiers"],
      "properties": {
        "itemId": { "$ref": "#/$defs/uuid" },
        "itemVersion": { "type": "integer", "minimum": 1 },
        "itemKey": { "type": "string" },
        "itemType": { "enum": ["PHYSICAL", "SERVICE"] },
        "name": { "type": "string" },
        "tiers": {
          "type": "array",
          "items": {
            "title": "ContentCampaignTierView",
            "type": "object",
            "additionalProperties": false,
            "required": ["tierKey", "name"],
            "properties": {
              "tierKey": { "type": "string" },
              "name": { "type": "string" }
            }
          }
        }
      }
    },
    "campaignDetail": {
      "title": "ContentCampaignDetailResponse",
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "campaign", "items", "history", "lifecycle"],
      "properties": {
        "contractVersion": { "const": "1.0.0" },
        "campaign": {
          "title": "ContentCampaignRecord",
          "type": "object",
          "additionalProperties": false,
          "required": ["campaignId", "campaignKey", "brandId", "version", "campaign", "createdAt"],
          "properties": {
            "campaignId": { "$ref": "#/$defs/uuid" },
            "campaignKey": { "type": "string" },
            "brandId": { "$ref": "#/$defs/uuid" },
            "version": { "type": "integer", "minimum": 1 },
            "campaign": { "$ref": "#/$defs/campaignContent" },
            "createdAt": { "$ref": "#/$defs/dateTime" }
          }
        },
        "items": { "type": "array", "items": { "$ref": "#/$defs/campaignItemView" } },
        "history": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/campaignHistoryItem" } },
        "lifecycle": {
          "title": "ContentCampaignLifecycleState",
          "type": "object",
          "additionalProperties": false,
          "required": ["sequence"],
          "properties": {
            "sequence": { "type": "integer", "minimum": 0 },
            "deleted": { "$ref": "#/$defs/campaignDeletion" }
          }
        }
      }
    },
    "insightDetail": {
      "title": "ContentInsightDetailResponse",
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "campaignId", "campaignVersion", "campaignDeleted", "history", "gate"],
      "properties": {
        "contractVersion": { "const": "1.0.0" },
        "campaignId": { "$ref": "#/$defs/uuid" },
        "campaignVersion": { "type": "integer", "minimum": 1 },
        "campaignDeleted": { "type": "boolean" },
        "latest": {
          "title": "ContentInsightRecord",
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "insight", "createdAt"],
          "properties": {
            "version": { "type": "integer", "minimum": 1 },
            "insight": { "$ref": "../flow/content-insight-revision-request.schema.json#/$defs/insight" },
            "createdAt": { "$ref": "#/$defs/dateTime" }
          }
        },
        "history": {
          "type": "array",
          "items": {
            "title": "ContentInsightHistoryItem",
            "type": "object",
            "additionalProperties": false,
            "required": ["version", "sourceKind", "createdAt"],
            "properties": {
              "version": { "type": "integer", "minimum": 1 },
              "sourceKind": { "enum": ["TYPED", "STP"] },
              "createdAt": { "$ref": "#/$defs/dateTime" }
            }
          }
        },
        "lock": {
          "title": "ContentInsightLockView",
          "type": "object",
          "additionalProperties": false,
          "required": ["insightVersion", "campaignVersion", "lockedAt"],
          "properties": {
            "insightVersion": { "type": "integer", "minimum": 1 },
            "campaignVersion": { "type": "integer", "minimum": 1 },
            "lockedAt": { "$ref": "#/$defs/dateTime" },
            "b10": { "$ref": "../flow/content-insight-lock-artifact.schema.json#/$defs/b10" }
          }
        },
        "gate": {
          "title": "ContentInsightGate",
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "ready"],
          "properties": {
            "required": { "type": "boolean" },
            "ready": { "type": "boolean" },
            "productWorkspaceId": { "$ref": "#/$defs/uuid" },
            "effectiveDecision": { "enum": ["APPROVE", "HOLD", "REJECT"] },
            "reason": { "type": "string" }
          }
        },
        "stpSuggestion": {
          "title": "ContentInsightStpSuggestion",
          "type": "object",
          "additionalProperties": false,
          "required": ["lockedStpId", "customer", "insight"],
          "properties": {
            "lockedStpId": { "$ref": "#/$defs/uuid" },
            "customer": { "type": "string" },
            "insight": { "type": "string" }
          }
        }
      }
    },
    "ideaListEntry": {
      "title": "ContentIdeaListEntry",
      "type": "object",
      "additionalProperties": false,
      "required": ["ideaId", "kind", "code", "concept", "developing", "deleted", "stateSequence", "purposes", "model", "promptLabel", "createdAt"],
      "properties": {
        "ideaId": { "$ref": "#/$defs/uuid" },
        "kind": { "$ref": "../flow/content-idea-generate-request.schema.json#/$defs/kind" },
        "parentIdeaId": { "$ref": "#/$defs/uuid" },
        "code": { "type": "string", "pattern": "^[A-Z]+(?:[1-9][0-9]*)?$" },
        "concept": { "type": "string", "minLength": 1 },
        "expression": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "developing": { "type": "boolean" },
        "deleted": { "type": "boolean" },
        "restorableUntil": { "$ref": "#/$defs/dateTime" },
        "stateSequence": { "type": "integer", "minimum": 0 },
        "purposes": { "$ref": "../flow/content-idea-state-request.schema.json#/$defs/purposes" },
        "model": { "$ref": "../flow/content-idea-generate-request.schema.json#/$defs/model" },
        "promptLabel": { "type": "string", "minLength": 1 },
        "createdAt": { "$ref": "#/$defs/dateTime" }
      }
    },
    "purposeTagEntry": {
      "title": "ContentPurposeTagEntry",
      "type": "object",
      "additionalProperties": false,
      "required": ["tagId", "label", "displayLike", "createdAt"],
      "properties": {
        "tagId": { "$ref": "#/$defs/uuid" },
        "label": { "type": "string", "minLength": 1, "maxLength": 40 },
        "displayLike": { "$ref": "../flow/content-purpose-tag-request.schema.json#/properties/displayLike" },
        "createdAt": { "$ref": "#/$defs/dateTime" }
      }
    },
    "ideaList": {
      "title": "ContentIdeaListResponse",
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "campaignId", "campaignName", "campaignDeleted", "insightLocked", "ideas", "purposeTags"],
      "properties": {
        "contractVersion": { "const": "1.0.0" },
        "campaignId": { "$ref": "#/$defs/uuid" },
        "campaignName": { "type": "string", "minLength": 1 },
        "campaignDeleted": { "type": "boolean" },
        "insightLocked": { "type": "boolean" },
        "insightVersion": { "type": "integer", "minimum": 1 },
        "ideas": { "type": "array", "items": { "$ref": "#/$defs/ideaListEntry" } },
        "purposeTags": { "type": "array", "items": { "$ref": "#/$defs/purposeTagEntry" } }
      }
    },
    "packagePart": { "title": "ContentPackagePart", "enum": ["CAPTION", "POSTER"] },
    "packageVersionSource": { "title": "ContentPackageVersionSource", "enum": ["GENERATED", "MANUAL", "RESTORE"] },
    "posterFormat": { "title": "ContentPosterFormat", "enum": ["square", "portrait", "story", "landscape"] },
    "packageListEntry": {
      "title": "ContentPackageListEntry",
      "type": "object",
      "additionalProperties": false,
      "required": ["packageId", "angleId", "code", "deleted", "stateSequence", "captionVersion", "posterVersion", "posterFormat", "createdAt"],
      "properties": {
        "packageId": { "$ref": "#/$defs/uuid" },
        "angleId": { "$ref": "#/$defs/uuid" },
        "code": { "type": "string", "minLength": 1 },
        "deleted": { "type": "boolean" },
        "restorableUntil": { "$ref": "#/$defs/dateTime" },
        "stateSequence": { "type": "integer", "minimum": 0 },
        "captionVersion": { "type": "integer", "minimum": 0 },
        "posterVersion": { "type": "integer", "minimum": 0 },
        "captionPreview": { "type": "string", "minLength": 1 },
        "posterFormat": { "$ref": "#/$defs/posterFormat" },
        "createdAt": { "$ref": "#/$defs/dateTime" }
      }
    },
    "packageDefaults": {
      "title": "ContentPackageDefaultsView",
      "type": "object",
