{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdn.local/contracts/api/research-generation-api.schema.json",
  "title": "ResearchGenerationApiContract",
  "oneOf": [{ "$ref": "#/$defs/request" }, { "$ref": "#/$defs/inputs" }, { "$ref": "#/$defs/receipt" }, { "$ref": "#/$defs/methodInputError" }],
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "uuid": { "type": "string", "format": "uuid" },
    "methodInputError": {
      "title": "ResearchGenerationMethodInputError",
      "type": "object", "additionalProperties": false,
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object", "additionalProperties": false,
          "required": ["code", "message", "family"],
          "properties": {
            "code": { "const": "method_input_rejected" },
            "message": { "const": "The selected method input does not match its declared evidence; choose another input or none" },
            "family": { "enum": ["descriptiveMethods", "locatedInsightMethods", "methodPackets"] }
          }
        }
      }
    },
    "request": {
      "title": "ResearchGenerationRequest",
      "type": "object", "additionalProperties": false,
      "required": ["contractVersion", "workspaceId", "selectionId", "requestKey"],
      "properties": {
        "contractVersion": { "const": "1.0.0" },
        "workspaceId": { "$ref": "#/$defs/uuid" },
        "selectionId": { "$ref": "#/$defs/digest" },
        "requestKey": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "methodSelectionIds": { "$ref": "#/$defs/methodSelectionIds" }
      }
    },
    "methodSelectionIds": {
      "title": "ResearchGenerationMethodSelectionIds",
      "type": "object", "additionalProperties": false,
      "required": ["descriptiveMethods", "locatedInsightMethods", "methodPackets"],
      "properties": {
        "descriptiveMethods": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "locatedInsightMethods": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "methodPackets": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }
      }
    },
    "methodCandidate": {
      "title": "ResearchGenerationMethodCandidate",
      "type": "object", "additionalProperties": false,
      "required": ["methodSelectionId", "logicalPath", "eligibility", "limitations"],
      "properties": {
        "methodSelectionId": { "$ref": "#/$defs/digest" },
        "logicalPath": { "type": "string", "minLength": 1, "maxLength": 500 },
        "eligibility": { "const": "VALIDATE_ON_CREATE" },
        "limitations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "methodInputs": {
      "title": "ResearchGenerationMethodInputs",
      "type": "object", "additionalProperties": false,
      "required": ["descriptiveMethods", "locatedInsightMethods", "methodPackets"],
      "properties": {
        "descriptiveMethods": { "type": "array", "items": { "$ref": "#/$defs/methodCandidate" } },
        "locatedInsightMethods": { "type": "array", "items": { "$ref": "#/$defs/methodCandidate" } },
        "methodPackets": { "type": "array", "items": { "$ref": "#/$defs/methodCandidate" } }
      }
    },
    "choice": {
      "title": "ResearchGenerationChoice",
      "type": "object", "additionalProperties": false,
      "required": ["selectionId", "packageId", "packageManifestSha256", "sourceLabel", "packageVersion", "sourceName", "period", "workbookPath", "manifestPath", "labelsPath", "eligibility", "limitations"],
      "properties": {
        "selectionId": { "$ref": "#/$defs/digest" },
        "packageId": { "$ref": "#/$defs/uuid" },
        "packageManifestSha256": { "$ref": "#/$defs/digest" },
        "sourceLabel": { "type": "string" },
        "packageVersion": { "type": "integer", "minimum": 1 },
        "sourceName": { "type": "string" },
        "period": {
          "type": "object", "additionalProperties": false,
          "required": ["start", "end", "basis"],
          "properties": { "start": { "type": "string" }, "end": { "type": "string" }, "basis": { "type": "string" } }
        },
        "workbookPath": { "type": "string" },
        "manifestPath": { "type": "string" },
        "labelsPath": { "type": ["string", "null"] },
        "eligibility": { "const": "VALIDATE_ON_CREATE" },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "methodInputs": { "$ref": "#/$defs/methodInputs" }
      }
    },
    "inputs": {
      "title": "ResearchGenerationInputs",
      "type": "object", "additionalProperties": false,
      "required": ["contractVersion", "workspaceId", "catalogSha256", "choices"],
      "properties": {
        "contractVersion": { "const": "1.0.0" },
        "workspaceId": { "$ref": "#/$defs/uuid" },
        "catalogSha256": { "$ref": "#/$defs/digest" },
        "choices": { "type": "array", "items": { "$ref": "#/$defs/choice" } }
      }
    },
    "receipt": {
      "title": "ResearchGenerationReceipt",
      "type": "object", "additionalProperties": false,
      "required": ["contractVersion", "requestKey", "workspaceId", "reportId", "version", "semanticVersionId", "profile", "exactRetry", "reviewState", "interpretationState", "limitations"],
      "properties": {
        "contractVersion": { "const": "1.0.0" },
        "requestKey": { "$ref": "#/$defs/uuid" },
        "workspaceId": { "$ref": "#/$defs/uuid" },
        "reportId": { "$ref": "#/$defs/uuid" },
        "version": { "const": 1 },
        "semanticVersionId": { "$ref": "#/$defs/digest" },
        "profile": { "enum": ["prepared-report-v1", "source-backed-v1"] },
        "exactRetry": { "type": "boolean" },
        "reviewState": { "const": "UNREVIEWED" },
        "interpretationState": { "const": "NONE" },
        "limitations": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
