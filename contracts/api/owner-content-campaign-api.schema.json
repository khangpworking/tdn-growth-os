{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdn.local/contracts/api/owner-content-campaign-api.schema.json",
  "title": "OwnerContentCampaignApiContract",
  "oneOf": [
    { "$ref": "#/$defs/createRequest" },
    { "$ref": "#/$defs/revisionRequest" },
    { "$ref": "#/$defs/lifecycleRequest" },
    { "$ref": "#/$defs/receipt" },
    { "$ref": "#/$defs/lifecycleReceipt" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "createRequest": {
      "title": "OwnerContentCampaignCreateRequest",
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "campaignKey", "brandId", "campaign"],
      "properties": {
        "contractVersion": { "const": "1.0.0" },
        "campaignKey": { "$ref": "../flow/content-campaign-create-request.schema.json#/$defs/campaignKey" },
        "brandId": { "$ref": "#/$defs/uuid" },
        "campaign": { "$ref": "../flow/content-campaign-create-request.schema.json#/$defs/campaign" }
      }
    },
    "revisionRequest": {
      "title": "OwnerContentCampaignRevisionRequest",
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "expectedVersion", "campaign"],
      "properties": {
        "contractVersion": { "const": "1.0.0" },
        "expectedVersion": { "type": "integer", "minimum": 1, "maximum": 9007199254740990 },
        "campaign": { "$ref": "../flow/content-campaign-create-request.schema.json#/$defs/campaign" }
      }
    },
    "lifecycleRequest": {
      "title": "OwnerContentCampaignLifecycleRequest",
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "action", "expectedSequence"],
      "properties": {
        "contractVersion": { "const": "1.0.0" },
        "action": { "enum": ["DELETE", "RESTORE"] },
        "expectedSequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 }
      }
    },
    "receipt": {
      "title": "OwnerContentCampaignReceipt",
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "campaignId", "campaignKey", "brandId", "version", "name", "createdAt", "exactRetry"],
      "properties": {
        "contractVersion": { "const": "1.0.0" },
        "campaignId": { "$ref": "#/$defs/uuid" },
        "campaignKey": { "type": "string" },
        "brandId": { "$ref": "#/$defs/uuid" },
        "version": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "name": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "exactRetry": { "type": "boolean" }
      }
    },
    "lifecycleReceipt": {
      "title": "OwnerContentCampaignLifecycleReceipt",
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "campaignId", "sequence", "action", "createdAt", "exactRetry"],
      "properties": {
        "contractVersion": { "const": "1.0.0" },
        "campaignId": { "$ref": "#/$defs/uuid" },
        "sequence": { "type": "integer", "minimum": 1 },
        "action": { "enum": ["DELETE", "RESTORE"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "restorableUntil": { "type": "string", "format": "date-time" },
        "exactRetry": { "type": "boolean" }
      }
    },
    "error": {
      "title": "OwnerContentCampaignApiErrorResponse",
      "type": "object",
      "additionalProperties": false,
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "enum": ["bad_request", "unauthorized", "forbidden", "not_found", "method_not_allowed", "conflict", "integrity_error"] },
            "message": { "type": "string" }
          }
        }
      }
    }
  }
}
