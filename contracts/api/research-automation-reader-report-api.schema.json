{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdn.local/contracts/api/research-automation-reader-report-api.schema.json",
  "title": "ResearchAutomationReaderReportApi",
  "description": "Reader page for the OWNER built from a DRAFT_READY run, and the OWNER decision on it. Building restates the draft; it never edits the draft, admits sources or calls a provider.",
  "oneOf": [
    {
      "$ref": "#/$defs/buildRequest"
    },
    {
      "$ref": "#/$defs/buildReceipt"
    },
    {
      "$ref": "#/$defs/decisionRequest"
    },
    {
      "$ref": "#/$defs/decisionReceipt"
    },
    {
      "$ref": "#/$defs/list"
    },
    {
      "$ref": "#/$defs/unitSpecIntakeRequest"
    },
    {
      "$ref": "#/$defs/unitSpecIntakeRecord"
    },
    {
      "$ref": "#/$defs/unitSpecIntakeReceipt"
    },
    {
      "$ref": "#/$defs/intakeBoundBuildRequest"
    },
    {
      "$ref": "#/$defs/insightBuildRequest"
    },
    {
      "$ref": "#/$defs/buildReceiptV2"
    },
    {
      "$ref": "#/$defs/decisionRequestV2"
    },
    {
      "$ref": "#/$defs/decisionReceiptV2"
    },
    {
      "$ref": "#/$defs/listV2"
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "platform": {
      "enum": [
        "shopee",
        "tiktok"
      ]
    },
    "buildRequest": {
      "title": "ResearchAutomationReaderBuildRequest",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "requestKey",
        "metricPackageId",
        "platforms",
        "profile",
        "cover"
      ],
      "properties": {
        "contractVersion": {
          "enum": [
            "reader-report-build-v1",
            "reader-report-build-v1.1",
            "reader-report-build-v1.2"
          ]
        },
        "requestKey": {
          "$ref": "research-automation-api.schema.json#/$defs/requestKey"
        },
        "metricPackageId": {
          "$ref": "research-automation-api.schema.json#/$defs/uuid"
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/platform"
          }
        },
        "profile": {
          "$ref": "../analysis/reader-report-input.schema.json#/$defs/profile"
        },
        "cover": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/cover"
            }
          ]
        },
        "source": {
          "$ref": "../analysis/reader-report-input.schema.json#/$defs/source"
        },
        "webSnapshot": {
          "type": "object",
          "description": "Opaque retained search-page snapshot; checked by the snapshot validator and canonical digest."
        },
        "webSnapshotSha256": {
          "$ref": "#/$defs/sha256"
        },
        "unitPrices": {
          "$ref": "../analysis/reader-report-input.schema.json#/$defs/unitPrices"
        }
      },
      "if": {
        "properties": {
          "contractVersion": {
            "const": "reader-report-build-v1"
          }
        },
        "required": [
          "contractVersion"
        ]
      },
      "then": {
        "properties": {
          "source": {},
          "webSnapshot": false,
          "webSnapshotSha256": false,
          "unitPrices": false
        },
        "required": [
          "source"
        ]
      },
      "else": {
        "if": {
          "type": "object",
          "properties": {
            "contractVersion": {
              "const": "reader-report-build-v1.1"
            }
          },
          "required": [
            "contractVersion"
          ]
        },
        "then": {
          "properties": {
            "webSnapshot": {},
            "webSnapshotSha256": {},
            "unitPrices": false
          },
          "required": [
            "webSnapshot",
            "webSnapshotSha256"
          ]
        },
        "else": {
          "type": "object",
          "required": [
            "source"
          ]
        }
      }
    },
    "cover": {
      "title": "ResearchAutomationReaderCover",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "imageBase64",
        "licence"
      ],
      "properties": {
        "imageBase64": {
          "type": "string",
          "minLength": 4,
          "maxLength": 4194304,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        },
        "licence": {
          "enum": [
            "CC0",
            "public-domain",
            "owner-supplied"
          ]
        },
        "credit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "decisionRequest": {
      "title": "ResearchAutomationReaderDecisionRequest",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "requestKey",
        "revisionId",
        "decision",
        "reason"
      ],
      "properties": {
        "contractVersion": {
          "const": "reader-report-decision-v1"
        },
        "requestKey": {
          "$ref": "research-automation-api.schema.json#/$defs/requestKey"
        },
        "revisionId": {
          "$ref": "research-automation-api.schema.json#/$defs/uuid"
        },
        "decision": {
          "enum": [
            "APPROVED",
            "REJECTED"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "pattern": "\\S"
            }
          ]
        }
      }
    },
    "revision": {
      "title": "ResearchAutomationReaderRevision",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revisionId",
        "revisionNumber",
        "workspaceId",
        "runId",
        "state",
        "draftPairId",
        "platforms",
        "profileStatus",
        "htmlSha256",
        "createdAt",
        "decision"
      ],
      "properties": {
        "revisionId": {
          "$ref": "research-automation-api.schema.json#/$defs/uuid"
        },
        "revisionNumber": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "workspaceId": {
          "$ref": "research-automation-api.schema.json#/$defs/uuid"
        },
        "runId": {
          "$ref": "research-automation-api.schema.json#/$defs/uuid"
        },
        "state": {
          "enum": [
            "PENDING_OWNER_REVIEW",
            "APPROVED",
            "REJECTED",
            "SUPERSEDED"
          ]
        },
        "draftPairId": {
          "$ref": "#/$defs/sha256"
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/platform"
          }
        },
        "profileStatus": {
          "enum": [
            "proposed",
            "approved"
          ]
        },
        "htmlSha256": {
          "$ref": "#/$defs/sha256"
        },
        "createdAt": {
          "$ref": "#/$defs/timestamp"
        },
        "decision": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "decision",
                "reason",
                "decidedAt"
              ],
              "properties": {
                "decision": {
                  "enum": [
                    "APPROVED",
                    "REJECTED"
                  ]
                },
                "reason": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 1000
                },
                "decidedAt": {
                  "$ref": "#/$defs/timestamp"
                }
              }
            }
          ]
        }
      }
    },
    "buildReceipt": {
      "title": "ResearchAutomationReaderBuildReceipt",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "exactRetry",
        "revision"
      ],
      "properties": {
        "contractVersion": {
          "const": "reader-report-build-receipt-v1"
        },
        "exactRetry": {
          "type": "boolean"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        }
      }
    },
    "decisionReceipt": {
      "title": "ResearchAutomationReaderDecisionReceipt",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "exactRetry",
        "revision"
      ],
      "properties": {
        "contractVersion": {
          "const": "reader-report-decision-receipt-v1"
        },
        "exactRetry": {
          "type": "boolean"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        }
      }
    },
    "list": {
      "title": "ResearchAutomationReaderRevisionList",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
