{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://tdn.local/contracts/api/workspace-api.schema.json","title":"Workspace read API responses","oneOf":[{"$ref":"#/$defs/portfolio"},{"$ref":"#/$defs/discoveryDetail"},{"$ref":"#/$defs/productDetail"},{"$ref":"#/$defs/error"}],
  "$defs":{
    "uuid":{"type":"string","pattern":"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"},"dateTime":{"type":"string","format":"date-time"},
    "portfolioItem":{"type":"object","additionalProperties":false,"required":["workspaceId","workspaceKey","state","title","createdAt","candidateCount","productCount"],"properties":{"workspaceId":{"$ref":"#/$defs/uuid"},"workspaceKey":{"type":"string"},"state":{"const":"ACTIVE"},"title":{"type":"string"},"description":{"type":"string"},"createdAt":{"$ref":"#/$defs/dateTime"},"candidateCount":{"type":"integer","minimum":0},"productCount":{"type":"integer","minimum":0}}},
    "candidate":{"type":"object","additionalProperties":false,"required":["candidateId","candidateKey","state","version","label","createdAt"],"properties":{"candidateId":{"$ref":"#/$defs/uuid"},"candidateKey":{"type":"string"},"state":{"const":"EXPLORING"},"version":{"type":"integer","minimum":1},"label":{"type":"string"},"summary":{"type":"string"},"createdAt":{"$ref":"#/$defs/dateTime"}}},
    "productSummary":{"type":"object","additionalProperties":false,"required":["productWorkspaceId","productWorkspaceKey","state","entryStep","title","createdAt"],"properties":{"productWorkspaceId":{"$ref":"#/$defs/uuid"},"productWorkspaceKey":{"type":"string"},"state":{"const":"ACTIVE"},"entryStep":{"const":"B8"},"title":{"type":"string"},"createdAt":{"$ref":"#/$defs/dateTime"}}},
    "productRecord":{"type":"object","additionalProperties":false,"required":["productWorkspaceId","productWorkspaceKey","state","entryStep","title","createdAt","sourceWorkspaceId","sourceBasketId","sourceBasketKey","sourceBasketVersion","sourceCandidateId","sourceCandidateKey","sourceCandidateVersion","sourceCandidateLabel","sourceB7DecisionId","sourceB7DecidedAt"],"properties":{"productWorkspaceId":{"$ref":"#/$defs/uuid"},"productWorkspaceKey":{"type":"string"},"state":{"const":"ACTIVE"},"entryStep":{"const":"B8"},"title":{"type":"string"},"createdAt":{"$ref":"#/$defs/dateTime"},"sourceWorkspaceId":{"$ref":"#/$defs/uuid"},"sourceBasketId":{"$ref":"#/$defs/uuid"},"sourceBasketKey":{"type":"string"},"sourceBasketVersion":{"type":"integer","minimum":1},"sourceCandidateId":{"$ref":"#/$defs/uuid"},"sourceCandidateKey":{"type":"string"},"sourceCandidateVersion":{"type":"integer","minimum":1},"sourceCandidateLabel":{"type":"string"},"sourceCandidateSummary":{"type":"string"},"sourceB7DecisionId":{"$ref":"#/$defs/uuid"},"sourceB7DecidedAt":{"$ref":"#/$defs/dateTime"}}},
    "lane":{"type":"object","additionalProperties":false,"required":["lane","effectiveState"],"properties":{"lane":{"enum":["LEGAL","SCIENTIFIC","QUALITY","FINANCE"]},"effectiveState":{"enum":["NO_DECISION","PASS","HOLD","REJECT"]},"decisionId":{"$ref":"#/$defs/uuid"},"decisionVersion":{"type":"integer","minimum":1},"decidedAt":{"$ref":"#/$defs/dateTime"}}},
    "clearanceDecision":{"type":"object","additionalProperties":false,"required":["lane","decisionId","decisionVersion","decidedAt"],"properties":{"lane":{"enum":["LEGAL","SCIENTIFIC","QUALITY","FINANCE"]},"decisionId":{"$ref":"#/$defs/uuid"},"decisionVersion":{"type":"integer","minimum":1},"decidedAt":{"$ref":"#/$defs/dateTime"}}},
    "clearance":{"type":"object","additionalProperties":false,"required":["clearanceId","state","clearedAt","decisions"],"properties":{"clearanceId":{"$ref":"#/$defs/uuid"},"state":{"const":"READY_FOR_B9"},"clearedAt":{"$ref":"#/$defs/dateTime"},"decisions":{"type":"array","minItems":4,"maxItems":4,"items":{"$ref":"#/$defs/clearanceDecision"}}}},
    "portfolio":{"type":"object","additionalProperties":false,"required":["contractVersion","workspaces"],"properties":{"contractVersion":{"const":"1.0.0"},"workspaces":{"type":"array","items":{"$ref":"#/$defs/portfolioItem"}}}},
    "discoveryDetail":{"type":"object","additionalProperties":false,"required":["contractVersion","workspace","candidates","products"],"properties":{"contractVersion":{"const":"1.0.0"},"workspace":{"$ref":"#/$defs/portfolioItem"},"candidates":{"type":"array","items":{"$ref":"#/$defs/candidate"}},"products":{"type":"array","items":{"$ref":"#/$defs/productSummary"}}}},
    "productDetail":{"type":"object","additionalProperties":false,"required":["contractVersion","product","b8"],"properties":{"contractVersion":{"const":"1.0.0"},"product":{"$ref":"#/$defs/productRecord"},"b8":{"type":"object","additionalProperties":false,"required":["lanes","readyForB9"],"properties":{"lanes":{"type":"array","minItems":4,"maxItems":4,"items":{"$ref":"#/$defs/lane"}},"readyForB9":{"type":"boolean"}}},"clearance":{"$ref":"#/$defs/clearance"}}},
    "error":{"type":"object","additionalProperties":false,"required":["error"],"properties":{"error":{"type":"object","additionalProperties":false,"required":["code","message"],"properties":{"code":{"enum":["bad_request","not_found","method_not_allowed","integrity_error"]},"message":{"type":"string"}}}}}
  }
}
