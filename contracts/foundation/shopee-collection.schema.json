{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShopeeCollection",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contractVersion": {
      "const": "1.0.0"
    },
    "collectionId": {
      "type": "string",
      "format": "uuid"
    },
    "runKey": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"
    },
    "requestSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "mode": {
      "enum": [
        "fixture",
        "live"
      ]
    },
    "selected": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "platform": {
            "const": "shopee"
          },
          "shopId": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,19}$"
          },
          "itemId": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,19}$"
          },
          "productKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "groupingBasis": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "productName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "productUrl": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "periodRevenueVnd": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,29})$"
          },
          "revenuePrecision": {
            "const": "exact"
          }
        },
        "required": [
          "platform",
          "shopId",
          "itemId",
          "productKey",
          "groupingBasis",
          "productName",
          "productUrl",
          "periodRevenueVnd",
          "revenuePrecision"
        ]
      }
    },
    "selectionWarnings": {
      "type": "array",
      "maxItems": 2005,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "collectorWarnings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "datasetId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "buildId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "runId",
        "datasetId",
        "buildId",
        "status"
      ]
    },
    "pages": {
      "type": "array",
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "byteSize": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8388608
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2500
          }
        },
        "required": [
          "sha256",
          "byteSize",
          "offset"
        ]
      }
    }
  },
  "required": [
    "contractVersion",
    "collectionId",
    "runKey",
    "requestSha256",
    "createdAt",
    "mode",
    "selected",
    "selectionWarnings",
    "collectorWarnings",
    "actor",
    "pages"
  ]
}
