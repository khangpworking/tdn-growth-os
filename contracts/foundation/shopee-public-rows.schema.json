{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShopeePublicRows",
  "type": "array",
  "maxItems": 1500,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "reviewId",
      "shopId",
      "itemId",
      "postedAtLocal",
      "createdAt",
      "variation",
      "ratingStar",
      "ratingState",
      "comment",
      "attributes",
      "contentType",
      "sourcePage",
      "sourceUrl",
      "sourceRow",
      "admissionReasons"
    ],
    "properties": {
      "reviewId": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          {
            "type": "null"
          }
        ]
      },
      "shopId": {
        "type": "string",
        "pattern": "^[1-9][0-9]{0,19}$"
      },
      "itemId": {
        "type": "string",
        "pattern": "^[1-9][0-9]{0,19}$"
      },
      "postedAtLocal": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 100
          },
          {
            "type": "null"
          }
        ]
      },
      "createdAt": {
        "anyOf": [
          {
            "type": "string",
            "format": "date-time",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:00\\+07:00$"
          },
          {
            "type": "null"
          }
        ]
      },
      "variation": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 4096
          },
          {
            "type": "null"
          }
        ]
      },
      "ratingStar": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          {
            "type": "null"
          }
        ]
      },
      "ratingState": {
        "enum": [
          "VALID",
          "MISSING",
          "INVALID"
        ]
      },
      "comment": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 65536
          },
          {
            "type": "null"
          }
        ]
      },
      "attributes": {
        "type": "array",
        "maxItems": 100,
        "items": {
          "type": "string",
          "maxLength": 65536
        }
      },
      "contentType": {
        "enum": [
          "COMMENT",
          "ATTRIBUTES_ONLY",
          "UNRESOLVED"
        ]
      },
      "sourcePage": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          {
            "type": "null"
          }
        ]
      },
      "sourceUrl": {
        "type": "string",
        "maxLength": 2000
      },
      "sourceRow": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1499
      },
      "admissionReasons": {
        "type": "array",
        "maxItems": 10,
        "items": {
          "enum": [
            "INVALID_REVIEW_ID",
            "UNREADABLE_COMMENT",
            "INVALID_ATTRIBUTES",
            "INCONSISTENT_CONTENT_TYPE",
            "INVALID_SOURCE_PAGE",
            "SOURCE_TIME_NOT_PARSED",
            "INVALID_VARIATION",
            "INVALID_SOURCE_TIME"
          ]
        }
      }
    }
  },
  "$id": "https://tdn.local/contracts/foundation/shopee-public-rows.schema.json"
}
