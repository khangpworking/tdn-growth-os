{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdn.local/contracts/foundation/data-pack-request.schema.json",
  "title": "DataPackRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "packKey", "version", "purpose", "observationIds"],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "packKey": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*:[A-Za-z0-9][A-Za-z0-9._-]*$",
      "maxLength": 160
    },
    "version": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S" },
    "observationIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[1-9][0-9]*$", "maxLength": 19 }
    },
    "supersedesPackId": { "type": "string", "format": "uuid" }
  }
}
