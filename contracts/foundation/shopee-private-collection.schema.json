{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShopeePrivateCollection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "selectionBasis",
    "collectionId",
    "runKey",
    "requestSha256",
    "createdAt",
    "mode",
    "selected",
    "selectionWarnings",
    "collectorWarnings",
    "actor",
    "pages",
    "privacy"
  ],
  "properties": {
    "contractVersion": {
      "const": "3.0.0"
    },
    "selectionBasis": {
      "const": "OWNER_EXACT_URL"
    },
    "collectionId": {
      "$ref": "shopee-collection.schema.json#/properties/collectionId"
    },
    "runKey": {
      "$ref": "shopee-collection.schema.json#/properties/runKey"
    },
    "requestSha256": {
      "$ref": "shopee-collection.schema.json#/properties/requestSha256"
    },
    "createdAt": {
      "$ref": "shopee-collection.schema.json#/properties/createdAt"
    },
    "mode": {
      "$ref": "shopee-collection.schema.json#/properties/mode"
    },
    "selected": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "platform",
          "shopId",
          "itemId",
          "productUrl",
          "submittedUrl"
        ],
        "properties": {
          "platform": {
            "const": "shopee"
          },
          "shopId": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,19}$"
          },
          "itemId": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,19}$"
          },
          "productUrl": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "submittedUrl": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    },
    "selectionWarnings": {
      "$ref": "shopee-collection.schema.json#/properties/selectionWarnings"
    },
    "collectorWarnings": {
      "$ref": "shopee-collection.schema.json#/properties/collectorWarnings"
    },
    "actor": {
      "$ref": "shopee-collection.schema.json#/properties/actor"
    },
    "pages": {
      "$ref": "shopee-collection.schema.json#/properties/pages"
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileVersion",
        "platform",
        "namespace",
        "field",
        "algorithm",
        "documentationUrl",
        "documentationSha256",
        "documentationRetrievedAt",
        "keyId"
      ],
      "properties": {
        "profileVersion": {
          "const": "shopee-author-id-hmac-v1"
        },
        "platform": {
          "const": "shopee"
        },
        "namespace": {
          "const": "tdn:shopee.vn:author:v1"
        },
        "field": {
          "const": "authorId"
        },
        "algorithm": {
          "const": "HMAC-SHA256"
        },
        "documentationUrl": {
          "const": "https://apify.com/zen-studio/shopee-product-reviews-scraper"
        },
        "documentationSha256": {
          "const": "798f1078e4b52991129ec29d34346cf3980495061fc14f0026c3fe4c0578d1c6"
        },
        "documentationRetrievedAt": {
          "const": "2026-10-08"
        },
        "keyId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        }
      }
    }
  },
  "description": "Opt-in metadata-sanitized exact Shopee capture; exact request remains2.0.0. Retained comments remain verbatim and may contain personal data. No erased raw bytes are replayed."
}
