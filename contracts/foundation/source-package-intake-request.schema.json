{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdn.local/contracts/foundation/source-package-intake-request.schema.json",
  "title": "SourcePackageIntakeRequest",
  "type": "object", "additionalProperties": false,
  "required": ["contractVersion", "packageKey", "version", "sourceAcquiredAt", "sourceLabel", "files"],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "packageKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*:[A-Za-z0-9][A-Za-z0-9._-]*$", "maxLength": 160 },
    "version": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "sourceAcquiredAt": { "type": ["string", "null"], "format": "date-time" },
    "sourceLabel": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" },
    "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" } }
  },
  "$defs": {
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "byteSize", "mediaType", "evidenceFamily", "representationRole", "independence", "providerProvenance", "provenanceBasis"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)[^\\u0000]+$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "byteSize": { "type": "integer", "minimum": 0, "maximum": 1073741824 },
        "mediaType": { "type": "string", "minLength": 1, "maxLength": 127, "pattern": "^[^\\s/]+/[^\\s/]+$" },
        "evidenceFamily": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "representationRole": { "enum": ["primary", "alternate", "structured", "derived"] },
        "independence": { "enum": ["independent", "non_independent"] },
        "providerProvenance": { "enum": ["verified", "provider_reported", "operator_supplied_unverified", "synthetic"] },
        "provenanceBasis": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "\\S" },
        "period": { "$ref": "#/$defs/period" }
      }
    },
    "period": {
      "type": "object", "additionalProperties": false, "required": ["start", "end"],
      "properties": { "start": { "type": "string", "format": "date-time" }, "end": { "type": "string", "format": "date-time" } }
    }
  }
}
