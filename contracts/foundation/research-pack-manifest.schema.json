{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdn.local/contracts/foundation/research-pack-manifest.schema.json",
  "title": "ResearchPackManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "packKey", "version", "purpose", "finalizedAt", "documents"],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "packKey": { "type": "string", "minLength": 3, "maxLength": 160 },
    "version": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 500 },
    "finalizedAt": { "type": "string", "format": "date-time" },
    "supersedesPackId": { "type": "string", "format": "uuid" },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["documentId", "documentType", "title", "sourceLocator", "languageTag", "rightsStatus", "rightsBasis", "evidence", "source", "ingestion", "rawArtifact"],
        "properties": {
          "documentId": { "type": "string", "format": "uuid" },
          "documentType": { "enum": ["news_article", "report", "web_page", "transcript", "other"] },
          "title": { "type": "string", "minLength": 1 },
          "sourceLocator": { "type": "string", "minLength": 1 },
          "languageTag": { "type": "string", "minLength": 1 },
          "publishedAt": { "type": "string", "format": "date-time" },
          "rightsStatus": { "enum": ["unknown", "permitted", "restricted"] },
          "rightsBasis": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["evidenceId", "grade", "basis"],
            "properties": {
              "evidenceId": { "type": "string", "format": "uuid" },
              "grade": { "enum": ["synthetic", "unverified", "provider_reported", "corroborated", "verified"] },
              "basis": { "type": "string", "minLength": 1 }
            }
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sourceId"],
            "properties": { "sourceId": { "type": "string", "minLength": 1 } }
          },
          "ingestion": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ingestionId", "acquiredAt"],
            "properties": {
              "ingestionId": { "type": "string", "format": "uuid" },
              "acquiredAt": { "type": "string", "format": "date-time" }
            }
          },
          "rawArtifact": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sha256", "byteSize", "mediaType"],
            "properties": {
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "byteSize": { "type": "integer", "minimum": 1, "maximum": 1048576 },
              "mediaType": { "const": "text/plain" }
            }
          }
        }
      }
    }
  }
}
