{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdn.local/contracts/foundation/json-export.schema.json",
  "title": "JsonExportInput",
  "description": "Canonical trust-boundary contract for one synthetic provider-shaped multi-row JSON export.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "source", "ingestion", "period", "rows"],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "sourceType", "displayName"],
      "properties": {
        "sourceId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*:[A-Za-z0-9][A-Za-z0-9._-]*$",
          "maxLength": 160
        },
        "sourceType": { "const": "provider_export" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "ingestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["idempotencyKey", "acquiredAt", "mediaType", "evidenceGrade"],
      "properties": {
        "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 200 },
        "acquiredAt": { "type": "string", "format": "date-time" },
        "mediaType": { "const": "application/json" },
        "evidenceGrade": {
          "type": "object",
          "additionalProperties": false,
          "required": ["grade", "basis"],
          "properties": {
            "grade": { "enum": ["synthetic", "unverified", "provider_reported", "corroborated", "verified"] },
            "basis": { "type": "string", "minLength": 1, "maxLength": 1000 }
          }
        }
      }
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "grain", "scope"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" },
        "grain": { "type": "string", "minLength": 1, "maxLength": 80 },
        "scope": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "platformProductId", "productName"],
        "minProperties": 4,
        "properties": {
          "platform": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "maxLength": 80 },
          "platformProductId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "productName": { "type": "string", "minLength": 1, "maxLength": 500 },
          "periodRevenueVnd": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "periodUnitsSold": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "lifetimeRevenueVnd": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "revenueGrowth": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "unit", "scale"],
            "properties": {
              "value": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
              "unit": { "const": "percent" },
              "scale": { "type": "integer", "minimum": 1, "maximum": 1000000 }
            }
          }
        }
      }
    }
  }
}
