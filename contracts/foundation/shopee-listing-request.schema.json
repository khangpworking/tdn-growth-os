{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShopeeListingRequest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contractVersion": {
      "const": "1.0.0"
    },
    "runKey": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"
    },
    "topic": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "start",
        "end"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "acquiredAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "label",
        "acquiredAt"
      ]
    },
    "listings": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "platform": {
            "enum": [
              "shopee",
              "tiktokshop"
            ]
          },
          "shopId": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,19}$"
          },
          "itemId": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,19}$"
          },
          "productKey": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$"
              },
              {
                "type": "null"
              }
            ]
          },
          "groupingBasis": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ]
          },
          "productName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "productUrl": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ]
          },
          "periodRevenueVnd": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,29})$"
              },
              {
                "type": "null"
              }
            ]
          },
          "revenuePrecision": {
            "enum": [
              "exact",
              "rounded",
              "unknown"
            ]
          }
        },
        "required": [
          "platform",
          "shopId",
          "itemId",
          "productKey",
          "groupingBasis",
          "productName",
          "productUrl",
          "periodRevenueVnd",
          "revenuePrecision"
        ]
      }
    }
  },
  "required": [
    "contractVersion",
    "runKey",
    "topic",
    "period",
    "source",
    "listings"
  ]
}
